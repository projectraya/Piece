@page "/Account/Manage/PaymentHistory"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums

<PageTitle>Payment History</PageTitle>

<div class="payment-history-page">
    <h1 class="page-title">Subscription & Payments</h1>

    @if (isLoading)
    {
        <div class="loading">Loading...</div>
    }
    else if (string.IsNullOrEmpty(currentUserId))
    {
        <div class="not-logged-in">
            <p>Please log in to view your subscription and payment history.</p>
            <button class="login-btn" @onclick='() => Navigation.NavigateTo("/Account/Login")'>Log In</button>
        </div>
    }
    else
    {
        <!-- Current Subscription Card -->
        <div class="current-subscription-card">
            <h2>Current Subscription</h2>

            @if (currentSubscription != null)
            {
                <div class="subscription-details">
                    <div class="plan-badge @(currentSubscription.SubscriptionPlan.Name.ToLower())">
                        @currentSubscription.SubscriptionPlan.Name
                    </div>

                    <div class="detail-row">
                        <span class="label">Status:</span>
                        <span class="value status-@currentSubscription.Status.ToString().ToLower()">
                            @currentSubscription.Status
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(currentSubscription.PaymentMethod))
                    {
                        <div class="detail-row">
                            <span class="label">Payment Method:</span>
                            <span class="value">@currentSubscription.PaymentMethod</span>
                        </div>
                    }

                    <div class="detail-row">
                        <span class="label">Started:</span>
                        <span class="value">@currentSubscription.StartDate.ToString("MMM dd, yyyy")</span>
                    </div>

                    @if (currentSubscription.SubscriptionPlan.Price > 0)
                    {
                        <div class="detail-row">
                            <span class="label">Valid Until:</span>
                            <span class="value expires">@currentSubscription.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>

                        @if (currentSubscription.Status == SubscriptionStatus.Active)
                        {
                            var daysLeft = (currentSubscription.EndDate - DateTime.UtcNow).Days;
                            <div class="days-remaining">
                                <span class="days-number">@daysLeft</span>
                                <span class="days-label">days remaining</span>
                            </div>
                        }
                    }

                    <div class="subscription-actions">
                        @if (currentSubscription.SubscriptionPlan.Price > 0)
                        {
                            <button class="downgrade-btn" @onclick="OpenDowngradeModal">
                                Downgrade to Free
                            </button>
                        }
                        else
                        {
                            <button class="upgrade-btn" @onclick='() => Navigation.NavigateTo("/subscriptions")'>
                                Upgrade to Premium
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="no-subscription">
                    <p>You don't have an active subscription.</p>
                    <button class="get-started-btn" @onclick='() => Navigation.NavigateTo("/subscriptions")'>
                        Get Started
                    </button>
                </div>
            }
        </div>

        <!-- Payment History -->
        <div class="payment-history-section">
            <h2>Payment History</h2>

            @if (payments.Any())
            {
                <div class="payments-list">
                    @foreach (var payment in payments)
                    {
                        <div class="payment-item">
                            <div class="payment-icon">
                                @if (payment.Status == PaymentStatus.Completed)
                                {
                                    <span class="icon success">✓</span>
                                }
                                else if (payment.Status == PaymentStatus.Failed)
                                {
                                    <span class="icon failed">✕</span>
                                }
                                else if (payment.Status == PaymentStatus.Refunded)
                                {
                                    <span class="icon refunded">↺</span>
                                }
                                else
                                {
                                    <span class="icon pending">⋯</span>
                                }
                            </div>

                            <div class="payment-details">
                                <div class="payment-title">
                                    @if (payment.UserSubscription != null)
                                    {
                                        <span>@payment.UserSubscription.SubscriptionPlan.Name Subscription</span>
                                    }
                                    else
                                    {
                                        <span>Payment</span>
                                    }
                                </div>
                                <div class="payment-meta">
                                    <span>@payment.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    <span class="separator">•</span>
                                    <span>@payment.PaymentMethod</span>
                                    @if (!string.IsNullOrEmpty(payment.TransactionId))
                                    {
                                        <span class="separator">•</span>
                                        <span class="transaction-id">ID: @payment.TransactionId.Substring(0, 8)...</span>
                                    }
                                </div>
                            </div>

                            <div class="payment-amount">
                                <span class="amount">$@payment.Amount.ToString("0.00")</span>
                                <span class="status status-@payment.Status.ToString().ToLower()">
                                    @payment.Status
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-payments">
                    <p>No payment history yet.</p>
                </div>
            }
        </div>

        <!-- Subscription History -->
        <div class="subscription-history-section">
            <h2>Subscription History</h2>

            @if (subscriptionHistory.Any())
            {
                <div class="subscription-timeline">
                    @foreach (var sub in subscriptionHistory)
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <div class="timeline-header">
                                    <span class="plan-name">@sub.SubscriptionPlan.Name</span>
                                    <span class="timeline-date">@sub.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="timeline-details">
                                    <span class="status-badge status-@sub.Status.ToString().ToLower()">
                                        @sub.Status
                                    </span>
                                    @if (sub.Status == SubscriptionStatus.Cancelled && sub != currentSubscription)
                                    {
                                        <span class="action-text">Downgraded</span>
                                    }
                                    else if (sub == currentSubscription)
                                    {
                                        <span class="action-text">Current</span>
                                    }
                                    else if (sub.Status == SubscriptionStatus.Active)
                                    {
                                        <span class="action-text">Upgraded</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-history">
                    <p>No subscription history.</p>
                </div>
            }
        </div>
    }

    <!-- Downgrade Confirmation Modal -->
    @if (showDowngradeModal)
    {
        <div class="modal-overlay" @onclick="CloseDowngradeModal">
            <div class="confirm-modal" @onclick:stopPropagation="true">
                <div class="modal-icon warning">⚠️</div>
                <h2>Downgrade to Free?</h2>
                <p>
                    You'll still have access to Premium features until
                    <strong>@currentSubscription?.EndDate.ToString("MMMM dd, yyyy")</strong>.
                </p>
                <p>After that date, you'll lose access to:</p>
                <ul class="features-lost">
                    <li>🗺️ Interactive World Map</li>
                    <li>🎵 High Quality Audio</li>
                    <li>📥 Music Downloads</li>
                    <li>🚫 Ad-Free Experience</li>
                </ul>

                <div class="modal-actions">
                    <button class="cancel-modal-btn" @onclick="CloseDowngradeModal">
                        Keep Premium
                    </button>
                    <button class="confirm-downgrade-btn" @onclick="ConfirmDowngrade">
                        Confirm Downgrade
                    </button>
                </div>
            </div>
        </div>
    }
</div>

