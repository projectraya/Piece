@code {
    private string? currentUserId;
    private bool isLoading = true;
    private UserSubscription? currentSubscription;
    private List<Payment> payments = new();
    private List<UserSubscription> subscriptionHistory = new();
    private bool showDowngradeModal = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            await LoadData();
        }

        isLoading = false;
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;
        using var context = await DbFactory.CreateDbContextAsync();
        currentSubscription = await context.UserSubscriptions
            .Where(s => s.UserId == currentUserId && s.Status == SubscriptionStatus.Active && s.EndDate > DateTime.UtcNow)
            .Include(s => s.SubscriptionPlan)
            .OrderByDescending(s => s.StartDate)
            .FirstOrDefaultAsync();

        payments = await context.Payments
            .Where(p => p.UserId == currentUserId)
            .Include(p => p.UserSubscription)
                .ThenInclude(s => s!.SubscriptionPlan)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();

        subscriptionHistory = await context.UserSubscriptions
            .Where(s => s.UserId == currentUserId)
            .Include(s => s.SubscriptionPlan)
            .OrderByDescending(s => s.StartDate)
            .ToListAsync();
    }

    private void OpenDowngradeModal()
    {
        showDowngradeModal = true;
    }

    private void CloseDowngradeModal()
    {
        showDowngradeModal = false;
    }

    private async Task ConfirmDowngrade()
    {
        if (currentSubscription == null || string.IsNullOrEmpty(currentUserId)) return;
        using var context = await DbFactory.CreateDbContextAsync();
        try
        {
            // Don't cancel immediately - let them use premium until end date
            currentSubscription.AutoRenew = false;
            currentSubscription.Status = SubscriptionStatus.Cancelled;

            await context.SaveChangesAsync();

            // Close modal and reload
            showDowngradeModal = false;
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downgrading: {ex.Message}");
        }
    }
}