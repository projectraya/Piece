@page "/Account/Manage/EditProfile"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Piece.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Piece.Services

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IProfileService ProfileService
@inject NavigationManager Navigation
@inject IInputSanitizer InputSanitizer

<PageTitle>Edit Profile - Piece</PageTitle>

<style>
    .edit-profile-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px 20px;
        color: #fff;
    }

    .edit-header {
        margin-bottom: 30px;
    }

    .edit-title {
        font-size: 32px;
        font-weight: 700;
        color: #FFD335;
        margin-bottom: 10px;
    }

    .edit-subtitle {
        font-size: 16px;
        color: #888;
    }

    .edit-form {
        background: #2a2a2a;
        border-radius: 12px;
        padding: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
        font-size: 14px;
        font-weight: 600;
    }

    .form-input {
        width: 100%;
        padding: 12px;
        background: #1a1a1a;
        border: 2px solid #3a3a3a;
        border-radius: 8px;
        color: #fff;
        font-size: 16px;
        transition: border-color 0.3s;
    }

    .form-input:focus {
        outline: none;
        border-color: #FFD335;
    }

    .form-textarea {
        min-height: 120px;
        resize: vertical;
        font-family: inherit;
    }

    .form-checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #1a1a1a;
        border-radius: 8px;
    }

    .checkbox-item input[type="checkbox"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .checkbox-label {
        color: #ccc;
        cursor: pointer;
        user-select: none;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn {
        flex: 1;
        padding: 15px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #FFD335;
        color: #1a1a1a;
    }

    .btn-primary:hover {
        background: #ffd000;
        transform: translateY(-2px);
    }

    .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    .btn-secondary {
        background: #3a3a3a;
        color: #fff;
    }

    .btn-secondary:hover {
        background: #4a4a4a;
    }

    .alert {
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #1a4d2e;
        color: #4ade80;
        border: 1px solid #4ade80;
    }

    .alert-error {
        background: #4d1a1a;
        color: #ff6b6b;
        border: 1px solid #ff6b6b;
    }

    .char-counter {
        font-size: 12px;
        color: #888;
        text-align: right;
        margin-top: 5px;
    }
</style>

<div class="edit-profile-container">
    <div class="edit-header">
        <h1 class="edit-title">✏️ Edit Profile</h1>
        <p class="edit-subtitle">Customize how others see you on Piece</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-error")">
            @message
        </div>
    }

    <div class="edit-form">
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <!-- Display Name -->
            <div class="form-group">
                <label class="form-label">Display Name</label>
                <InputText @bind-Value="Input.DisplayName" class="form-input" placeholder="How you want to be called" />
                <ValidationMessage For="() => Input.DisplayName" class="text-danger" />
            </div>

            <!-- Bio -->
            <div class="form-group">
                <label class="form-label">Bio</label>
                <InputTextArea @bind-Value="Input.Bio" class="form-input form-textarea" 
                              placeholder="Tell us about your music taste..." 
                              @oninput="UpdateBioCharCount" />
                <div class="char-counter">@bioCharCount / 500 characters</div>
                <ValidationMessage For="() => Input.Bio" class="text-danger" />
            </div>

            <!-- Privacy Settings -->
            <div class="form-group">
                <label class="form-label">Privacy Settings</label>
                <div class="form-checkbox-group">
                    <div class="checkbox-item">
                        <InputCheckbox @bind-Value="Input.IsProfilePublic" id="public-profile" />
                        <label for="public-profile" class="checkbox-label">
                            🌐 Public Profile - Anyone can view your profile
                        </label>
                    </div>
                    <div class="checkbox-item">
                        <InputCheckbox @bind-Value="Input.ShowPlaylists" id="show-playlists" />
                        <label for="show-playlists" class="checkbox-label">
                            🎵 Show Public Playlists - Display your playlists on your profile
                        </label>
                    </div>
                    <div class="checkbox-item">
                        <InputCheckbox @bind-Value="Input.ShowListeningHistory" id="show-history" />
                        <label for="show-history" class="checkbox-label">
                            🎨 Show Listening Colors - Display your top genres and listening stats
                        </label>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>💾 Save Changes</span>
                    }
                </button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private bool isSuccess;
    private bool isLoading;
    private ApplicationUser user = default!;
    private int bioCharCount = 0;

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var authUser = authState.User;

            if (authUser.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            var userId = authUser.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            user = await UserManager.FindByIdAsync(userId);
            if (user == null)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            // Populate form with current values
            Input.DisplayName = user.DisplayName ?? "";
            Input.Bio = user.Bio ?? "";
            Input.IsProfilePublic = user.IsProfilePublic;
            Input.ShowPlaylists = user.ShowPlaylists;
            Input.ShowListeningHistory = user.ShowListeningHistory;

            bioCharCount = Input.Bio?.Length ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
            message = "Error loading profile information.";
            isSuccess = false;
        }
    }

    private void UpdateBioCharCount(ChangeEventArgs e)
    {
        bioCharCount = e.Value?.ToString()?.Length ?? 0;
    }

    private async Task OnValidSubmitAsync()
    {
        if (user == null)
        {
            message = "Error: User not found.";
            isSuccess = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // Sanitize inputs before saving
            var sanitizedDisplayName = InputSanitizer.SanitizeString(Input.DisplayName ?? "", 100);
            var sanitizedBio = InputSanitizer.SanitizeString(Input.Bio ?? "", 500);

            var success = await ProfileService.UpdateProfileAsync(
                user.Id,
                sanitizedDisplayName,
                sanitizedBio,
                Input.IsProfilePublic,
                Input.ShowListeningHistory,
                Input.ShowPlaylists
            );

            if (success)
            {
                message = "✓ Profile updated successfully!";
                isSuccess = true;

                // Update local user object with sanitized values
                user.DisplayName = sanitizedDisplayName;
                user.Bio = sanitizedBio;
                user.IsProfilePublic = Input.IsProfilePublic;
                user.ShowPlaylists = Input.ShowPlaylists;
                user.ShowListeningHistory = Input.ShowListeningHistory;
            }
            else
            {
                message = "Error: Could not update profile.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/profile/{user.UserName}");
    }

    private sealed class InputModel
    {
        [StringLength(100, ErrorMessage = "Display name must be less than 100 characters.")]
        public string? DisplayName { get; set; }

        [StringLength(500, ErrorMessage = "Bio must be less than 500 characters.")]
        public string? Bio { get; set; }

        public bool IsProfilePublic { get; set; } = true;
        public bool ShowPlaylists { get; set; } = true;
        public bool ShowListeningHistory { get; set; } = true;
    }
}