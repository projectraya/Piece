@using Microsoft.AspNetCore.Identity
@using Piece.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject Services.LanguageService Lang

<style>
    .manage-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .manage-nav-list .nav-link {
            display: block;
            padding: 10px 16px;
            border-radius: 8px;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }

            .manage-nav-list .nav-link:hover {
                background: rgba(255,255,255,0.05);
                color: #ffffff;
                border-left-color: #10B981;
            }

            .manage-nav-list .nav-link.active {
                background: rgba(139,92,246,0.15);
                color: #8B5CF6;
                border-left-color: #8B5CF6;
                font-weight: 600;
            }
</style>

<ul class="manage-nav-list">
    <li>
        <NavLink class="nav-link" href="Account/Manage/PaymentHistory">
            @Lang.T("Payment History")
        </NavLink>
    </li>
    <li>
        <NavLink class="nav-link" href="Account/Manage/Email">
            @Lang.T("Email")
        </NavLink>
    </li>
    <li>
        <NavLink class="nav-link" href="Account/Manage/ChangePassword">
            @Lang.T("Password")
        </NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li>
            <NavLink class="nav-link" href="Account/Manage/ExternalLogins">
                @Lang.T("External Logins")
            </NavLink>
        </li>
    }
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}