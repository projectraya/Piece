@inherits LayoutComponentBase

<div class="page" id="app-container">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>
    <main>
        <UnbanNotification />
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<GlobalPlayer @rendermode="InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>