    window.playAudioPreview = function (url) {
    if (window.currentAudio) {
    window.currentAudio.pause();
    window.currentAudio = null;
    }

    window.currentAudio = new Audio(url);
    window.currentAudio.play();

    window.currentAudio.addEventListener('timeupdate', () => {
    if (window.pieceMapComponentRef && window.currentAudio) {
    const progress = (window.currentAudio.currentTime / window.currentAudio.duration) * 100;
    window.pieceMapComponentRef.invokeMethodAsync('UpdateProgress', progress);
