            <button @onclick='() => Navigation.NavigateTo("/")'
                    style="background: none; border: none; color: rgba(255,255,255,0.3); font-size: 14px; cursor: pointer; transition: color 0.2s;"
                    onmouseover="this.style.color='rgba(255,255,255,0.6)'"
                    onmouseout="this.style.color='rgba(255,255,255,0.3)'">
                Maybe later
