        </div>
    </div>
}

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    window.pieceMapInstance = null;
    window.pieceMapComponentRef = null;
    window.currentAudio = null;

    window.waitForLeaflet = function() {
        return new Promise((resolve) => {
            if (typeof L !== 'undefined') {
                resolve();
            } else {
                const checkInterval = setInterval(() => {
                    if (typeof L !== 'undefined') {
                        clearInterval(checkInterval);
                        resolve();
                    }
                }, 100);
            }
        });
    };

    window.initializeWorldMap = async function (dotNetRef) {
        console.log('Initializing world map...');
        await window.waitForLeaflet();
        window.pieceMapComponentRef = dotNetRef;

        if (window.pieceMapInstance) {
            window.pieceMapInstance.remove();
        }

        const map = L.map('map', {
            minZoom: 2,
            maxZoom: 6,
            maxBounds: [[-90, -180], [90, 180]],
            maxBoundsViscosity: 1.0
        }).setView([20, 0], 2);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap contributors © CARTO',
            subdomains: 'abcd',
            maxZoom: 6
        }).addTo(map);

        window.pieceMapInstance = map;
        console.log('Map initialized');
    };

    window.addCountryMarkers = async function (countries) {
        await window.waitForLeaflet();

        if (!window.pieceMapInstance) {
            console.error('Map not initialized');
            return;
        }

        console.log(`Adding ${countries.length} country markers...`);

        countries.forEach(country => {
            const marker = L.circleMarker([country.latitude, country.longitude], {
                radius: 8,
                fillColor: '#8B5CF6',
                color: '#10B981',
                weight: 2,
                opacity: 0.8,
                fillOpacity: 0.6
            });

            marker.on('mouseover', function () {
                this.setStyle({
                    fillColor: '#10B981',
                    radius: 12,
                    fillOpacity: 0.9
                });
            });

            marker.on('mouseout', function () {
                this.setStyle({
                    fillColor: '#8B5CF6',
                    radius: 8,
                    fillOpacity: 0.6
                });
            });

            marker.on('click', function () {
                console.log(`Clicked: ${country.name}`);
                if (window.pieceMapComponentRef) {
                    window.pieceMapComponentRef.invokeMethodAsync('SelectCountryFromJS', country.name, country.countryCode)
                        .then(() => console.log('Country selected'))
                        .catch(err => console.error('Error selecting country:', err));
                }
            });

            marker.bindTooltip(country.name, {
                permanent: false,
                direction: 'top',
                className: 'country-tooltip'
            });

            marker.addTo(window.pieceMapInstance);
        });

        console.log('Markers added');
    };

    window.playAudioPreview = function (url) {
        if (window.currentAudio) {
            window.currentAudio.pause();
            window.currentAudio = null;
        }

        window.currentAudio = new Audio(url);
        window.currentAudio.play();

        window.currentAudio.addEventListener('timeupdate', () => {
            if (window.pieceMapComponentRef && window.currentAudio) {
                const progress = (window.currentAudio.currentTime / window.currentAudio.duration) * 100;
                window.pieceMapComponentRef.invokeMethodAsync('UpdateProgress', progress);
            }
        });

        window.currentAudio.addEventListener('ended', () => {
            window.pieceMapComponentRef.invokeMethodAsync('OnPlaybackEnded');
        });
    };

    window.pauseAudio = function () {
        if (window.currentAudio) {
            window.currentAudio.pause();
        }
    };

    window.resumeAudio = function () {
        if (window.currentAudio) {
            window.currentAudio.play();
        }
    };

    window.stopAudio = function () {
        if (window.currentAudio) {
            window.currentAudio.pause();
            window.currentAudio.currentTime = 0;
            window.currentAudio = null;
        }
    };
</script>

@code {
    private bool isLoading = true;
    private CountryMusicData? countryData = null;
    private bool isLoadingCountryData = false;
    private List<Country> countries = new();
    private DotNetObjectReference<Map>? objRef;

    private CountryTrackInfo? currentTrack = null;
    private bool isPlaying = false;
    private double progressPercent = 0;
    private double currentPosition = 0;
    private double trackDuration = 30;

    private bool userHasPremium = false;
    private int? currentPlanId = null;
    private string? currentUserId;

    // Pagination
    private List<CountryArtistInfo> loadedArtists = new();
    private int currentOffset = 0;
    private bool isLoadingMore = false;

    // Discography
    private CountryArtistInfo? selectedArtistForDiscography = null;
    private List<CountryTrackInfo> discographyTracks = new();
    private bool isLoadingDiscography = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadCurrentSubscription();
    }

    private async Task LoadCurrentSubscription()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;
        using var context = await DbFactory.CreateDbContextAsync();
        var currentSub = await context.UserSubscriptions
            .Where(s => s.UserId == currentUserId && s.Status == SubscriptionStatus.Active && s.EndDate > DateTime.UtcNow)
            .Include(s => s.SubscriptionPlan)
            .FirstOrDefaultAsync();

        if (currentSub != null)
        {
            currentPlanId = currentSub.SubscriptionPlanId;
            userHasPremium = true;
        }
    }

    private string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || double.IsInfinity(seconds))
            return "0:00";

        var time = TimeSpan.FromSeconds(seconds);
        return $"{time.Minutes}:{time.Seconds:D2}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                objRef = DotNetObjectReference.Create(this);
                await LoadCountries();
                await Task.Delay(500);
                await JS.InvokeVoidAsync("initializeWorldMap", objRef);

                var countryData = countries.Select(c => new
                {
                    name = c.Name,
                    latitude = c.Latitude,
                    longitude = c.Longitude,
                    countryCode = c.CountryCode
                }).ToList();

                await JS.InvokeVoidAsync("addCountryMarkers", countryData);
                isLoading = false;
                StateHasChanged();

                Console.WriteLine("Map initialization complete");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing map: {ex.Message}");
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadCountries()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            countries = await context.Countries
                .Where(c => c.Latitude != 0 && c.Longitude != 0)
                .ToListAsync();
            Console.WriteLine($"Loaded {countries.Count} countries");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading countries: {ex.Message}");
        }
    }

    [JSInvokable("SelectCountryFromJS")]
    public async Task SelectCountryFromJS(string countryName, string countryCode)
    {
        Console.WriteLine($"[Map] Loading data for: {countryName}");

        isLoadingCountryData = true;
        countryData = null;
        loadedArtists.Clear();
        currentOffset = 0;
        await InvokeAsync(StateHasChanged);

        var country = countries.FirstOrDefault(c => c.Name == countryName);
        if (country != null)
        {
            countryData = await CountryMusicService.GetCountryMusicData(country.CountryCode, 0, 20);

            if (countryData.HasData)
            {
                loadedArtists.AddRange(countryData.Artists);
            }
        }

        isLoadingCountryData = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMoreArtists()
    {
        if (countryData == null || isLoadingMore) return;

        isLoadingMore = true;
        StateHasChanged();

        var country = countries.FirstOrDefault(c => c.Name == countryData.CountryName);
        if (country != null)
        {
            currentOffset += 20;
            var moreData = await CountryMusicService.GetCountryMusicData(country.CountryCode, currentOffset, 20);

            if (moreData.HasData && moreData.Artists.Any())
            {
                loadedArtists.AddRange(moreData.Artists);
                countryData.HasMore = moreData.HasMore;
            }
            else
            {
                countryData.HasMore = false;
            }
        }

        isLoadingMore = false;
        StateHasChanged();
    }

    private async Task ShowDiscography(CountryArtistInfo artist)
    {
        selectedArtistForDiscography = artist;
        isLoadingDiscography = true;
        discographyTracks.Clear();
        StateHasChanged();

        discographyTracks = await CountryMusicService.GetArtistDiscography(artist.Name, 50);
        isLoadingDiscography = false;
        StateHasChanged();
    }

    private void CloseDiscography()
    {
        selectedArtistForDiscography = null;
        discographyTracks.Clear();
        StateHasChanged();
    }

    private void ClosePanel()
    {
        countryData = null;
        loadedArtists.Clear();
        currentOffset = 0;
        StopPlayback();
        StateHasChanged();
    }

    private async Task SelectTrack(CountryTrackInfo track)
    {
        if (string.IsNullOrEmpty(track.PreviewUrl))
        {
            Console.WriteLine("[Map] No preview URL available for this track");
            return;
        }

        if (currentTrack?.PreviewUrl == track.PreviewUrl)
        {
            await TogglePlayPause();
        }
        else
        {
            if (currentTrack != null)
            {
                await JS.InvokeVoidAsync("stopAudio");
            }

            currentTrack = track;
            isPlaying = true;
            progressPercent = 0;
            currentPosition = 0;

            try
            {
                await JS.InvokeVoidAsync("playAudioPreview", track.PreviewUrl);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Map] Error playing audio: {ex.Message}");
                isPlaying = false;
            }

            StateHasChanged();
        }
    }

    private async Task TogglePlayPause()
    {
        if (isPlaying)
        {
            await JS.InvokeVoidAsync("pauseAudio");
            isPlaying = false;
        }
        else
        {
            await JS.InvokeVoidAsync("resumeAudio");
            isPlaying = true;
        }
        StateHasChanged();
    }

    private async Task StopPlayback()
    {
        await JS.InvokeVoidAsync("stopAudio");
        currentTrack = null;
        isPlaying = false;
        progressPercent = 0;
        StateHasChanged();
    }

    [JSInvokable("UpdateProgress")]
    public async Task UpdateProgress(double progress)
    {
        progressPercent = progress;
        currentPosition = (progress / 100.0) * 30;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable("OnPlaybackEnded")]
    public async Task OnPlaybackEnded()
    {
        isPlaying = false;
        progressPercent = 0;
        await InvokeAsync(StateHasChanged);
    }

    private void GoBack()
    {
        StopPlayback();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}