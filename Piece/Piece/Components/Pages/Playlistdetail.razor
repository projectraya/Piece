@page "/playlist/{id:int}"
@rendermode InteractiveServer
@inherits Piece.Components.Pages.PlaylistDetail
@using Piece.Services
@inject PlayerService PlayerService

<PageTitle>@(playlist?.Name ?? "Playlist") - Piece</PageTitle>

<style>
    body {
        background-color: #1a1a1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .playlist-detail-container {
        padding: 40px;
        max-width: 1400px;
        margin: 0 auto;
        padding-bottom: 120px;
    }

    .playlist-header {
        display: flex;
        gap: 32px;
        margin-bottom: 40px;
        align-items: flex-start;
    }

    .playlist-cover-large {
        width: 240px;
        height: 240px;
        background: #8B5CF6;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 96px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

        .playlist-cover-large:hover {
            transform: scale(1.02);
        }

        .playlist-cover-large img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .playlist-cover-large .cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            gap: 8px;
        }

        .playlist-cover-large:hover .cover-overlay {
            opacity: 1;
        }

        .playlist-cover-large .cover-overlay-icon {
            font-size: 48px;
        }

        .playlist-cover-large .cover-overlay-text {
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }

    .playlist-info-header {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .playlist-type {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        color: #888;
        margin-bottom: 8px;
    }

    .playlist-title {
        font-size: 48px;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 16px 0;
    }

    .playlist-description-text {
        font-size: 14px;
        color: #aaa;
        margin-bottom: 16px;
    }

    .playlist-stats {
        display: flex;
        gap: 16px;
        font-size: 14px;
        color: #888;
        margin-bottom: 24px;
    }

    .playlist-actions-header {
        display: flex;
        gap: 12px;
    }

    .btn-play {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 24px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-play:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
        }

    .btn-shuffle {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 24px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-shuffle:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
        }

        .btn-shuffle.active {
            background: #8B5CF6;
            color: #ffffff;
            border-color: transparent;
        }

            .btn-shuffle.active:hover {
                transform: scale(1.05);
                box-shadow: 0 8px 16px rgba(16, 185, 129, 0.3);
            }

    .tracks-section {
        margin-top: 40px;
    }

    .tracks-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .tracks-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .btn-add-tracks {
        background-color: #2a2a2a;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-add-tracks:hover {
            background-color: #3a3a3a;
        }

    .tracks-table {
        width: 100%;
    }

    .track-row {
        display: grid;
        grid-template-columns: 50px 1fr 200px 100px 80px;
        gap: 16px;
        padding: 12px 16px;
        border-radius: 8px;
        align-items: center;
        transition: background-color 0.2s ease;
        cursor: pointer;
    }

        .track-row:hover {
            background-color: #2a2a2a;
        }

        .track-row.playing {
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
            border-left: 3px solid #10B981;
        }

    .track-number {
        color: #888;
        text-align: center;
        font-size: 14px;
    }

    .track-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .track-art-small {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #10B981 0%, #764ba2 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .track-art-small img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .track-text {
        overflow: hidden;
    }

    .track-name {
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-artist-small {
        font-size: 13px;
        color: #888;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-album {
        font-size: 14px;
        color: #888;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-duration {
        font-size: 14px;
        color: #888;
        text-align: right;
    }

    .track-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .btn-track-action {
        background: none;
        border: none;
        color: #888;
        font-size: 18px;
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        transition: all 0.3s ease;
        opacity: 0;
    }

    .track-row:hover .btn-track-action {
        opacity: 1;
    }

    .btn-track-action:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.1);
    }

    .btn-track-action.remove:hover {
        color: #ff4444;
    }

    /* Add Tracks Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

    .modal-large {
        background-color: #2a2a2a;
        border-radius: 16px;
        padding: 32px;
        max-width: 800px;
        width: 90%;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .modal-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .btn-close {
        background: none;
        border: none;
        color: #888;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.3s;
    }

        .btn-close:hover {
            color: #ffffff;
        }

    .search-box-modal {
        background-color: #1a1a1a;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-input-modal {
        flex: 1;
        background: none;
        border: none;
        color: #ffffff;
        font-size: 14px;
        outline: none;
    }

        .search-input-modal::placeholder {
            color: #666;
        }

    .available-tracks {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .available-track-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background-color: #1a1a1a;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .available-track-row:hover {
            background-color: #3a3a3a;
        }

        .available-track-row.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

            .available-track-row.disabled:hover {
                background-color: #1a1a1a;
            }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }

    .empty-state-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    /* Loading State */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: #888;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #3a3a3a;
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #888;
        text-decoration: none;
        font-size: 14px;
        margin-bottom: 24px;
        transition: color 0.3s;
    }

        .back-button:hover {
            color: #ffffff;
        }

    /* Hidden file input */
    .hidden-file-input {
        display: none;
    }
</style>

<div class="playlist-detail-container">
    <a href="/playlists" class="back-button">
        <span>←</span>
        <span>Back to Playlists</span>
    </a>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p style="margin-top: 20px;">Loading playlist...</p>
        </div>
    }
    else if (playlist == null)
    {
        <div class="empty-state">
            <h3>Playlist not found</h3>
            <p>This playlist may have been deleted</p>
        </div>
    }
    else
    {
        <div class="playlist-header">
            <div class="playlist-cover-large" @onclick="OpenCoverUpload">
                @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                {
                    <img src="@playlist.CoverImageUrl" alt="@playlist.Name" />
                }
                else
                {
                    <span>꩜</span>
                }
                @if (!isViewingOtherUsersPlaylist)
                {
                    <div class="cover-overlay">
                        <div class="cover-overlay-icon">📷</div>
                        <div class="cover-overlay-text">Change Cover</div>
                    </div>
                }
            </div>
            <div class="playlist-info-header">
                <div class="playlist-type">Playlist</div>
                <h1 class="playlist-title">@playlist.Name</h1>
                @if (playlist != null && playlist.UserId != currentUserId)
                {
                    <div style="background: none; border: none;
                border-radius: 8px; padding: 0px; margin-bottom: 10px;">
                        <div style="color: #8B5CF6; font-size: 13px; font-weight: 600;">
                            Admin View - This playlist belongs to another user
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(playlist.Description))
                {
                    <p class="playlist-description-text">@playlist.Description</p>
                }
                <div class="playlist-stats">
                    <span>@playlistTracks.Count @(playlistTracks.Count == 1 ? "track" : "tracks")</span>
                </div>
                <div class="playlist-actions-header">
                    <button class="btn-play" @onclick="PlayPlaylist">
                        <span>Play</span>
                    </button>
                    <button class="btn-shuffle @(PlayerService.IsShuffleOn ? "active" : "")"
                            title="@(PlayerService.IsShuffleOn ? "Shuffle On" : "Shuffle Off")"
                            @onclick="ToggleShuffle">
                        <span>Shuffle</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="tracks-section">
            <div class="tracks-header">
                <h2 class="tracks-title">Tracks</h2>
                <button class="btn-add-tracks" @onclick="OpenAddTracksModal">
                    <span>Add Tracks</span>
                </button>
            </div>

            @if (playlistTracks.Any())
            {
                <div class="tracks-table">
                    @for (int i = 0; i < playlistTracks.Count; i++)
                    {
                        var track = playlistTracks[i];
                        var index = i;
                        <div class="track-row @(PlayerService.CurrentTrack?.Id == $"local-{track.Id}" ? "playing" : "")"
                             @onclick="() => PlayTrack(track)">
                            <div class="track-number">@(index + 1)</div>
                            <div class="track-info">
                                <div class="track-art-small">
                                    @if (!string.IsNullOrEmpty(track.CoverImageUrl))
                                    {
                                        <img src="@track.CoverImageUrl" alt="@track.Title" />

                                    }
                                    else
                                    {
                                        <span>꩜</span>
                                    }
                                </div>
                                <div class="track-text">
                                    <div class="track-name">@track.Title</div>
                                    <div class="track-artist-small">@track.ArtistName</div>
                                </div>
                            </div>
                            <div class="track-album">@(track.Genre?.Name ?? "Unknown")</div>
                            <div class="track-duration">3:45</div>
                            <div class="track-actions">
                                <button class="btn-track-action remove"
                                        @onclick="() => RemoveTrackFromPlaylist(track.Id)"
                                        @onclick:stopPropagation="true"
                                        title="Remove from playlist">
                                    ✕
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">꩜</div>
                    <h3>No tracks yet</h3>
                    <p>Add some tracks to get started</p>
                </div>
            }
        </div>
    }
</div>

@if (showAddTracksModal)
{
    <div class="modal-overlay" @onclick="CloseAddTracksModal">
        <div class="modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Add Tracks to Playlist</h2>
                <button class="btn-close" @onclick="CloseAddTracksModal">×</button>
            </div>

            @if (isViewingOtherUsersPlaylist)
            {
                <div style="background: rgba(139, 92, 246, 0.1);
                            border: 1px solid rgba(139, 92, 246, 0.3);
                            border-radius: 12px;
                            padding: 20px;
                            margin-bottom: 20px;
                            text-align: center;">
                    <div style="font-size: 32px; margin-bottom: 12px;">🔒</div>
                    <div style="color: #8B5CF6; font-size: 16px; font-weight: 600; margin-bottom: 8px;">
                        Admin View Only
                    </div>
                    <div style="color: #aaa; font-size: 14px; line-height: 1.5;">
                        You're viewing another user's playlist as an administrator.
                        <br />You cannot modify playlists that belong to other users.
                    </div>
                </div>
            }
            else
            {
                <div class="search-box-modal">
                    <span>🔍</span>
                    <input type="text"
                           class="search-input-modal"
                           @bind="searchQuery"
                           @bind:event="oninput"
                           placeholder="Search your library..." />
                </div>

                <div class="available-tracks">
                    @foreach (var track in FilteredAvailableTracks)
                    {
                        var isInPlaylist = playlistTracks.Any(t => t.Id == track.Id);
                        <div class="available-track-row @(isInPlaylist ? "disabled" : "")"
                             @onclick="() => AddTrackToPlaylist(track.Id)">
                            <div class="track-art-small">
                                @if (!string.IsNullOrEmpty(track.CoverImageUrl))
                                {
                                    <img src="@track.CoverImageUrl" alt="@track.Title" />
                                }
                                else
                                {
                                    <span>🎵</span>
                                }
                            </div>
                            <div class="track-text" style="flex: 1;">
                                <div class="track-name">@track.Title</div>
                                <div class="track-artist-small">@track.ArtistName</div>
                            </div>
                            @if (isInPlaylist)
                            {
                                <span style="color: #8B5CF6; font-size: 12px;">✓ Added</span>
                            }
                            else
                            {
                                <span style="color: #888;">➕</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<!-- Toast Notification -->
@if (showToast)
{
    <div class="toast @toastType">
        <div class="toast-content">
            <span class="toast-icon">@(toastType == "success" ? "✓" : "⚠")</span>
            <span class="toast-message">@toastMessage</span>
        </div>
    </div>
}

<style>
    /* Toast Notification */
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 16px 24px;
        border-radius: 12px;
        background-color: #2a2a2a;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        z-index: 10000;
        animation: slideIn 0.3s ease;
    }

    @@keyframes slideIn {
        from {
            transform: translateX(400px);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .toast.success {
        border-left: 4px solid #10B981;
    }

    .toast.error {
        border-left: 4px solid #ff4444;
    }

    .toast-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .toast-icon {
        font-size: 20px;
        font-weight: bold;
    }

    .toast.success .toast-icon {
        color: #10B981;
    }

    .toast.error .toast-icon {
        color: #ff4444;
    }

    .toast-message {
        color: #ffffff;
        font-size: 14px;
        font-weight: 500;
    }
</style>

<!-- Hidden file input for cover image upload -->
<InputFile OnChange="HandleCoverImageUpload" class="hidden-file-input" accept="image/*" @ref="coverImageInput" />

<QueuePanel />