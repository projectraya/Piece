@page "/subscriptions"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums

<PageTitle>Subscriptions - Piece</PageTitle>

<div class="subscriptions-page">
    <div class="hero-section">
        <h1 class="hero-title">Choose Your Plan</h1>
        <p class="hero-subtitle">Experience Piece at its fullest with Premium!</p>
    </div>

    <div class="plans-container">
        @foreach (var plan in plans)
        {
            <div class="plan-card @(plan.Name == "Premium" ? "premium" : "")">
                <div class="plan-header">
                    <h2 class="plan-name">@plan.Name</h2>
                    <div class="plan-price">
                        @if (plan.Price == 0)
                        {
                            <span class="price-amount">Without cost</span>
                        }
                        else
                        {
                            <span class="price-currency">$</span>
                            <span class="price-amount">@plan.Price.ToString("0.00")</span>
                            <span class="price-period">/month</span>
                        }
                    </div>
                    <p class="plan-description">@plan.Description</p>
                </div>

                <div class="plan-features">
                    <div class="feature-item">
                        <span class="feature-icon">@(plan.CanUseMap ? "✓" : "—")</span>
                        <span class="feature-text">Interactive Map Feature</span>
                    </div>
                    
                </div>

                <button class="plan-button @(plan.Name == "Premium" ? "premium-btn" : "")"
                        @onclick="() => SelectPlan(plan.Id)"
                        disabled="@(currentPlanId == plan.Id)">
                    @if (currentPlanId == plan.Id)
                    {
                        <span>Current Plan</span>
                    }
                    else if (plan.Price == 0)
                    {
                        <span>Downgrade</span>
                    }
                    else
                    {
                        <span>Upgrade</span>
                    }
                </button>
            </div>
        }
    </div>

    @if (showCheckout)
    {
        <div class="modal-overlay" @onclick="CloseCheckout">
            <div class="checkout-modal" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Complete Your Purchase</h2>
                    <button class="close-btn" @onclick="CloseCheckout">✕</button>
                </div>

                <div class="modal-body">
                    <div class="order-summary">
                        <h3>Order Summary</h3>
                        <div class="summary-row">
                            <span>@selectedPlan?.Name Plan</span>
                            <span>$@selectedPlan?.Price.ToString("0.00")</span>
                        </div>
                        <div class="summary-row total">
                            <span>Total</span>
                            <span>$@selectedPlan?.Price.ToString("0.00")</span>
                        </div>
                    </div>

                    <div class="payment-form">
                        <h3>Payment Information</h3>
                        <div class="form-group">
                            <label>Card Number</label>
                            <input type="text" @bind="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" class="form-control" />
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Expiry Date</label>
                                <input type="text" @bind="expiryDate" placeholder="MM/YY" maxlength="5" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>CVV</label>
                                <input type="text" @bind="cvv" placeholder="123" maxlength="3" class="form-control" />
                            </div>
                        </div>
                    </div>

                    @if (showSuccessMessage)
                    {
                        <div class="success-message">
                            <span class="success-icon">✓</span>
                            <span>Payment successful! Redirecting...</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error-message">
                            <span>@errorMessage</span>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="cancel-btn" @onclick="CloseCheckout">Cancel</button>
                    <button class="confirm-btn" @onclick="ProcessPayment" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Pay $@selectedPlan?.Price.ToString("0.00")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showWelcomeModal)
    {
        <div class="modal-overlay" @onclick="CloseWelcomeModal">
            <div class="welcome-modal" @onclick:stopPropagation="true">

                <!-- Header -->
                <div class="welcome-header">
                    <div class="welcome-icon">🎉</div>
                    <h1>Welcome to Premium!</h1>
                    <p class="welcome-subtitle">
                        You now have access to exclusive features
                    </p>
                </div>

                <!-- Feature Highlight -->
                <div class="welcome-feature">
                    <div class="welcome-feature-icon">🗺️</div>
                    <h2>Explore the World Map</h2>
                    <p>
                        Discover music from every corner of the globe.
                        Click on countries to explore local artists and genres.
                    </p>
                </div>

                <!-- Actions -->
                <div class="welcome-actions">
                    <button class="primary-btn" @onclick="GoToMap">
                        Explore Map Now <span class="arrow">→</span>
                    </button>

                    <button class="secondary-btn" @onclick="CloseWelcomeModal">
                        Maybe Later
                    </button>
                </div>

            </div>
        </div>
    }

</div>

<style>
/* ===== PAGE BASE ===== */
.subscriptions-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px;
    min-height: 100vh;
    background: none;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ===== HERO ===== */
.hero-section {
    text-align: center;
    margin-bottom: 60px;
}

.hero-title {
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 12px;
}

.hero-subtitle {
    font-size: 18px;
    color: #aaa;
}

/* ===== PLANS GRID ===== */
.plans-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
}

/* ===== PLAN CARD ===== */
.plan-card {
    background: #2a2a2a;
    border-radius: 16px;
    padding: 36px 32px;
    border: 1px solid #3a3a3a;
    transition: all 0.3s ease;
}

.plan-card:hover {
    transform: translateY(-6px);
    border-color: #8B5CF6;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
}

.plan-card.premium {
    background: rgba(139, 92, 246, 0.08);
    border: 1px solid rgba(139, 92, 246, 0.4);
}

/* ===== HEADER ===== */
.plan-header {
    text-align: center;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid #3a3a3a;
}

.plan-name {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 12px;
}

.plan-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    margin-bottom: 10px;
}

.price-currency {
    font-size: 20px;
    color: #8B5CF6;
    font-weight: 600;
}

.price-amount {
    font-size: 52px;
    font-weight: 700;
    color: #8B5CF6;
    line-height: 1;
}

.price-period {
    font-size: 16px;
    color: #aaa;
}

.plan-description {
    font-size: 14px;
    color: #aaa;
    line-height: 1.6;
}

/* ===== FEATURES ===== */
.plan-features {
    margin-bottom: 32px;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
}

.feature-icon {
    font-size: 16px;
    color: #8B5CF6;
    width: 24px;
    text-align: center;
}

.feature-text {
    font-size: 14px;
    color: #ddd;
}

/* ===== BUTTON ===== */
.plan-button {
    width: 100%;
    padding: 14px;
    border-radius: 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid #3a3a3a;
    background: transparent;
    color: #ffffff;
}

.plan-button:hover:not(:disabled) {
    border-color: #8B5CF6;
    color: #8B5CF6;
    transform: scale(1.04);
}

.plan-button.premium-btn {
    background: #8B5CF6;
    border-color: #8B5CF6;
    color: #ffffff;
}

.plan-button.premium-btn:hover:not(:disabled) {
    background: #7c3aed;
    transform: scale(1.05);
}

.plan-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* ===== MODALS ===== */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
}

.checkout-modal,
.welcome-modal {
    background: #2a2a2a;
    border-radius: 16px;
    border: 1px solid #3a3a3a;
    max-width: 520px;
    width: 100%;
    box-shadow: 0 30px 80px rgba(0,0,0,0.7);
}

/* ===== MODAL HEADER ===== */
.modal-header {
    padding: 28px;
    border-bottom: 1px solid #3a3a3a;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h2 {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
}

.close-btn {
    background: none;
    border: none;
    font-size: 28px;
    color: #888;
    cursor: pointer;
}

.close-btn:hover {
    color: #ffffff;
}

/* ===== MODAL BODY ===== */
.modal-body {
    padding: 28px;
}

.order-summary {
    background: #1a1a1a;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 28px;
    border: 1px solid #3a3a3a;
}

.order-summary h3,
.payment-form h3 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    color: #ccc;
    padding: 10px 0;
}

.summary-row.total {
    border-top: 1px solid #3a3a3a;
    margin-top: 10px;
    padding-top: 14px;
    font-size: 18px;
    color: #8B5CF6;
    font-weight: 700;
}

/* ===== INPUTS ===== */
.form-group label {
    font-size: 13px;
    font-weight: 600;
    color: #ccc;
    margin-bottom: 6px;
    display: block;
}

.form-control {
    width: 100%;
    background: #1a1a1a;
    border: 2px solid #3a3a3a;
    border-radius: 8px;
    padding: 12px 14px;
    color: #fff;
    font-size: 14px;
}

.form-control:focus {
    outline: none;
    border-color: #8B5CF6;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

/* ===== MODAL FOOTER ===== */
.modal-footer {
    padding: 24px 28px;
    border-top: 1px solid #3a3a3a;
    display: flex;
    gap: 12px;
}

.cancel-btn {
    flex: 1;
    border: 2px solid #3a3a3a;
    background: transparent;
    color: #ffffff;
    border-radius: 24px;
    padding: 12px;
    cursor: pointer;
}

.cancel-btn:hover {
    border-color: #888;
}

.confirm-btn {
    flex: 1;
    background: #8B5CF6;
    color: #ffffff;
    border: none;
    border-radius: 24px;
    padding: 12px;
    font-weight: 700;
}

.confirm-btn:hover:not(:disabled) {
    background: #7c3aed;
    transform: scale(1.05);
}

/* ===== SUCCESS / ERROR ===== */
.success-message {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 10px;
    padding: 14px;
    margin-top: 16px;
    color: #10B981;
    display: flex;
    gap: 10px;
    align-items: center;
}

.error-message {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    padding: 14px;
    margin-top: 16px;
    color: #ef4444;
}

/* ===== MOBILE ===== */
@@media (max-width: 768px) {
    .hero-title {
        font-size: 36px;
    }

    .subscriptions-page {
        padding: 40px 20px;
    }
}

    /* ===== WELCOME MODAL ===== */
    .welcome-modal {
        padding: 32px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

        /* Title */
        .welcome-modal h1 {
            font-size: 32px;
            font-weight: 800;
            color: #ffffff;
            margin: 0;
        }

        /* Subtitle */
        .welcome-modal p {
            font-size: 15px;
            color: #aaa;
            line-height: 1.6;
            margin: 0;
        }

    /* Feature block */
    .welcome-feature {
        background: #1a1a1a;
        border: 1px solid #3a3a3a;
        border-radius: 14px;
        padding: 24px;
    }

        .welcome-feature h2 {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 10px;
        }

        .welcome-feature p {
            font-size: 14px;
            color: #ccc;
        }

    /* Actions */
    .welcome-actions {
        display: flex;
        gap: 14px;
        margin-top: 10px;
    }

        /* Primary CTA */
        .welcome-actions .primary-btn {
            flex: 1;
            background: #8B5CF6;
            border: none;
            border-radius: 24px;
            padding: 14px;
            font-weight: 700;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .welcome-actions .primary-btn:hover {
                background: #7c3aed;
                transform: scale(1.04);
            }

        /* Secondary CTA */
        .welcome-actions .secondary-btn {
            flex: 1;
            background: transparent;
            border: 2px solid #3a3a3a;
            border-radius: 24px;
            padding: 14px;
            color: #ffffff;
            font-weight: 600;
            cursor: pointer;
        }

            .welcome-actions .secondary-btn:hover {
                border-color: #888;
            }

</style>


@code {
    private List<SubscriptionPlan> plans = new();
    private int? currentPlanId = null;
    private bool showCheckout = false;
    private SubscriptionPlan? selectedPlan;
    private bool isProcessing = false;
    private bool showSuccessMessage = false;
    private string errorMessage = "";

    // Form fields
    private string cardNumber = "";
    private string expiryDate = "";
    private string cvv = "";
    private string? currentUserId;
    private bool showWelcomeModal = false;

    private void CloseWelcomeModal()
    {
        showWelcomeModal = false;
        StateHasChanged();
    }

    private void GoToMap()
    {
        Navigation.NavigateTo("/map");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadPlans();
        await LoadCurrentSubscription();
    }

    private async Task LoadPlans()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        plans = await context.SubscriptionPlans
            .Where(p => p.IsActive)
            .OrderBy(p => p.Price)
            .ToListAsync();
    }

    private async Task LoadCurrentSubscription()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;
        using var context = await DbFactory.CreateDbContextAsync();
        var currentSub = await context.UserSubscriptions
            .Where(s => s.UserId == currentUserId && s.Status == SubscriptionStatus.Active && s.EndDate > DateTime.UtcNow)
            .Include(s => s.SubscriptionPlan)
            .FirstOrDefaultAsync();

        if (currentSub != null)
        {
            currentPlanId = currentSub.SubscriptionPlanId;
        }
    }

    private void SelectPlan(int planId)
    {
        if (string.IsNullOrEmpty(currentUserId))
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        selectedPlan = plans.FirstOrDefault(p => p.Id == planId);
        if (selectedPlan != null)
        {
            if (selectedPlan.Price == 0)
            {
                // Free plan - activate immediately
                _ = ActivateFreePlan();
            }
            else
            {
                // Paid plan - show checkout
                showCheckout = true;
            }
        }
    }

    private async Task ActivateFreePlan()
    {
        if (string.IsNullOrEmpty(currentUserId) || selectedPlan == null) return;
        using var context = await DbFactory.CreateDbContextAsync();
        try
        {
            // Deactivate any existing subscriptions
            var existingSubs = await context.UserSubscriptions
                .Where(s => s.UserId == currentUserId)
                .ToListAsync();

            foreach (var sub in existingSubs)
            {
                sub.Status = SubscriptionStatus.Cancelled;
            }

            // Create new free subscription
            var newSub = new UserSubscription
                {
                    UserId = currentUserId,
                    SubscriptionPlanId = selectedPlan.Id,
                    StartDate = DateTime.UtcNow,
                    EndDate = DateTime.UtcNow.AddYears(100), // Free forever
                    Status = SubscriptionStatus.Active,
                    AutoRenew = false
                };

            context.UserSubscriptions.Add(newSub);
            await context.SaveChangesAsync();

            currentPlanId = selectedPlan.Id;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error activating free plan: {ex.Message}");
        }
    }

    private void CloseCheckout()
    {
        showCheckout = false;
        showSuccessMessage = false;
        errorMessage = "";
        cardNumber = "";
        expiryDate = "";
        cvv = "";
    }

    private async Task ProcessPayment()
    {
        if (string.IsNullOrEmpty(currentUserId) || selectedPlan == null) return;

        // Basic validation
        if (string.IsNullOrWhiteSpace(cardNumber) || string.IsNullOrWhiteSpace(expiryDate) || string.IsNullOrWhiteSpace(cvv))
        {
            errorMessage = "Please fill in all payment fields";
            return;
        }

        isProcessing = true;
        errorMessage = "";
        StateHasChanged();
        using var context = await DbFactory.CreateDbContextAsync();
        try
        {
            // Simulate payment processing delay
            await Task.Delay(2000);

            // Deactivate any existing subscriptions
            var existingSubs = await context.UserSubscriptions
                .Where(s => s.UserId == currentUserId)
                .ToListAsync();

            foreach (var sub in existingSubs)
            {
                sub.Status = SubscriptionStatus.Cancelled;
            }

            var newSub = new UserSubscription
                {
                    UserId = currentUserId,
                    SubscriptionPlanId = selectedPlan.Id,
                    StartDate = DateTime.UtcNow,
                    EndDate = DateTime.UtcNow.AddDays(selectedPlan.DurationDays),
                    Status = SubscriptionStatus.Active,
                    AutoRenew = true,
                    PaymentMethod = "Card ending in " + cardNumber.Substring(Math.Max(0, cardNumber.Length - 4)),
                    TransactionId = Guid.NewGuid().ToString()
                };

            context.UserSubscriptions.Add(newSub);

            // SAVE HERE to get the UserSubscription.Id
            await context.SaveChangesAsync();

            // NOW create payment record with the saved subscription ID
            var payment = new Payment
                {
                    UserId = currentUserId,
                    UserSubscriptionId = newSub.Id, // Now this has a valid ID
                    Amount = selectedPlan.Price,
                    Currency = "USD",
                    Status = PaymentStatus.Completed,
                    PaymentMethod = "Credit Card",
                    TransactionId = newSub.TransactionId,
                    CompletedAt = DateTime.UtcNow
                };

            context.Payments.Add(payment);
            await context.SaveChangesAsync(); // Save again for the payment

            // Show success message
            showSuccessMessage = true;
            StateHasChanged();

            // Wait a bit, then close checkout and show welcome modal
            await Task.Delay(1500);
            showCheckout = false;
            showWelcomeModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = "Payment failed. Please try again.";
            Console.WriteLine($"Payment error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}