@page "/Account/Banned"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Piece.Data
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Account Banned - Piece</PageTitle>

<style>
    body {
        margin: 0;
        padding: 0;
    }

    .banned-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1a1a1a 0%, #2a0a0a 100%);
        padding: 20px;
    }

    .banned-card {
        background: #2a2a2a;
        border: 2px solid #ef4444;
        border-radius: 12px;
        padding: 40px;
        max-width: 500px;
        width: 100%;
        text-align: center;
        box-shadow: 0 10px 40px rgba(239, 68, 68, 0.3);
    }

    .banned-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    .banned-title {
        font-size: 32px;
        font-weight: 700;
        color: #ef4444;
        margin-bottom: 15px;
    }

    .banned-message {
        font-size: 16px;
        color: #ccc;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .ban-reason-box {
        background: #1a1a1a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
        text-align: left;
    }

    .ban-reason-label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .ban-reason-text {
        font-size: 14px;
        color: #fff;
        line-height: 1.5;
    }

    .banned-date {
        font-size: 13px;
        color: #888;
        margin-bottom: 30px;
    }

    .btn-logout {
        padding: 12px 30px;
        background: #3a3a3a;
        border: 1px solid #4a4a4a;
        border-radius: 8px;
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 16px;
    }

        .btn-logout:hover {
            background: #4a4a4a;
            transform: translateY(-2px);
        }

    .support-text {
        font-size: 13px;
        color: #888;
        margin-top: 20px;
    }
</style>

<div class="banned-container">
    <div class="banned-card">
        <div class="banned-icon">🚫</div>
        <h1 class="banned-title">Account Banned</h1>

        <p class="banned-message">
            Your account has been suspended and you no longer have access to Piece.
        </p>

        @if (bannedUser != null)
        {
            @if (!string.IsNullOrEmpty(bannedUser.BanReason))
            {
                <div class="ban-reason-box">
                    <div class="ban-reason-label">Reason for Ban</div>
                    <div class="ban-reason-text">@bannedUser.BanReason</div>
                </div>
            }

            @if (bannedUser.BannedAt.HasValue)
            {
                <div class="banned-date">
                    Banned on @bannedUser.BannedAt.Value.ToString("MMMM dd, yyyy 'at' HH:mm")
                </div>
            }
        }

        <form action="Account/Logout" method="post" class="logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
            <button type="submit" class="logout-btn">
                <span class="nav-icon">✌︎</span>
                <span class="nav-text">Logout</span>
            </button>
        </form>

        <p class="support-text">
            If you believe this is a mistake, please contact support.
        </p>
    </div>
</div>

@code {
    private ApplicationUser? bannedUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                bannedUser = await UserManager.FindByIdAsync(userId);
            }
        }
    }

    
}