@page "/playlists"
@rendermode InteractiveServer
@inject Piece.Services.LanguageService Lang

<PageTitle>Playlists - Piece</PageTitle>


<style>
    body {
        background-color: #1a1a1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .playlists-container {
        padding: 40px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .page-title {
        font-size: 48px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .btn-primary {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 24px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
            background: none;
        }

    .action-btn {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 1;
        justify-content: center;
    }

        .action-btn:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
        }
     

    .playlists-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }

    .playlist-card {
        background-color: #2a2a2a;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .playlist-card:hover {
            background-color: #3a3a3a;
            transform: translateY(-4px);
        }

    .playlist-cover {
        width: 100%;
        aspect-ratio: 1;
        background: #8B5CF6;
        border-radius: 8px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        overflow: hidden;
        position: relative;
    }

        .playlist-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
        }

        .playlist-cover .cover-icon {
            position: relative;
            z-index: 1;
        }

    .playlist-info {
        margin-bottom: 8px;
    }

    .playlist-name {
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .playlist-meta {
        font-size: 13px;
        color: #888;
    }

    .playlist-description {
        font-size: 12px;
        color: #aaa;
        margin-bottom: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .playlist-actions {
        display: flex;
        gap: 6px;
    }

    .btn-icon {
        background: none;
        border: none;
        color: #888;
        font-size: 20px;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-icon:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.1);
        }

        .btn-icon.delete:hover {
            color: #ff4444;
        }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

    .modal {
        background-color: #2a2a2a;
        border-radius: 16px;
        padding: 32px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .modal-header {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 24px;
        color: #ffffff;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 8px;
    }

    .form-input,
    .form-textarea {
        width: 100%;
        background-color: #1a1a1a;
        border: 2px solid #3a3a3a;
        border-radius: 8px;
        padding: 12px 16px;
        color: #ffffff;
        font-size: 14px;
        transition: border-color 0.3s ease;
    }

        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #667eea;
        }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .btn-secondary {
        background-color: #3a3a3a;
        color: #ffffff;
        border: none;
        padding: 12px 24px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #4a4a4a;
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #888;
    }

    .empty-state-icon {
        font-size: 96px;
        margin-bottom: 24px;
    }

    .empty-state h3 {
        font-size: 24px;
        margin-bottom: 12px;
        color: #ffffff;
    }

    /* Loading State */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: #888;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #3a3a3a;
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="playlists-container">
    <div class="page-header">
        <h1 class="page-title">@Lang.T("Playlists")</h1>
        <button class="btn-primary" @onclick="OpenCreateModal">
            <span>@Lang.T("Create Playlist")</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p style="margin-top: 20px;">@Lang.T("Loading playlists")...</p>
        </div>
    }
    else if (!playlists.Any())
    {
        <div class="empty-state">
            <h3>@Lang.T("No playlists yet")</h3>
            <p>@Lang.T("Create your first playlist to organize your music")</p>
        </div>
    }
    else
    {
        <div class="playlists-grid">
            @foreach (var playlist in playlists)
            {
                <div class="playlist-card">
                    <div class="playlist-cover" @onclick="() => ViewPlaylist(playlist.Id)">
                        @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                        {
                            <img src="@playlist.CoverImageUrl" alt="@playlist.Name" />
                        }
                        else
                        {
                            <span class="cover-icon">꩜</span>
                        }
                    </div>
                    <div class="playlist-info">
                        <div class="playlist-name">@playlist.Name</div>
                        <div class="playlist-meta">
                            @playlist.PlaylistTracks.Count @(playlist.PlaylistTracks.Count == 1 ? "track" : "tracks")
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(playlist.Description))
                    {
                        <div class="playlist-description">@playlist.Description</div>
                    }
                    <div class="playlist-actions">
                        <button class="action-btn" @onclick="() => OpenEditModal(playlist)">
                            <span>@Lang.T("Edit")</span>
                        </button>
                        <button class="action-btn" @onclick="() => DeletePlaylist(playlist.Id)">
                            <span>@Lang.T("Delete")</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showModal)
{
    <div style="position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: rgba(0,0,0,0.8);
                z-index: 99999;
                display: flex;
                align-items: center;
                justify-content: center;"
         @onclick="CloseModal">

        <div style="background: #2a2a2a;
                    padding: 32px;
                    border-radius: 16px;
                    max-width: 500px;
                    width: 90%;
                    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);"
             @onclick:stopPropagation="true">

            <h2 style="font-size: 24px;
                       font-weight: 700;
                       margin-bottom: 24px;
                       color: #ffffff;">
                @(isEditMode ? Lang.T("Edit Playlist") : Lang.T("Create Playlist"))
            </h2>

            <div style="margin-bottom: 20px;">
                <label style="display: block;
                              font-size: 14px;
                              font-weight: 600;
                              color: #ffffff;
                              margin-bottom: 8px;">
                    @Lang.T("Name")
                </label>
                <input type="text"
                       @bind="playlistName"
                       placeholder="@Lang.T("My Awesome Playlist")"
                       style="width: 100%;
                              background-color: #1a1a1a;
                              border: 2px solid #3a3a3a;
                              border-radius: 8px;
                              padding: 12px 16px;
                              color: #ffffff;
                              font-size: 14px;" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block;
                              font-size: 14px;
                              font-weight: 600;
                              color: #ffffff;
                              margin-bottom: 8px;">
                    @Lang.T("Description (Optional)")
                </label>
                <textarea @bind="playlistDescription"
                          placeholder="@Lang.T("A collection of my favorite tracks")"
                          style="width: 100%;
                                 background-color: #1a1a1a;
                                 border: 2px solid #3a3a3a;
                                 border-radius: 8px;
                                 padding: 12px 16px;
                                 color: #ffffff;
                                 font-size: 14px;
                                 resize: vertical;
                                 min-height: 100px;"></textarea>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: flex;
                              align-items: center;
                              gap: 8px;
                              cursor: pointer;
                              font-size: 14px;
                              font-weight: 600;
                              color: #ffffff;">
                    <input type="checkbox"
                           @bind="isPublic"
                           style="width: 18px; height: 18px; cursor: pointer; accent-color: #8B5CF6" />
                    <span>@Lang.T("Make this playlist public")</span>
                </label>
            </div>

            <div style="display: flex;
                        gap: 12px;
                        justify-content: flex-end;
                        margin-top: 24px;">
                <button @onclick="CloseModal"
                        style="background-color: #3a3a3a;
                               color: #ffffff;
                               border: none;
                               padding: 12px 24px;
                               border-radius: 24px;
                               font-size: 14px;
                               font-weight: 600;
                               cursor: pointer;">
                    @Lang.T("Cancel")
                </button>
                <button @onclick="SavePlaylist"
                        style="background: #8B5CF6;
                               color: #ffffff;
                               border: none;
                               padding: 12px 24px;
                               border-radius: 24px;
                               font-size: 14px;
                               font-weight: 600;
                               cursor: pointer;">
                    @(isEditMode ? Lang.T("Save changes") : Lang.T("Create"))
                </button>
            </div>
        </div>
    </div>
}