@page "/admin/tracks"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using Microsoft.EntityFrameworkCore
@using Piece.Services
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IActivityLogger ActivityLogger
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Track Management - Piece</PageTitle>

<style>
    .admin-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
        color: #fff;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255, 211, 53, 0.2);
    }

    .admin-title {
        font-size: 28px;
        font-weight: 600;
        color: #FFD335;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #888;
        margin-top: 5px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .btn-action {
        padding: 10px 20px;
        background: #FFD335;
        border: none;
        border-radius: 8px;
        color: #1a1a1a;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-action:hover {
            background: #ffd000;
            transform: translateY(-2px);
        }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 30px;
    }

    .stat-box {
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        padding: 20px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #FFD335;
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .search-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
    }

    .search-input {
        flex: 1;
        padding: 12px 16px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
    }

        .search-input:focus {
            outline: none;
            border-color: #FFD335;
        }

    .filter-select {
        padding: 12px 16px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        min-width: 150px;
        cursor: pointer;
    }

        .filter-select:focus {
            outline: none;
            border-color: #FFD335;
        }

    .table-container {
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            text-align: left;
            padding: 16px;
            font-size: 12px;
            font-weight: 600;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: #1a1a1a;
            border-bottom: 1px solid #3a3a3a;
        }

        .data-table td {
            padding: 16px;
            font-size: 14px;
            color: #ccc;
            border-bottom: 1px solid #2a2a2a;
        }

        .data-table tbody tr:hover {
            background: #1a1a1a;
        }

    .track-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .track-cover {
        width: 50px;
        height: 50px;
        border-radius: 6px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        overflow: hidden;
    }

        .track-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .track-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .track-title {
        font-weight: 600;
        color: #fff;
    }

    .track-meta {
        font-size: 12px;
        color: #888;
    }

    .play-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: rgba(74, 222, 128, 0.1);
        color: #4ade80;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-small {
        padding: 6px 12px;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        background: #1a1a1a;
        color: #ccc;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .btn-small:hover {
            background: #2a2a2a;
            border-color: #FFD335;
            color: #FFD335;
        }

    .btn-danger {
        border-color: #ef4444;
        color: #ef4444;
    }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.1);
            border-color: #ef4444;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #666;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
    }

    .page-btn {
        padding: 8px 16px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        color: #ccc;
        cursor: pointer;
        transition: all 0.2s;
    }

        .page-btn:hover:not(:disabled) {
            background: #3a3a3a;
            border-color: #FFD335;
        }

        .page-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

    .page-info {
        color: #888;
        font-size: 14px;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
    }

    .modal-content {
        background: #2a2a2a;
        border-radius: 12px;
        padding: 30px;
        max-width: 500px;
        width: 100%;
        border: 1px solid #3a3a3a;
    }

    .modal-header {
        margin-bottom: 20px;
    }

    .modal-title {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 8px;
    }

    .modal-subtitle {
        font-size: 14px;
        color: #888;
    }

    .modal-body {
        margin: 20px 0;
        padding: 20px;
        background: #1a1a1a;
        border-radius: 8px;
    }

    .modal-track-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .modal-track-title {
        font-size: 16px;
        font-weight: 600;
        color: #fff;
    }

    .modal-track-meta {
        font-size: 14px;
        color: #888;
    }

    .modal-warning {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 12px;
        margin-top: 15px;
    }

    .modal-warning-text {
        color: #ef4444;
        font-size: 13px;
        line-height: 1.5;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-delete {
        background: #ef4444;
        color: #fff;
    }

        .btn-delete:hover {
            background: #dc2626;
        }

    .btn-cancel {
        background: #3a3a3a;
        color: #fff;
    }

        .btn-cancel:hover {
            background: #4a4a4a;
        }
</style>

@if (isLoading)
{
    <div class="admin-container">
        <div style="text-align: center; padding: 100px 0;">
            <div class="spinner"></div>
            <p style="color: #888; margin-top: 20px;">Loading tracks...</p>
        </div>
    </div>
}
else
{
    <div class="admin-container">
        <!-- Header -->
        <div class="admin-header">
            <div>
                <h1 class="admin-title">Track Management</h1>
                <p class="admin-subtitle">Manage uploaded music library</p>
            </div>
            <div class="header-actions">
                <a href="/admin/upload" class="btn-action">+ Upload Track</a>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats-row">
            <div class="stat-box">
                <div class="stat-value">@totalTracks</div>
                <div class="stat-label">Uploaded Tracks</div>
            </div>
            <div class="stat-box">
                <div class="stat-value">@totalPlays</div>
                <div class="stat-label">Total Plays</div>
            </div>
            <div class="stat-box">
                <div class="stat-value">@(totalTracks > 0 ? (totalPlays / totalTracks) : 0)</div>
                <div class="stat-label">Avg Plays/Track</div>
            </div>
            <div class="stat-box">
                <div class="stat-value">@filteredTracks.Count</div>
                <div class="stat-label">Showing</div>
            </div>
        </div>

        <!-- Search & Filters -->
        <div class="search-bar">
            <input type="text"
                   class="search-input"
                   placeholder="Search by title, artist, or album..."
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeyup="ApplyFilters" />
            <select class="filter-select" @bind="genreFilter" @bind:after="ApplyFilters">
                <option value="">All Genres</option>
                @foreach (var genre in allGenres)
                {
                    <option value="@genre.Id">@genre.Name</option>
                }
            </select>
        </div>

        <!-- Tracks Table -->
        <div class="table-container">
            @if (filteredTracks.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Track</th>
                            <th>Genre</th>
                            <th>Duration</th>
                            <th>Plays</th>
                            <th>Uploaded</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in paginatedTracks)
                        {
                            <tr>
                                <td>
                                    <div class="track-info">
                                        <div class="track-cover">
                                            @if (!string.IsNullOrEmpty(track.CoverImageUrl))
                                            {
                                                <img src="@track.CoverImageUrl" alt="@track.Title" />
                                            }
                                            else
                                            {
                                                <span>🎵</span>
                                            }
                                        </div>
                                        <div class="track-details">
                                            <div class="track-title">@track.Title</div>
                                            <div class="track-meta">
                                                @track.ArtistName
                                                @if (!string.IsNullOrEmpty(track.AlbumName))
                                                {
                                                    <span> • @track.AlbumName</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (track.Genre != null)
                                    {
                                        <span style="color: @track.Genre.Color; font-weight: 500;">@track.Genre.Name</span>
                                    }
                                    else
                                    {
                                        <span style="color: #666;">—</span>
                                    }
                                </td>
                                <td style="color: #888;">
                                    @FormatDuration(track.DurationSeconds)
                                </td>
                                <td>
                                    <span class="play-count">
                                        ▶ @track.PlayCount
                                    </span>
                                </td>
                                <td style="color: #888; font-size: 13px;">
                                    @track.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-small btn-danger" @onclick="() => OpenDeleteModal(track)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <button class="page-btn" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                            ← Previous
                        </button>
                        <span class="page-info">Page @currentPage of @totalPages</span>
                        <button class="page-btn" @onclick="NextPage" disabled="@(currentPage == totalPages)">
                            Next →
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <p>No tracks found</p>
                    <a href="/admin/upload" style="color: #FFD335; margin-top: 15px; display: inline-block;">Upload your first track →</a>
                </div>
            }
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    @if (showDeleteModal && trackToDelete != null)
    {
        <div class="modal-overlay" @onclick="CloseDeleteModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title">Delete Track</div>
                    <div class="modal-subtitle">Are you sure you want to delete this track?</div>
                </div>

                <div class="modal-body">
                    <div class="modal-track-info">
                        <div class="modal-track-title">@trackToDelete.Title</div>
                        <div class="modal-track-meta">by @trackToDelete.ArtistName</div>
                    </div>

                    <div class="modal-warning">
                        <div class="modal-warning-text">
                            ⚠️ This action cannot be undone. The track will be removed from all playlists and the audio file will be deleted from the server.
                        </div>
                    </div>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-delete" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Delete Track</span>
                        }
                    </button>
                    <button class="btn btn-cancel" @onclick="CloseDeleteModal">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private List<Track> allTracks = new();
    private List<Track> filteredTracks = new();
    private List<Track> paginatedTracks = new();
    private List<Genre> allGenres = new();

    private int totalTracks = 0;
    private int totalPlays = 0;

    private string searchQuery = "";
    private string genreFilter = "";

    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages = 1;

    private bool showDeleteModal = false;
    private Track? trackToDelete = null;
    private bool isDeleting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTracks();
            StateHasChanged();
        }
    }

    private async Task LoadTracks()
    {
        isLoading = true;
        try
        {
            allTracks = await DbContext.Tracks
                .Include(t => t.Genre)
                .Where(t => t.IsActive && t.Source == TrackSource.Local)
                .OrderByDescending(t => t.PlayCount)
                .ToListAsync();

            allGenres = await DbContext.Genres
                .OrderBy(g => g.Name)
                .ToListAsync();

            totalTracks = allTracks.Count;
            totalPlays = allTracks.Sum(t => t.PlayCount);

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracks: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var query = allTracks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.ToLower();
            query = query.Where(t =>
                t.Title.ToLower().Contains(search) ||
                t.ArtistName.ToLower().Contains(search) ||
                (t.AlbumName?.ToLower().Contains(search) ?? false)
            );
        }

        if (!string.IsNullOrEmpty(genreFilter) && int.TryParse(genreFilter, out int genreId))
        {
            query = query.Where(t => t.GenreId == genreId);
        }

        filteredTracks = query.ToList();

        currentPage = 1;
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling(filteredTracks.Count / (double)pageSize);
        var skip = (currentPage - 1) * pageSize;
        paginatedTracks = filteredTracks.Skip(skip).Take(pageSize).ToList();
        StateHasChanged();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagination();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagination();
        }
    }

    private void OpenDeleteModal(Track track)
    {
        trackToDelete = track;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        trackToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (trackToDelete == null) return;

        isDeleting = true;
        try
        {
            if (!string.IsNullOrEmpty(trackToDelete.LocalFilePath))
            {
                var filePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", trackToDelete.LocalFilePath.TrimStart('/'));
                if (File.Exists(filePath))
                {
                    File.Delete(filePath);
                    Console.WriteLine($"[TrackManagement] Deleted file: {filePath}");
                }
            }

            if (!string.IsNullOrEmpty(trackToDelete.CoverImageUrl) &&
                !trackToDelete.CoverImageUrl.Contains("default-album-cover"))
            {
                var imagePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", trackToDelete.CoverImageUrl.TrimStart('/'));
                if (File.Exists(imagePath))
                {
                    File.Delete(imagePath);
                    Console.WriteLine($"[TrackManagement] Deleted cover: {imagePath}");
                }
            }

            trackToDelete.IsActive = false;
            await DbContext.SaveChangesAsync();
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserEmail = authState.User.Identity?.Name ?? "Unknown";
            await ActivityLogger.LogAsync(
                "TrackDelete",
                $"Deleted track '{trackToDelete.Title}' by {trackToDelete.ArtistName}",
                currentUserEmail,
                trackToDelete.Title,
                $"Genre: {trackToDelete.Genre?.Name ?? "Unknown"}, Play Count: {trackToDelete.PlayCount}",
                "Warning"
            );

            Console.WriteLine($"[TrackManagement] Deleted track: {trackToDelete.Title}");

            allTracks.Remove(trackToDelete);

            totalTracks = allTracks.Count;
            totalPlays = allTracks.Sum(t => t.PlayCount);

            ApplyFilters();
            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting track: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string FormatDuration(int seconds)
    {
        var minutes = seconds / 60;
        var remainingSeconds = seconds % 60;
        return $"{minutes}:{remainingSeconds:D2}";
    }
}