@page "/admin/tracks"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using Microsoft.EntityFrameworkCore
@using Piece.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IActivityLogger ActivityLogger
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Track Management - Piece</PageTitle>

<style>
    .admin-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
        color: #fff;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255, 211, 53, 0.2);
    }

    .admin-title {
        font-size: 28px;
        font-weight: 600;
        color: #000;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #888;
        margin-top: 5px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .btn-action {
        padding: 10px 20px;
        background: #FFD335;
        border: none;
        border-radius: 8px;
        color: #1a1a1a;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-action:hover {
        background: #ffd000;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: #3a3a3a;
        color: #fff;
    }

    .btn-secondary:hover {
        background: #4a4a4a;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 15px;
        margin-bottom: 30px;
    }

    .stat-box {
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        padding: 20px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #FFD335;
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .search-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
    }

    .search-input {
        flex: 1;
        padding: 12px 16px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
    }

    .search-input:focus {
        outline: none;
        border-color: #FFD335;
    }

    .filter-select {
        padding: 12px 16px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        min-width: 150px;
        cursor: pointer;
    }

    .filter-select:focus {
        outline: none;
        border-color: #FFD335;
    }

    .table-container {
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        text-align: left;
        padding: 16px;
        font-size: 12px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: #1a1a1a;
        border-bottom: 1px solid #3a3a3a;
    }

    .data-table td {
        padding: 16px;
        font-size: 14px;
        color: #ccc;
        border-bottom: 1px solid #2a2a2a;
    }

    .data-table tbody tr:hover {
        background: #1a1a1a;
    }

    .data-table tbody tr.archived {
        opacity: 0.5;
        background: #1a1a1a;
    }

    .track-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .track-cover {
        width: 50px;
        height: 50px;
        border-radius: 6px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        overflow: hidden;
    }

    .track-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .track-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .track-title {
        font-weight: 600;
        color: #fff;
    }

    .track-meta {
        font-size: 12px;
        color: #888;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-active {
        background: rgba(74, 222, 128, 0.1);
        color: #4ade80;
    }

    .status-archived {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    .play-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: rgba(74, 222, 128, 0.1);
        color: #4ade80;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-small {
        padding: 6px 12px;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        background: #1a1a1a;
        color: #ccc;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .btn-small:hover {
        background: #2a2a2a;
        border-color: #FFD335;
        color: #FFD335;
    }

    .btn-danger {
        border-color: #ef4444;
        color: #ef4444;
    }

    .btn-danger:hover {
        background: rgba(239, 68, 68, 0.1);
        border-color: #ef4444;
    }

    .btn-success {
        border-color: #4ade80;
        color: #4ade80;
    }

    .btn-success:hover {
        background: rgba(74, 222, 128, 0.1);
        border-color: #4ade80;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #666;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
    }

    .page-btn {
        padding: 8px 16px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        color: #ccc;
        cursor: pointer;
        transition: all 0.2s;
    }

    .page-btn:hover:not(:disabled) {
        background: #3a3a3a;
        border-color: #FFD335;
    }

    .page-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .page-info {
        color: #888;
        font-size: 14px;
    }

    /* Modal styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
    }

    .modal-content {
        background: #2a2a2a;
        border-radius: 12px;
        padding: 30px;
        max-width: 500px;
        width: 100%;
        border: 1px solid #3a3a3a;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        margin-bottom: 20px;
    }

    .modal-title {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 8px;
    }

    .modal-subtitle {
        font-size: 14px;
        color: #888;
    }

    .modal-body {
        margin: 20px 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
        font-size: 14px;
        font-weight: 600;
    }

    .form-input {
        width: 100%;
        padding: 12px;
        background: #1a1a1a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
    }

    .form-input:focus {
        outline: none;
        border-color: #FFD335;
    }

    .modal-warning {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 12px;
        margin-top: 15px;
    }

    .modal-warning-text {
        color: #ef4444;
        font-size: 13px;
        line-height: 1.5;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-primary {
        background: #FFD335;
        color: #1a1a1a;
    }

    .btn-primary:hover {
        background: #ffd000;
    }

    .btn-delete {
        background: #ef4444;
        color: #fff;
    }

    .btn-delete:hover {
        background: #dc2626;
    }

    .btn-restore {
        background: #4ade80;
        color: #1a1a1a;
    }

    .btn-restore:hover {
        background: #22c55e;
    }

    .btn-cancel {
        background: #3a3a3a;
        color: #fff;
    }

    .btn-cancel:hover {
        background: #4a4a4a;
    }
</style>

@if (isLoading)
{
    <div class="admin-container">
        <div style="text-align: center; padding: 100px 0;">
            <div class="spinner"></div>
            <p style="color: #888; margin-top: 20px;">Loading tracks...</p>
        </div>
    </div>
}
else
{
    <div class="admin-container">
        <!-- Header -->
        <div class="admin-header">
            <div>
                <h1 class="admin-title">Track Management</h1>
                <p class="admin-subtitle">Manage uploaded music library</p>
            </div>
            <div class="header-actions">
                <button class="btn-action btn-secondary" @onclick="ToggleShowArchived">
                    @(showArchived ? "Hide Archived" : "Show Archived")
                </button>
                <a href="/admin/upload" class="btn-action">+ Upload Track</a>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats-row">
            <div class="stat-box">
                <div class="stat-value">@activeTracks</div>
                <div class="stat-label">Active Tracks</div>
            </div>
            <div class="stat-box">
                <div class="stat-value">@archivedTracks</div>
                <div class="stat-label">Archived</div>
            </div>
            <div class="stat-box">
                <div class="stat-value">@totalPlays</div>
                <div class="stat-label">Total Plays</div>
            </div>
            <div class="stat-box">
                <div class="stat-value">@filteredTracks.Count</div>
                <div class="stat-label">Showing</div>
            </div>
        </div>

        <!-- Search & Filters -->
        <div class="search-bar">
            <input type="text"
                   class="search-input"
                   placeholder="Search by title, artist, or album..."
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeyup="ApplyFilters" />
            <select class="filter-select" @bind="genreFilter" @bind:after="ApplyFilters">
                <option value="">All Genres</option>
                @foreach (var genre in allGenres)
                {
                    <option value="@genre.Id">@genre.Name</option>
                }
            </select>
        </div>

        <!-- Tracks Table -->
        <div class="table-container">
            @if (filteredTracks.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Track</th>
                            <th>Genre</th>
                            <th>Duration</th>
                            <th>Plays</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in paginatedTracks)
                        {
                            <tr class="@(track.IsActive ? "" : "archived")">
                                <td>
                                    <div class="track-info">
                                        <div class="track-cover">
                                            @if (!string.IsNullOrEmpty(track.CoverImageUrl))
                                            {
                                                <img src="@track.CoverImageUrl" alt="@track.Title" />
                                            }
                                            else
                                            {
                                                <span>🎵</span>
                                            }
                                        </div>
                                        <div class="track-details">
                                            <div class="track-title">@track.Title</div>
                                            <div class="track-meta">
                                                @track.ArtistName
                                                @if (!string.IsNullOrEmpty(track.AlbumName))
                                                {
                                                    <span> • @track.AlbumName</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (track.Genre != null)
                                    {
                                        <span style="color: @track.Genre.Color; font-weight: 500;">@track.Genre.Name</span>
                                    }
                                    else
                                    {
                                        <span style="color: #666;">—</span>
                                    }
                                </td>
                                <td style="color: #888;">
                                    @FormatDuration(track.DurationSeconds)
                                </td>
                                <td>
                                    <span class="play-count">
                                        ▶ @track.PlayCount
                                    </span>
                                </td>
                                <td>
                                    @if (track.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-archived">Archived</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        @if (track.IsActive)
                                        {
                                            <button class="btn-small" @onclick="() => OpenEditModal(track)">
                                                Edit
                                            </button>
                                            <button class="btn-small btn-danger" @onclick="() => OpenArchiveModal(track)">
                                                Archive
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-small btn-success" @onclick="() => RestoreTrack(track)">
                                                Restore
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <button class="page-btn" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                            ← Previous
                        </button>
                        <span class="page-info">Page @currentPage of @totalPages</span>
                        <button class="page-btn" @onclick="NextPage" disabled="@(currentPage == totalPages)">
                            Next →
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <p>No tracks found</p>
                    <a href="/admin/upload" style="color: #FFD335; margin-top: 15px; display: inline-block;">Upload your first track →</a>
                </div>
            }
        </div>
    </div>

    <!-- Edit Modal -->
    @if (showEditModal && trackToEdit != null)
    {
        <div class="modal-overlay" @onclick="CloseEditModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title">Edit Track</div>
                    <div class="modal-subtitle">Update track information</div>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-input" @bind="editTitle" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Artist Name</label>
                        <input type="text" class="form-input" @bind="editArtistName" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Album Name</label>
                        <input type="text" class="form-input" @bind="editAlbumName" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Genre</label>
                        <select class="form-input" @bind="editGenreId">
                            <option value="">Select Genre</option>
                            @foreach (var genre in allGenres)
                            {
                                <option value="@genre.Id">@genre.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Year Published</label>
                        <input type="number" class="form-input" @bind="editYearPublished" />
                    </div>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-primary" @onclick="SaveTrackEdit" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                    <button class="btn btn-cancel" @onclick="CloseEditModal">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Archive Confirmation Modal -->
    @if (showArchiveModal && trackToArchive != null)
    {
        <div class="modal-overlay" @onclick="CloseArchiveModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title">Archive Track</div>
                    <div class="modal-subtitle">Move this track to archive</div>
                </div>

                <div class="modal-body">
                    <div style="padding: 20px; background: #1a1a1a; border-radius: 8px;">
                        <div style="font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 8px;">
                            @trackToArchive.Title
                        </div>
                        <div style="font-size: 14px; color: #888;">
                            by @trackToArchive.ArtistName
                        </div>
                    </div>

                    <div style="background: rgba(255, 211, 53, 0.1); border: 1px solid rgba(255, 211, 53, 0.3); 
                                border-radius: 8px; padding: 12px; margin-top: 15px;">
                        <div style="color: #FFD335; font-size: 13px; line-height: 1.5;">
                            ℹ️ Archived tracks are hidden from users but can be restored at any time. The audio file will remain on the server.
                        </div>
                    </div>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-delete" @onclick="ConfirmArchive" disabled="@isArchiving">
                        @if (isArchiving)
                        {
                            <span>Archiving...</span>
                        }
                        else
                        {
                            <span>Archive Track</span>
                        }
                    </button>
                    <button class="btn btn-cancel" @onclick="CloseArchiveModal">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private List<Track> allTracks = new();
    private List<Track> filteredTracks = new();
    private List<Track> paginatedTracks = new();
    private List<Genre> allGenres = new();

    private int activeTracks = 0;
    private int archivedTracks = 0;
    private int totalPlays = 0;

    private string searchQuery = "";
    private string genreFilter = "";
    private bool showArchived = false;

    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages = 1;

    private bool showEditModal = false;
    private Track? trackToEdit = null;
    private string editTitle = "";
    private string editArtistName = "";
    private string editAlbumName = "";
    private string editGenreId = "";
    private int? editYearPublished;
    private bool isSaving = false;

    private bool showArchiveModal = false;
    private Track? trackToArchive = null;
    private bool isArchiving = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTracks();
            StateHasChanged();
        }
    }

    private async Task LoadTracks()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();
        try
        {
            allTracks = await context.Tracks
                .Include(t => t.Genre)
                .Where(t => t.Source == TrackSource.Local)
                .OrderByDescending(t => t.PlayCount)
                .ToListAsync();

            allGenres = await context.Genres
                .OrderBy(g => g.Name)
                .ToListAsync();

            activeTracks = allTracks.Count(t => t.IsActive);
            archivedTracks = allTracks.Count(t => !t.IsActive);
            totalPlays = allTracks.Where(t => t.IsActive).Sum(t => t.PlayCount);

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracks: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleShowArchived()
    {
        showArchived = !showArchived;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = allTracks.AsEnumerable();

        if (!showArchived)
        {
            query = query.Where(t => t.IsActive);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.ToLower();
            query = query.Where(t =>
                t.Title.ToLower().Contains(search) ||
                t.ArtistName.ToLower().Contains(search) ||
                (t.AlbumName?.ToLower().Contains(search) ?? false)
            );
        }

        if (!string.IsNullOrEmpty(genreFilter) && int.TryParse(genreFilter, out int genreId))
        {
            query = query.Where(t => t.GenreId == genreId);
        }

        filteredTracks = query.ToList();

        currentPage = 1;
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling(filteredTracks.Count / (double)pageSize);
        var skip = (currentPage - 1) * pageSize;
        paginatedTracks = filteredTracks.Skip(skip).Take(pageSize).ToList();
        StateHasChanged();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagination();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagination();
        }
    }

    private void OpenEditModal(Track track)
    {
        trackToEdit = track;
        editTitle = track.Title;
        editArtistName = track.ArtistName;
        editAlbumName = track.AlbumName ?? "";
        editGenreId = track.GenreId?.ToString() ?? "";
        editYearPublished = track.YearPublished;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        trackToEdit = null;
    }

    private async Task SaveTrackEdit()
    {
        if (trackToEdit == null) return;

        isSaving = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            // Re-fetch the track from the new context
            var trackToUpdate = await context.Tracks.FindAsync(trackToEdit.Id);

            if (trackToUpdate == null)
            {
                Console.WriteLine($"Track not found: {trackToEdit.Id}");
                return;
            }

            // Update the properties
            trackToUpdate.Title = editTitle;
            trackToUpdate.ArtistName = editArtistName;
            trackToUpdate.AlbumName = string.IsNullOrWhiteSpace(editAlbumName) ? null : editAlbumName;
            trackToUpdate.GenreId = int.TryParse(editGenreId, out int gId) ? gId : null;
            trackToUpdate.YearPublished = editYearPublished;

            await context.SaveChangesAsync();

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserEmail = authState.User.Identity?.Name ?? "Unknown";
            await ActivityLogger.LogAsync(
                "TrackEdit",
                $"Edited track '{trackToUpdate.Title}' by {trackToUpdate.ArtistName}",
                currentUserEmail,
                trackToUpdate.Title,
                $"Genre: {trackToUpdate.Genre?.Name ?? "Unknown"}",
                "Info"
            );

            Console.WriteLine($"[TrackManagement] Edited track: {trackToUpdate.Title}");

            CloseEditModal();
            await LoadTracks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error editing track: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenArchiveModal(Track track)
    {
        trackToArchive = track;
        showArchiveModal = true;
    }

    private void CloseArchiveModal()
    {
        showArchiveModal = false;
        trackToArchive = null;
    }

    private async Task ConfirmArchive()
    {
        if (trackToArchive == null) return;

        isArchiving = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var track = await context.Tracks.FindAsync(trackToArchive.Id);
            if (track == null) return;

            track.IsActive = false;
            track.ArchivedAt = DateTime.UtcNow;
            await context.SaveChangesAsync();

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserEmail = authState.User.Identity?.Name ?? "Unknown";
            await ActivityLogger.LogAsync(
                "TrackArchive",
                $"Archived track '{track.Title}' by {track.ArtistName}",
                currentUserEmail,
                track.Title,
                $"Play Count: {track.PlayCount}",
                "Warning"
            );

            Console.WriteLine($"[TrackManagement] Archived track: {track.Title}");

            activeTracks--;
            archivedTracks++;

            CloseArchiveModal();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error archiving track: {ex.Message}");
        }
        finally
        {
            isArchiving = false;
        }
    }

    private async Task RestoreTrack(Track track)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var trackToRestore = await context.Tracks.FindAsync(track.Id);
            if (trackToRestore == null) return;

            trackToRestore.IsActive = true;
            trackToRestore.ArchivedAt = null;
            await context.SaveChangesAsync();

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserEmail = authState.User.Identity?.Name ?? "Unknown";
            await ActivityLogger.LogAsync(
                "TrackRestore",
                $"Restored track '{trackToRestore.Title}' by {trackToRestore.ArtistName}",
                currentUserEmail,
                trackToRestore.Title,
                "Track made active again",
                "Success"
            );

            Console.WriteLine($"[TrackManagement] Restored track: {trackToRestore.Title}");

            activeTracks++;
            archivedTracks--;

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error restoring track: {ex.Message}");
        }
    }

    private string FormatDuration(int seconds)
    {
        var minutes = seconds / 60;
        var remainingSeconds = seconds % 60;
        return $"{minutes}:{remainingSeconds:D2}";
    }
}