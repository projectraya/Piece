@page "/admin/upload"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using System.ComponentModel.DataAnnotations
@using Piece.Services
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Upload Music - Admin</PageTitle>

<div style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <h2 style="margin-bottom: 30px; color: #FFD335;">🎵 Upload Music to Library</h2>

    <div style="background: #2a2a2a; border-radius: 12px; padding: 30px;">
        <EditForm Model="@uploadModel" OnValidSubmit="HandleUpload">
            <DataAnnotationsValidator />

            <!-- Info Note -->
            <div style="background: rgba(255, 211, 53, 0.1); border: 2px solid rgba(255, 211, 53, 0.3);
                        border-radius: 8px; padding: 15px; margin-bottom: 20px; color: #FFD335;">
                <strong>💡 Note:</strong> Duration will be automatically extracted from the MP3 file.
            </div>

            <!-- File Upload -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Audio File (MP3) *</label>
                <InputFile OnChange="OnFileSelected" accept=".mp3"
                           style="display: block; padding: 10px; background: #1a1a1a;
                                 border: 2px solid #3a3a3a; border-radius: 8px;
                                 color: #fff; width: 100%;" />
                @if (!string.IsNullOrEmpty(selectedFileName))
                {
                    <small style="color: #888; margin-top: 5px; display: block;">Selected: @selectedFileName</small>
                }
            </div>

            <!-- Cover Image Upload -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Cover Image (Optional)</label>
                <InputFile OnChange="OnImageSelected" accept=".jpg,.jpeg,.png"
                           style="display: block; padding: 10px; background: #1a1a1a;
                     border: 2px solid #3a3a3a; border-radius: 8px;
                     color: #fff; width: 100%;" />
                @if (!string.IsNullOrEmpty(selectedImageName))
                {
                    <small style="color: #888; margin-top: 5px; display: block;">Selected: @selectedImageName</small>
                }
            </div>

            <!-- Title -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Title *</label>
                <InputText @bind-Value="uploadModel.Title"
                           style="width: 100%; padding: 12px; background: #1a1a1a;
                                 border: 2px solid #3a3a3a; border-radius: 8px;
                                 color: #fff;" />
                <ValidationMessage For="@(() => uploadModel.Title)" />
            </div>

            <!-- Artist -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Artist *</label>
                <InputText @bind-Value="uploadModel.ArtistName"
                           style="width: 100%; padding: 12px; background: #1a1a1a;
                                 border: 2px solid #3a3a3a; border-radius: 8px;
                                 color: #fff;" />
                <ValidationMessage For="@(() => uploadModel.ArtistName)" />
            </div>

            <!-- Album -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Album (Optional)</label>
                <InputText @bind-Value="uploadModel.AlbumName"
                           style="width: 100%; padding: 12px; background: #1a1a1a;
                                 border: 2px solid #3a3a3a; border-radius: 8px;
                                 color: #fff;" />
            </div>

            <!-- Genre -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Genre *</label>
                <InputSelect @bind-Value="uploadModel.GenreId"
                             style="width: 100%; padding: 12px; background: #1a1a1a;
                                   border: 2px solid #3a3a3a; border-radius: 8px;
                                   color: #fff;">
                    <option value="">Select a genre...</option>
                    @foreach (var genre in genres)
                    {
                        <option value="@genre.Id">@genre.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => uploadModel.GenreId)" />
            </div>

            <!-- Year -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #ccc;">Year Published (Optional)</label>
                <InputNumber @bind-Value="uploadModel.YearPublished"
                             style="width: 100%; padding: 12px; background: #1a1a1a;
                                   border: 2px solid #3a3a3a; border-radius: 8px;
                                   color: #fff;" />
            </div>

            <!-- Upload Status -->
            @if (isUploading)
            {
                <div style="text-align: center; padding: 20px; color: #FFD335;">
                    <div class="spinner" style="margin: 0 auto 10px; width: 40px; height: 40px;
                                               border: 4px solid #3a3a3a; border-top-color: #FFD335;
                                               border-radius: 50%; animation: spin 1s linear infinite;"></div>
                    <p>Uploading and processing...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(uploadMessage))
            {
                <div style="padding: 15px; border-radius: 8px; margin-bottom: 20px;
                           background: @(uploadSuccess ? "#1a4d2e" : "#4d1a1a");
                           color: @(uploadSuccess ? "#4ade80" : "#ff6b6b");">
                    @uploadMessage
                </div>
            }

            <!-- Buttons -->
            <div style="display: flex; gap: 15px;">
                <button type="submit" disabled="@(isUploading || selectedFile == null)"
                        style="flex: 1; padding: 15px; background: #FFD335; border: none;
                              border-radius: 8px; color: #1a1a1a; font-weight: 600;
                              font-size: 16px; cursor: pointer; transition: all 0.3s;">
                    Upload Track
                </button>
                <button type="button" @onclick="Cancel"
                        style="flex: 1; padding: 15px; background: #3a3a3a; border: none;
                              border-radius: 8px; color: #fff; font-weight: 600;
                              font-size: 16px; cursor: pointer; transition: all 0.3s;">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private UploadModel uploadModel = new();
    private List<Genre> genres = new();
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private IBrowserFile? selectedImage;
    private string? selectedImageName;
    private bool isUploading = false;
    private string? uploadMessage;
    private bool uploadSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        genres = await DbContext.Genres.OrderBy(g => g.Name).ToListAsync();
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        selectedImageName = e.File.Name;
        uploadMessage = null;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
        uploadMessage = null;
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
        {
            uploadMessage = "Please select an audio file";
            uploadSuccess = false;
            return;
        }

        // Get current user ID
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            uploadMessage = "✗ Authentication error. Please log in again.";
            uploadSuccess = false;
            return;
        }

        // SECURITY: Check rate limiting
        if (!UploadRateLimiter.CanUpload(userId))
        {
            uploadMessage = "✗ Rate limit exceeded. You can upload up to 50 files per hour. Please try again later.";
            uploadSuccess = false;
            SecurityLogger.LogRateLimitExceeded(userId);
            return;
        }

        // SECURITY: Check for too many failed attempts
        if (UploadRateLimiter.HasTooManyFailedAttempts(userId))
        {
            uploadMessage = "✗ Too many failed upload attempts. Please wait before trying again.";
            uploadSuccess = false;
            return;
        }

        isUploading = true;
        uploadMessage = null;
        StateHasChanged();

        string? filePath = null;
        string? imageFilePath = null;

        try
        {
            // SECURITY: Validate file extension first
            if (!FileValidator.IsValidAudioExtension(selectedFile.Name))
            {
                uploadMessage = "Invalid audio file. Only MP3, WAV, FLAC, and M4A files are allowed.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedFile.Name, false, "Invalid extension");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Validate image extension if provided
            if (selectedImage != null && !FileValidator.IsValidImageExtension(selectedImage.Name))
            {
                uploadMessage = "Invalid image file. Only JPG, PNG, and WEBP files are allowed.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedImage.Name, false, "Invalid image extension");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Check disk space
            var musicPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "music");
            Directory.CreateDirectory(musicPath);

            if (!FileValidator.HasSufficientDiskSpace(musicPath))
            {
                uploadMessage = "✗ Server storage is low. Cannot upload at this time.";
                uploadSuccess = false;
                SecurityLogger.LogSuspiciousActivity(userId, "Low disk space", "Upload blocked");
                isUploading = false;
                StateHasChanged();
                return;
            }

            

            // SECURITY: Sanitize and generate safe filename
            var sanitizedName = FileValidator.SanitizeFileName(selectedFile.Name);
            var fileName = $"{Guid.NewGuid()}_{sanitizedName}";
            filePath = Path.Combine(musicPath, fileName);

            // Save audio file
            using (var stream = new FileStream(filePath, FileMode.Create))
            {
                await selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(stream);
            }

            // SECURITY: Calculate file hash to detect duplicates
            string fileHash = FileValidator.CalculateFileHash(filePath);
            if (string.IsNullOrEmpty(fileHash))
            {
                File.Delete(filePath);
                uploadMessage = "✗ Error processing file. Please try again.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedFile.Name, false, "Hash calculation failed");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Check if this exact file already exists
            var (isDuplicate, existingTitle) = await FileValidator.IsDuplicateFile(DbContext, fileHash);
            if (isDuplicate)
            {
                File.Delete(filePath);
                uploadMessage = $"✗ This audio file already exists in the library as '{existingTitle}'. Duplicate files are not allowed.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, uploadModel.Title, false, $"Duplicate file hash - matches: {existingTitle}");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            Console.WriteLine($"[Upload] File hash: {fileHash}");

            // SECURITY: Validate magic bytes after file is saved
            if (!FileValidator.ValidateAudioFileMagicBytes(filePath))
            {
                File.Delete(filePath);
                uploadMessage = "✗ Invalid or corrupted audio file. File type verification failed.";
                uploadSuccess = false;
                SecurityLogger.LogSuspiciousActivity(userId, "Failed magic bytes check", selectedFile.Name);
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Extract duration (also validates file is playable)
            await Task.Delay(200);
            int durationSeconds = AudioMetadataReader.GetDurationSeconds(filePath);

            if (durationSeconds == 0)
            {
                File.Delete(filePath);
                uploadMessage = "✗ Could not read audio file. File may be corrupted or in an unsupported format.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedFile.Name, false, "Could not extract duration");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            Console.WriteLine($"[Upload] Extracted duration: {durationSeconds}s");

            // Save cover image if provided
            string? coverImagePath = null;
            if (selectedImage != null)
            {
                var imagesPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images");
                Directory.CreateDirectory(imagesPath);

                var sanitizedImageName = FileValidator.SanitizeFileName(selectedImage.Name);
                var imageName = $"{Guid.NewGuid()}_{sanitizedImageName}";
                imageFilePath = Path.Combine(imagesPath, imageName);

                using (var stream = new FileStream(imageFilePath, FileMode.Create))
                {
                    await selectedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);
                }

                // SECURITY: Validate image magic bytes
                if (!FileValidator.ValidateImageFileMagicBytes(imageFilePath))
                {
                    File.Delete(imageFilePath);
                    imageFilePath = null;
                    Console.WriteLine("[Upload] Invalid image file, using default cover");
                }
                else
                {
                    coverImagePath = $"/images/{imageName}";
                }
            }

            // Create Track record
            var track = new Track
                {
                    Title = uploadModel.Title.Trim(),
                    ArtistName = uploadModel.ArtistName.Trim(),
                    AlbumName = uploadModel.AlbumName?.Trim() ?? string.Empty,
                    GenreId = uploadModel.GenreId,
                    YearPublished = uploadModel.YearPublished,
                    DurationSeconds = durationSeconds,
                    Source = TrackSource.Local,
                    LocalFilePath = $"/music/{fileName}",
                    CoverImageUrl = coverImagePath ?? "/images/default-album-cover.png",
                    IsActive = true,
                    FileHash = fileHash,
                    CreatedAt = DateTime.UtcNow
                };

            DbContext.Tracks.Add(track);
            await DbContext.SaveChangesAsync();

            // SECURITY: Log successful upload
            SecurityLogger.LogUploadAttempt(userId, uploadModel.Title, true);
            UploadRateLimiter.RecordUploadAttempt(userId);

            uploadMessage = $"✓ Successfully uploaded '{uploadModel.Title}'! (Duration: {durationSeconds}s)";
            uploadSuccess = true;

            // Reset form
            await Task.Delay(2000);
            uploadModel = new();
            selectedFile = null;
            selectedFileName = null;
            selectedImage = null;
            selectedImageName = null;
            uploadMessage = null;
        }
        catch (Exception ex)
        {
            // SECURITY: Clean up files on error
            if (!string.IsNullOrEmpty(filePath) && File.Exists(filePath))
                File.Delete(filePath);
            if (!string.IsNullOrEmpty(imageFilePath) && File.Exists(imageFilePath))
                File.Delete(imageFilePath);

            uploadMessage = $"✗ Error: {ex.Message}";
            uploadSuccess = false;

            SecurityLogger.LogUploadAttempt(userId ?? "unknown", selectedFile?.Name ?? "unknown", false, ex.Message);
            UploadRateLimiter.RecordUploadAttempt(userId ?? "unknown");

            Console.WriteLine($"[Upload Error] {ex.Message}");
            Console.WriteLine($"[Upload Error] {ex.StackTrace}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    public class UploadModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1, ErrorMessage = "Title must be between 1 and 100 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\s\-_',\.!&\(\)]+$", ErrorMessage = "Title contains invalid characters")]
        public string Title { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 1, ErrorMessage = "Artist name must be between 1 and 100 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\s\-_',\.!&\(\)]+$", ErrorMessage = "Artist name contains invalid characters")]
        public string ArtistName { get; set; } = "";

        [StringLength(100, ErrorMessage = "Album name must be less than 100 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\s\-_',\.!&\(\)]*$", ErrorMessage = "Album name contains invalid characters")]
        public string? AlbumName { get; set; }

        [Required]
        public int? GenreId { get; set; }

        [Range(1900, 2026, ErrorMessage = "Year must be between 1900 and 2026")]
        public int? YearPublished { get; set; }
    }
}