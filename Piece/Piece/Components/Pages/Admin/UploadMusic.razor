@page "/admin/upload"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.RateLimiting
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using System.ComponentModel.DataAnnotations
@using Piece.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityLogger ActivityLogger
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

@inject IInputSanitizer InputSanitizer
@attribute [EnableRateLimiting("uploads")]


<PageTitle>Upload Music - Admin</PageTitle>

<style>
    body {
        background-color: #1a1a1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .upload-page-container {
        min-height: 100vh;
        background: #1a1a1a;
        padding: 40px;
    }

    .upload-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .page-title {
        font-size: 48px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 40px;
    }

    .upload-form-container {
        background: #2a2a2a;
        border-radius: 16px;
        padding: 32px;
    }

    .info-note {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 24px;
        color: #8B5CF6;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
    }

    .form-input,
    .form-select {
        width: 100%;
        padding: 12px 16px;
        background-color: #1a1a1a;
        border: 2px solid #3a3a3a;
        border-radius: 8px;
        color: #ffffff;
        font-size: 14px;
        transition: border-color 0.3s ease;
    }

        .form-input:focus,
        .form-select:focus {
            outline: none;
            border-color: #8B5CF6;
        }

    .file-input {
        width: 100%;
        padding: 12px 16px;
        background-color: #1a1a1a;
        border: 2px solid #3a3a3a;
        border-radius: 8px;
        color: #ffffff;
        font-size: 14px;
        cursor: pointer;
        transition: border-color 0.3s ease;
    }

        .file-input:hover {
            border-color: #8B5CF6;
        }

    .file-selected {
        color: #888;
        margin-top: 8px;
        display: block;
        font-size: 13px;
    }

    .validation-message {
        color: #ff4444;
        font-size: 13px;
        margin-top: 4px;
    }

    .upload-status {
        text-align: center;
        padding: 24px;
        border-radius: 12px;
        margin-bottom: 24px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #3a3a3a;
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 12px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .upload-message {
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 24px;
        font-size: 14px;
    }

        .upload-message.success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #10B981;
        }

        .upload-message.error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
        }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 32px;
    }

    .btn {
        flex: 1;
        padding: 14px 32px;
        border-radius: 24px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid #3a3a3a;
    }

    .btn-primary {
        background: #8B5CF6;
        color: #ffffff;
        border-color: #8B5CF6;
    }

        .btn-primary:hover:not(:disabled) {
            background: #7c3aed;
            transform: scale(1.05);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            background: #7c3aed;
        }

    .btn-secondary {
        background: none;
        color: #ffffff;
        border-color: #3a3a3a;
    }

        .btn-secondary:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
        }

    /* Toast Notification */
    .notification-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #2a2a2a;
        color: white;
        padding: 16px 24px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 10000;
        animation: slideInRight 0.3s ease;
        max-width: 400px;
        border-left: 4px solid #10B981;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(400px);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .toast-icon {
        font-size: 24px;
        font-weight: 700;
        color: #10B981;
    }

    .toast-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .toast-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
    }

    .toast-message {
        font-size: 14px;
        color: #aaa;
    }

    .toast-close {
        background: transparent;
        border: none;
        color: #888;
        font-size: 24px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: all 0.2s;
        line-height: 1;
    }

        .toast-close:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }
</style>

@if (confirmation)
{
    <div class="notification-toast">
        <div class="toast-icon">✓</div>
        <div class="toast-content">
            <div class="toast-title">Upload Successful!</div>
            <div class="toast-message">Your track has been uploaded successfully.</div>
        </div>
        <button class="toast-close" @onclick="ConfirmClose">×</button>
    </div>
}

<div class="upload-page-container">
    <div class="upload-content">
        <h1 class="page-title">Upload Music</h1>

        <div class="upload-form-container">
            <EditForm Model="@uploadModel" OnValidSubmit="HandleUpload">
                <DataAnnotationsValidator />

                <!-- Info Note -->
                <div class="info-note">
                    <strong>Note:</strong> Duration will be automatically extracted from the MP3 file.
                </div>

                <!-- File Upload -->
                <div class="form-group">
                    <label class="form-label">Audio File (MP3) *</label>
                    <InputFile OnChange="OnFileSelected" accept=".mp3" class="file-input" />
                    @if (!string.IsNullOrEmpty(selectedFileName))
                    {
                        <small class="file-selected">Selected: @selectedFileName</small>
                    }
                </div>

                <!-- Cover Image Upload -->
                <div class="form-group">
                    <label class="form-label">Cover Image (Optional)</label>
                    <InputFile OnChange="OnImageSelected" accept=".jpg,.jpeg,.png" class="file-input" />
                    @if (!string.IsNullOrEmpty(selectedImageName))
                    {
                        <small class="file-selected">Selected: @selectedImageName</small>
                    }
                </div>

                <!-- Title -->
                <div class="form-group">
                    <label class="form-label">Title *</label>
                    <InputText @bind-Value="uploadModel.Title" class="form-input" />
                    <ValidationMessage For="@(() => uploadModel.Title)" class="validation-message" />
                </div>

                <!-- Artist -->
                <div class="form-group">
                    <label class="form-label">Artist *</label>
                    <InputText @bind-Value="uploadModel.ArtistName" class="form-input" />
                    <ValidationMessage For="@(() => uploadModel.ArtistName)" class="validation-message" />
                </div>

                <!-- Album -->
                <div class="form-group">
                    <label class="form-label">Album (Optional)</label>
                    <InputText @bind-Value="uploadModel.AlbumName" class="form-input" />
                </div>

                <!-- Genre -->
                <div class="form-group">
                    <label class="form-label">Genre *</label>
                    <InputSelect @bind-Value="uploadModel.GenreId" class="form-select">
                        <option value="">Select a genre...</option>
                        @foreach (var genre in genres)
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => uploadModel.GenreId)" class="validation-message" />
                </div>

                <!-- Year -->
                <div class="form-group">
                    <label class="form-label">Year Published (Optional)</label>
                    <InputNumber @bind-Value="uploadModel.YearPublished" class="form-input" />
                </div>

                <!-- Upload Status -->
                @if (isUploading)
                {
                    <div class="upload-status">
                        <div class="spinner"></div>
                        <p style="color: #8B5CF6; margin: 0;">Uploading and processing...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(uploadMessage))
                {
                    <div class="upload-message @(uploadSuccess ? "success" : "error")">
                        @uploadMessage
                    </div>
                }

                <!-- Buttons -->
                <div class="form-actions">
                    <button type="submit" disabled="@(isUploading || selectedFile == null)" class="btn btn-primary">
                        Upload Track
                    </button>
                    <button type="button" @onclick="Cancel" class="btn btn-secondary">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private UploadModel uploadModel = new();
    private List<Genre> genres = new();
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private IBrowserFile? selectedImage;
    private string? selectedImageName;
    private bool isUploading = false;
    private string? uploadMessage;
    private bool uploadSuccess = false;

    private bool confirmation = false;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        genres = await context.Genres.OrderBy(g => g.Name).ToListAsync();
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        selectedImageName = e.File.Name;
        uploadMessage = null;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
        uploadMessage = null;
    }

    private async Task HandleUpload()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        if (selectedFile == null)
        {
            uploadMessage = "Please select an audio file";
            uploadSuccess = false;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            uploadMessage = "✗ Authentication error. Please log in again.";
            uploadSuccess = false;
            return;
        }

        // SECURITY: Check rate limiting
        if (!UploadRateLimiter.CanUpload(userId))
        {
            uploadMessage = "✗ Rate limit exceeded. You can upload up to 50 files per hour. Please try again later.";
            uploadSuccess = false;
            SecurityLogger.LogRateLimitExceeded(userId);
            return;
        }

        // SECURITY: Check for too many failed attempts
        if (UploadRateLimiter.HasTooManyFailedAttempts(userId))
        {
            uploadMessage = "✗ Too many failed upload attempts. Please wait before trying again.";
            uploadSuccess = false;
            return;
        }

        isUploading = true;
        uploadMessage = null;
        StateHasChanged();

        string? filePath = null;
        string? imageFilePath = null;

        try
        {
            // SECURITY: Validate file extension first
            if (!FileValidator.IsValidAudioExtension(selectedFile.Name))
            {
                uploadMessage = "Invalid audio file. Only MP3, WAV, FLAC, and M4A files are allowed.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedFile.Name, false, "Invalid extension");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Validate image extension if provided
            if (selectedImage != null && !FileValidator.IsValidImageExtension(selectedImage.Name))
            {
                uploadMessage = "Invalid image file. Only JPG, PNG, and WEBP files are allowed.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedImage.Name, false, "Invalid image extension");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Check disk space
            var musicPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "music");
            Directory.CreateDirectory(musicPath);

            if (!FileValidator.HasSufficientDiskSpace(musicPath))
            {
                uploadMessage = "✗ Server storage is low. Cannot upload at this time.";
                uploadSuccess = false;
                SecurityLogger.LogSuspiciousActivity(userId, "Low disk space", "Upload blocked");
                isUploading = false;
                StateHasChanged();
                return;
            }



            // SECURITY: Sanitize and generate safe filename
            var sanitizedName = FileValidator.SanitizeFileName(selectedFile.Name);
            var fileName = $"{Guid.NewGuid()}_{sanitizedName}";
            filePath = Path.Combine(musicPath, fileName);

            // Save audio file
            using (var stream = new FileStream(filePath, FileMode.Create))
            {
                await selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(stream);
            }

            // SECURITY: Calculate file hash to detect duplicates
            string fileHash = FileValidator.CalculateFileHash(filePath);
            if (string.IsNullOrEmpty(fileHash))
            {
                File.Delete(filePath);
                uploadMessage = "✗ Error processing file. Please try again.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedFile.Name, false, "Hash calculation failed");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Check if this exact file already exists
            var (isDuplicate, existingTitle) = await FileValidator.IsDuplicateFile(context, fileHash);
            if (isDuplicate)
            {
                File.Delete(filePath);
                uploadMessage = $"✗ This audio file already exists in the library as '{existingTitle}'. Duplicate files are not allowed.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, uploadModel.Title, false, $"Duplicate file hash - matches: {existingTitle}");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            Console.WriteLine($"[Upload] File hash: {fileHash}");

            // SECURITY: Validate magic bytes after file is saved
            if (!FileValidator.ValidateAudioFileMagicBytes(filePath))
            {
                File.Delete(filePath);
                uploadMessage = "✗ Invalid or corrupted audio file. File type verification failed.";
                uploadSuccess = false;
                SecurityLogger.LogSuspiciousActivity(userId, "Failed magic bytes check", selectedFile.Name);
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            // SECURITY: Extract duration (also validates file is playable)
            await Task.Delay(200);
            int durationSeconds = AudioMetadataReader.GetDurationSeconds(filePath);

            if (durationSeconds == 0)
            {
                File.Delete(filePath);
                uploadMessage = "✗ Could not read audio file. File may be corrupted or in an unsupported format.";
                uploadSuccess = false;
                SecurityLogger.LogUploadAttempt(userId, selectedFile.Name, false, "Could not extract duration");
                UploadRateLimiter.RecordUploadAttempt(userId);
                isUploading = false;
                StateHasChanged();
                return;
            }

            Console.WriteLine($"[Upload] Extracted duration: {durationSeconds}s");

            // Save cover image if provided
            string? coverImagePath = null;
            if (selectedImage != null)
            {
                var imagesPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images");
                Directory.CreateDirectory(imagesPath);

                var sanitizedImageName = FileValidator.SanitizeFileName(selectedImage.Name);
                var imageName = $"{Guid.NewGuid()}_{sanitizedImageName}";
                imageFilePath = Path.Combine(imagesPath, imageName);

                using (var stream = new FileStream(imageFilePath, FileMode.Create))
                {
                    await selectedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);
                }

                // SECURITY: Validate image magic bytes
                if (!FileValidator.ValidateImageFileMagicBytes(imageFilePath))
                {
                    File.Delete(imageFilePath);
                    imageFilePath = null;
                    Console.WriteLine("[Upload] Invalid image file, using default cover");
                }
                else
                {
                    coverImagePath = $"/images/{imageName}";
                }
            }

            var track = new Track
                {
                    Title = InputSanitizer.SanitizeString(uploadModel.Title.Trim(), 200),
                    ArtistName = InputSanitizer.SanitizeString(uploadModel.ArtistName.Trim(), 200),
                    AlbumName = string.IsNullOrWhiteSpace(uploadModel.AlbumName?.Trim())
                                    ? null
                                        : InputSanitizer.SanitizeString(uploadModel.AlbumName?.Trim(), 200),
                    GenreId = uploadModel.GenreId,
                    YearPublished = uploadModel.YearPublished,
                    DurationSeconds = durationSeconds,
                    Source = TrackSource.Local,
                    LocalFilePath = $"/music/{fileName}",
                    CoverImageUrl = coverImagePath ?? "/images/default-album-cover.png",
                    IsActive = true,
                    FileHash = fileHash,
                    CreatedAt = DateTime.UtcNow
                };

            context.Tracks.Add(track);
            await context.SaveChangesAsync();

            var currentUserEmail = authState.User.Identity?.Name ?? "Unknown";
            await ActivityLogger.LogAsync(
                "TrackUpload",
                $"Uploaded track '{uploadModel.Title}' by {uploadModel.ArtistName}",
                currentUserEmail,
                uploadModel.Title,
                $"Genre: {genres.FirstOrDefault(g => g.Id == uploadModel.GenreId)?.Name ?? "Unknown"}, Duration: {durationSeconds}s",
                "Success"
            );

            uploadMessage = $"✓ Successfully uploaded '{uploadModel.Title}'! (Duration: {durationSeconds}s)";
            uploadSuccess = true;

            if (uploadSuccess)
            {
                ShowSuccesfullUploadModal();
            }

            await Task.Delay(2000);
            uploadModel = new();
            selectedFile = null;
            selectedFileName = null;
            selectedImage = null;
            selectedImageName = null;
            uploadMessage = null;
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrEmpty(filePath) && File.Exists(filePath))
                File.Delete(filePath);
            if (!string.IsNullOrEmpty(imageFilePath) && File.Exists(imageFilePath))
                File.Delete(imageFilePath);

            uploadMessage = $"✗ Error: {ex.Message}";
            uploadSuccess = false;

            SecurityLogger.LogUploadAttempt(userId ?? "unknown", selectedFile?.Name ?? "unknown", false, ex.Message);
            UploadRateLimiter.RecordUploadAttempt(userId ?? "unknown");

            Console.WriteLine($"[Upload Error] {ex.Message}");
            Console.WriteLine($"[Upload Error] {ex.StackTrace}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/dashboard");
    }

    private void ShowSuccesfullUploadModal()
    {
        confirmation = true;
    }

    private void ConfirmClose()
    {
        confirmation = false;
    }

    public class UploadModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1, ErrorMessage = "Title must be between 1 and 100 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\s\-_',\.!&\(\)]+$", ErrorMessage = "Title contains invalid characters")]
        public string Title { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 1, ErrorMessage = "Artist name must be between 1 and 100 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\s\-_',\.!&\(\)]+$", ErrorMessage = "Artist name contains invalid characters")]
        public string ArtistName { get; set; } = "";

        [StringLength(100, ErrorMessage = "Album name must be less than 100 characters")]
        [RegularExpression(@"^[a-zA-Z0-9\s\-_',\.!&\(\)]*$", ErrorMessage = "Album name contains invalid characters")]
        public string? AlbumName { get; set; }

        [Required]
        public int? GenreId { get; set; }

        [Range(1900, 2026, ErrorMessage = "Year must be between 1900 and 2026")]
        public int? YearPublished { get; set; }
    }
}