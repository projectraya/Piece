@page "/visualizer"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject PlayerService PlayerService
@implements IDisposable
@inject NavigationManager Navigation
@using Piece.Services

<PageTitle>Visualizer - Piece</PageTitle>

<div class="visualizer-container">
    @if (PlayerService.CurrentTrack != null)
    {
        @if (currentMode == "sphere")
        {
            <!-- 3D Sphere canvas -->
            <canvas id="threeSphereCanvas"></canvas>
        }
        else
        {
            <!-- Full-screen canvas for 2D modes -->
            <canvas id="fullVisualizer" @ref="canvasRef"></canvas>
        }

        <!-- Overlay with track info and controls - ALWAYS VISIBLE -->
        <div class="visualizer-overlay">
            <div class="track-info">
                <h1>@PlayerService.CurrentTrack.Title</h1>
                <p>@PlayerService.CurrentTrack.ArtistName</p>

                <!-- Mode selector -->
                <div class="mode-selector" style="margin-top: 30px;">
                    <button class="mode-btn @(currentMode == "liquidbars" ? "active" : "")"
                            @onclick='() => SwitchMode("liquidbars")'>
                        Liquid Bars
                    </button>
                    <button class="mode-btn @(currentMode == "circle" ? "active" : "")"
                            @onclick='() => SwitchMode("circle")'>
                        Circle
                    </button>
                    <button class="mode-btn @(currentMode == "waveform" ? "active" : "")"
                            @onclick='() => SwitchMode("waveform")'>
                        Wave
                    </button>
                    <button class="mode-btn @(currentMode == "particles" ? "active" : "")"
                            @onclick='() => SwitchMode("particles")'>
                        Particles
                    </button>
                    <button class="mode-btn @(currentMode == "dna" ? "active" : "")"
                            @onclick='() => SwitchMode("dna")'>
                        DNA
                    </button>
                    <button class="mode-btn @(currentMode == "sphere" ? "active" : "")"
                            @onclick='() => SwitchMode("sphere")'>
                        3D Sphere
                    </button>
                </div>
            </div>

            <!-- Top right controls -->
            <div class="top-controls">
                <button class="control-btn" @onclick="GoBack">
                    <span>← Back</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="no-track">
            <h2>🎵</h2>
            <p>Play a song to see the visualizer</p>

            <!-- Back button -->
            <button class="control-btn" @onclick="GoBack" style="margin-top: 30px;">
                <span>← Back</span>
            </button>
        </div>
    }
</div>

<style>
    .top-controls {
        position: absolute;
        top: 20px;
        right: 20px;
        display: flex;
        gap: 15px;
        pointer-events: auto;
    }
    .control-btn {
        padding: 12px 24px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 25px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all 0.3s;
    }

        .control-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.6);
            transform: scale(1.05);
        }
    .visualizer-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #000;
        overflow: hidden;
    }

    #fullVisualizer {
        width: 100%;
        height: 100%;
    }

    .visualizer-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px;
    }

    .track-info {
        text-align: center;
        color: white;
        text-shadow: 0 0 20px rgba(0,0,0,0.8);
    }

    .track-info h1 {
        font-size: 48px;
        margin: 0;
        font-weight: 700;
    }

    .track-info p {
        font-size: 24px;
        margin: 10px 0 0 0;
        opacity: 0.8;
    }

    .mode-selector {
        display: flex;
        gap: 15px;
        justify-content: center;
        pointer-events: auto;
    }

    .mode-btn {
        padding: 12px 30px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 25px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all 0.3s;
    }

    .mode-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.6);
    }

    .mode-btn.active {
        background: rgba(255, 215, 0, 0.3);
        border-color: #FFD700;
    }

    .no-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        color: white;
    }

    .no-track h2 {
        font-size: 120px;
        margin: 0;
    }

    .no-track p {
        font-size: 24px;
        opacity: 0.6;
    }

    #threeSphereCanvas {
        width: 100%;
        height: 100%;
        display: block;
    }
</style>

@code {
    private ElementReference canvasRef;
    private string currentMode = "bars";
    private bool isFullscreen = false;

    protected override void OnInitialized()
    {
        PlayerService.OnChange += StateHasChanged;
        PlayerService.OnTrackChanged += OnTrackChanged;
    }

    private void OnTrackChanged()
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine($"[Visualizer] First render - CurrentTrack: {PlayerService.CurrentTrack?.Title}");

            if (PlayerService.CurrentTrack != null)
            {
                await Task.Delay(500);

                await JSRuntime.InvokeVoidAsync("visualizerManager.registerFullCanvas", "fullVisualizer");

                await JSRuntime.InvokeVoidAsync("visualizerManager.setDrawFull", true);
                await JSRuntime.InvokeVoidAsync("visualizerManager.setDrawMini", false);

                await JSRuntime.InvokeVoidAsync("visualizerManager.setMode", currentMode);

                Console.WriteLine("[Full Visualizer] Registered with manager");
            }
        }
    }

    private async Task SwitchMode(string mode)
    {
        currentMode = mode;

        if (mode == "sphere")
        {
            await Task.Delay(100); 
            await JSRuntime.InvokeVoidAsync("visualizerManager.initThreeSphere", "threeSphereCanvas");
        }
        else
        {
            // Regular 2D modes
            await JSRuntime.InvokeVoidAsync("visualizerManager.setMode", mode);
        }
    }

    private void ToggleFullscreen()
    {
        isFullscreen = !isFullscreen;
        StateHasChanged();
    }

    private void GoBack()
    {
        _ = JSRuntime.InvokeVoidAsync("visualizerManager.setDrawFull", false);
        _ = JSRuntime.InvokeVoidAsync("visualizerManager.setDrawMini", true);

        Navigation.NavigateTo("/player");
    }

    public void Dispose()
    {
        PlayerService.OnChange -= StateHasChanged;
        PlayerService.OnTrackChanged -= OnTrackChanged;
    }
}