@page "/visualizer"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject PlayerService PlayerService
@implements IDisposable
@using Piece.Services

<PageTitle>Visualizer - Piece</PageTitle>

<div class="visualizer-container">
    @if (PlayerService.CurrentTrack != null)
    {
        <!-- Full-screen canvas -->
        <canvas id="fullVisualizer" @ref="canvasRef"></canvas>

        <!-- Overlay info -->
        <div class="visualizer-overlay">
            <div class="track-info">
                <h1>@PlayerService.CurrentTrack.Title</h1>
                <p>@PlayerService.CurrentTrack.ArtistName</p>

                <!-- Move mode selector here, right under track info -->
                <div class="mode-selector" style="margin-top: 30px;">
                    <button class="mode-btn @(currentMode == "bars" ? "active" : "")"
                            @onclick='() => SwitchMode("bars")'>
                        Bars
                    </button>
                    <button class="mode-btn @(currentMode == "circle" ? "active" : "")"
                            @onclick='() => SwitchMode("circle")'>
                        Circle
                    </button>
                    <button class="mode-btn @(currentMode == "waveform" ? "active" : "")"
                            @onclick='() => SwitchMode("waveform")'>
                        Wave
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="no-track">
            <h2>🎵</h2>
            <p>Play a song to see the visualizer</p>
        </div>
    }
</div>

<style>
    .visualizer-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #000;
        overflow: hidden;
    }

    #fullVisualizer {
        width: 100%;
        height: 100%;
    }

    .visualizer-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px;
    }

    .track-info {
        text-align: center;
        color: white;
        text-shadow: 0 0 20px rgba(0,0,0,0.8);
    }

    .track-info h1 {
        font-size: 48px;
        margin: 0;
        font-weight: 700;
    }

    .track-info p {
        font-size: 24px;
        margin: 10px 0 0 0;
        opacity: 0.8;
    }

    .mode-selector {
        display: flex;
        gap: 15px;
        justify-content: center;
        pointer-events: auto;
    }

    .mode-btn {
        padding: 12px 30px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 25px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all 0.3s;
    }

    .mode-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.6);
    }

    .mode-btn.active {
        background: rgba(255, 215, 0, 0.3);
        border-color: #FFD700;
    }

    .no-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        color: white;
    }

    .no-track h2 {
        font-size: 120px;
        margin: 0;
    }

    .no-track p {
        font-size: 24px;
        opacity: 0.6;
    }
</style>

@code {
    private ElementReference canvasRef;
    private string currentMode = "bars";

    protected override void OnInitialized()
    {
        PlayerService.OnChange += StateHasChanged;
        PlayerService.OnTrackChanged += OnTrackChanged;
    }

    private void OnTrackChanged()
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine($"[Visualizer] First render - CurrentTrack: {PlayerService.CurrentTrack?.Title}");

            if (PlayerService.CurrentTrack != null)
            {
                await Task.Delay(1000); // Give it more time
                await InitializeVisualizer();
            }
        }
    }

    private async Task InitializeVisualizer()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("initFullVisualizer", "fullVisualizer", "globalAudioPlayer", currentMode);
            Console.WriteLine("[Full Visualizer] Initialized");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Full Visualizer] Error: {ex.Message}");
        }
    }

    private async Task SwitchMode(string mode)
    {
        currentMode = mode;
        Console.WriteLine($"[Visualizer] Switching to mode: {mode}");

        try
        {
            await JSRuntime.InvokeVoidAsync("switchVisualizerMode", mode);
            Console.WriteLine($"[Visualizer] Mode switched successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Visualizer] Error switching mode: {ex.Message}");
        }
    }

    public void Dispose()
    {
        PlayerService.OnChange -= StateHasChanged;
        PlayerService.OnTrackChanged -= OnTrackChanged;
    }
}