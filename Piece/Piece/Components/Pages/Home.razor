@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using Piece.Services
@using Piece.DTOs
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject LanguageService Lang
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>@pageTitle</PageTitle>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* ============================================
           SHARED
        ============================================ */
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes mapPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.3);
            opacity: 0.8;
        }
    }

    @@keyframes mapRing {
        0% {
            transform: scale(1);
            opacity: 0.4;
        }

        100% {
            transform: scale(2.5);
            opacity: 0;
        }
    }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background: #0f0f0f;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(255,255,255,0.1);
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: 20px;
    }

    .loading-text {
        color: rgba(255,255,255,0.5);
        font-size: 14px;
        font-weight: 500;
    }

    /* ============================================
           LOGGED-IN DASHBOARD
        ============================================ */
    .dashboard-container {
        min-height: 100vh;
        background: #0f0f0f;
        color: #ffffff;
        padding: 50px 70px 120px 70px;
        margin: -1.5rem -1.5rem -1.5rem -1.5rem;
        width: calc(100% + 3rem);
    }

    .hero-section {
        margin-bottom: 48px;
        background: linear-gradient(135deg, #1a1a1a 0%, #1f1f1f 100%);
        border-radius: 24px;
        padding: 56px 60px;
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(138,92,246,0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .welcome-label {
        font-size: 13px;
        font-weight: 700;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .welcome-title {
        font-size: 52px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 8px;
    }

    .welcome-subtitle {
        font-size: 16px;
        color: rgba(255,255,255,0.45);
        margin-bottom: 36px;
    }

    .section-title {
        font-size: 26px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.5px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 24px 16px 100px;
        }

        .hero-section {
            padding: 36px 24px;
        }

        .welcome-title {
            font-size: 34px;
        }
    }

    /* ============================================
           LANDING PAGE
        ============================================ */
    .landing-page {
        min-height: 100vh;
        background: #0f0f0f;
        color: #ffffff;
        overflow-x: hidden;
        margin: -1.5rem -1.5rem -1.5rem -2rem;
        width: calc(100% + 3.5rem);
    }

    .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15,15,15,0.95);
        backdrop-filter: blur(10px);
        padding: 20px 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .logo img {
        height: 40px;
        width: auto;
        object-fit: contain;
    }

    .auth-buttons {
        display: flex;
        gap: 15px;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        border: none;
        display: inline-block;
    }

    .btn-login {
        background: transparent;
        color: #ffffff;
        border: 2px solid rgba(255,255,255,0.2);
    }

        .btn-login:hover {
            border-color: #8B5CF6;
            color: #8B5CF6;
        }

    .btn-signup {
        background: linear-gradient(135deg, #8B5CF6, #7C3AED);
        color: #ffffff;
    }

        .btn-signup:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(139,92,246,0.4);
        }

    .hero {
        padding: 100px 60px;
        text-align: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 72px;
        font-weight: 900;
        margin-bottom: 20px;
        letter-spacing: -2px;
        line-height: 1.1;
        color: #ffffff;
    }

        .hero-title .highlight {
            background: linear-gradient(135deg, #8B5CF6, #A78BFA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-subtitle {
        font-size: 24px;
        color: rgba(255,255,255,0.6);
        margin-bottom: 50px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        max-width: 900px;
        margin: 0 auto 60px;
    }

    .stat-box {
        padding: 30px 20px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 15px;
        backdrop-filter: blur(10px);
        transition: all 0.3s;
    }

        .stat-box:hover {
            background: rgba(139,92,246,0.1);
            border-color: rgba(139,92,246,0.3);
            transform: translateY(-4px);
        }

    .landing-stat-number {
        font-size: 48px;
        font-weight: 900;
        background: linear-gradient(135deg, #8B5CF6, #A78BFA);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 8px;
    }

    .landing-stat-label {
        font-size: 14px;
        color: rgba(255,255,255,0.6);
        font-weight: 500;
    }

    .section {
        padding: 60px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .landing-section-title {
        font-size: 36px;
        font-weight: 800;
        color: #ffffff;
    }

    .tracks-scroll {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding-bottom: 20px;
        scrollbar-width: thin;
        scrollbar-color: #8B5CF6 rgba(255,255,255,0.1);
    }

        .tracks-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .tracks-scroll::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
        }

        .tracks-scroll::-webkit-scrollbar-thumb {
            background: #8B5CF6;
            border-radius: 10px;
        }

    .track-card {
        min-width: 280px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }

        .track-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #8B5CF6, #7C3AED);
            transform: scaleX(0);
            transition: transform 0.3s;
        }

        .track-card:hover::before {
            transform: scaleX(1);
        }

        .track-card:hover {
            transform: translateY(-5px);
            border-color: rgba(139,92,246,0.4);
            box-shadow: 0 15px 40px rgba(139,92,246,0.25);
        }

    .track-rank {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #8B5CF6, #7C3AED);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 18px;
    }

    .track-art {
        width: 100%;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #1f1f1f, #2a2a2a);
        border-radius: 8px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        overflow: hidden;
    }

        .track-art img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .track-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-artist {
        font-size: 14px;
        color: rgba(255,255,255,0.6);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-bottom: 8px;
    }

    .track-plays {
        font-size: 12px;
        color: rgba(255,255,255,0.4);
    }

    .genres-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }

    .genre-card {
        aspect-ratio: 1;
        border-radius: 15px;
        padding: 25px;
        display: flex;
        align-items: flex-end;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
    }

        .genre-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.3);
            transition: opacity 0.3s;
        }

        .genre-card:hover::before {
            opacity: 0;
        }

        .genre-card:hover {
            transform: scale(1.05);
            border-color: rgba(139,92,246,0.4);
        }

    .genre-content {
        position: relative;
        z-index: 1;
    }

    .genre-name {
        font-size: 24px;
        font-weight: 800;
        color: #fff;
        margin-bottom: 5px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .genre-count {
        font-size: 14px;
        color: rgba(255,255,255,0.9);
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .cta-section {
        padding: 100px 60px;
        text-align: center;
        background: linear-gradient(135deg, #8B5CF6, #7C3AED);
        color: #ffffff;
    }

    .cta-title {
        font-size: 48px;
        font-weight: 900;
        margin-bottom: 15px;
    }

    .cta-subtitle {
        font-size: 20px;
        margin-bottom: 35px;
        opacity: 0.9;
    }

    .btn-cta {
        font-size: 18px;
        padding: 16px 40px;
        background: #ffffff;
        color: #8B5CF6;
        font-weight: 700;
    }

        .btn-cta:hover {
            background: #f3f4f6;
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }
</style>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p class="loading-text">@loadingMessage</p>
    </div>
}
else if (isLoggedIn)
{
    <div class="dashboard-container">

        <div class="hero-section">
            <div class="hero-content">
                <div class="welcome-label">@Lang.T("Welcome Back")</div>
                <h1 class="welcome-title">@userName</h1>
                <p class="welcome-subtitle">@Lang.T("Where do you want to start?")</p>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;" id="modeGrid">
                    @{
                        var modes = new[] {
                ("/player",       Lang.T("Browse Music"),    Lang.T("Dive into the full library"),   "#8B5CF6", "♪"),
                ("/visualizer",   Lang.T("Visualizer"),      Lang.T("See your music come alive"),    "#10B981", "◉"),
                ("/playlists",    Lang.T("Your Playlists"),  Lang.T("Your curated collections"),     "#F59E0B", "☰"),
                ("/liked-songs",   Lang.T("Liked Songs"),     Lang.T("Your saved favourites"),        "#EC4899", "♥"),
                ("/account/manage/statistics", Lang.T("Listening Stats"), Lang.T("Your musical journey"), "#06B6D4", "◈"),
                ("/admin/upload",  Lang.T("Upload Music"),    Lang.T("Add to the library"),           "#EF4444", "↑")
                };
                    }
                    @for (int i = 0; i < modes.Length; i++)
                    {
                        var m = modes[i];
                        var idx = i;
                        <div id="modeCard@(idx)"
                             onclick="selectMode(@idx, '@m.Item1')"
                             style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 20px 16px; cursor: pointer; transition: all 0.25s; position: relative; overflow: hidden;"
                             onmouseover="hoverCard(@idx, true)"
                             onmouseout="hoverCard(@idx, false)">
                            <div style="font-size: 26px; margin-bottom: 8px;">@m.Item5</div>
                            <div style="font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 3px;">@m.Item2</div>
                            <div style="font-size: 12px; color: rgba(255,255,255,0.35);">@m.Item3</div>
                        </div>
                    }
                </div>

                <button onclick="pickRandom()"
                        style="background: linear-gradient(135deg, #8B5CF6, #7C3AED); border: none; border-radius: 12px; padding: 13px 36px; font-size: 14px; font-weight: 700; color: #fff; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 20px rgba(139,92,246,0.3);"
                        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 28px rgba(139,92,246,0.5)'"
                        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 20px rgba(139,92,246,0.3)'">
                    ✦ @Lang.T("Surprise Me")
                </button>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px;">
            @{
                var statItems = new[] {
        ("▶", userStats.TotalPlays.ToString(),          Lang.T("Total Plays"),       "#8B5CF6", "139,92,246"),
        ("♫", userStats.UniqueTracksPlayed.ToString(),  Lang.T("Unique Tracks"),     "#10B981", "16,185,129"),
        ("⏱", userStats.TotalMinutes.ToString(),        Lang.T("Minutes Listened"),  "#F59E0B", "245,158,11"),
        ("☰", userStats.PlaylistCount.ToString(),       Lang.T("Playlists"),         "#EC4899", "236,72,153")
        };
            }
            @foreach (var s in statItems)
            {
                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 28px 24px; position: relative; overflow: hidden; transition: all 0.3s;"
                     onmouseover="this.style.transform='translateY(-4px)'; this.style.borderColor='rgba(@(s.Item5),0.35)'"
                     onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='rgba(255,255,255,0.08)'">
                    <div style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background: @s.Item4; border-radius: 16px 16px 0 0;"></div>
                    <div style="font-size: 26px; margin-bottom: 10px;">@s.Item1</div>
                    <div style="font-size: 38px; font-weight: 800; color: #fff; letter-spacing: -1px; margin-bottom: 6px;">@s.Item2</div>
                    <div style="font-size: 12px; color: rgba(255,255,255,0.4); font-weight: 500;">@s.Item3</div>
                </div>
            }
        </div>

        <div style="display: grid; grid-template-columns: 1fr 320px; gap: 24px; margin-bottom: 48px; align-items: start;">

            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h2 class="section-title">@Lang.T("Recently Played")</h2>
                    <a href="/account/manage/statistics"
                       style="font-size: 13px; color: #8B5CF6; text-decoration: none; font-weight: 600; transition: all 0.3s;"
                       onmouseover="this.style.color='#A78BFA'; this.style.transform='translateX(4px)'"
                       onmouseout="this.style.color='#8B5CF6'; this.style.transform='translateX(0)'">
                        @Lang.T("View All") →
                    </a>
                </div>

                @if (recentTracks.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var track in recentTracks.Take(7))
                        {
                            var tid = track.TrackId;
                            <div style="display: flex; align-items: center; gap: 14px; padding: 11px 14px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; cursor: pointer; transition: all 0.25s;"
                                 onclick="playTrack(@tid)"
                                 onmouseover="this.style.background='rgba(139,92,246,0.08)'; this.style.borderColor='rgba(139,92,246,0.25)'; this.style.transform='translateX(4px)'"
                                 onmouseout="this.style.background='rgba(255,255,255,0.02)'; this.style.borderColor='rgba(255,255,255,0.06)'; this.style.transform='translateX(0)'">
                                <div style="width: 46px; height: 46px; border-radius: 8px; overflow: hidden; flex-shrink: 0; background: linear-gradient(135deg,#1f1f1f,#2a2a2a);">
                                    <img src="@(string.IsNullOrEmpty(track.AlbumArt) ? "/images/default-album-cover.png" : track.AlbumArt)"
                                         alt="@track.Title"
                                         style="width:100%;height:100%;object-fit:cover;" />
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:14px;font-weight:600;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:3px;">@track.Title</div>
                                    <div style="font-size:12px;color:rgba(255,255,255,0.4);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@track.ArtistName</div>
                                </div>
                                <div style="font-size:12px;color:rgba(255,255,255,0.25);flex-shrink:0;margin-right:8px;">@track.PlayedAt</div>
                                <div style="width:30px;height:30px;border-radius:50%;background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.3);display:flex;align-items:center;justify-content:center;font-size:11px;color:#8B5CF6;flex-shrink:0;">▶</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align:center;padding:60px 20px;background:rgba(255,255,255,0.02);border-radius:16px;border:1px dashed rgba(255,255,255,0.08);">
                        <div style="font-size:44px;margin-bottom:14px;opacity:0.25;">♫</div>
                        <div style="font-size:17px;font-weight:600;color:rgba(255,255,255,0.35);margin-bottom:8px;">@Lang.T("No listening history yet")</div>
                        <p style="font-size:13px;color:rgba(255,255,255,0.2);margin-bottom:22px;">@Lang.T("Start playing music to build your personal history")</p>
                        <button onclick="window.location.href='/player'"
                                style="background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.3);border-radius:8px;padding:11px 28px;color:#8B5CF6;font-size:13px;font-weight:600;cursor:pointer;">
                            @Lang.T("Browse Music")
                        </button>
                    </div>
                }
            </div>

            <div style="display:flex;flex-direction:column;gap:16px;">

                @if (userStats.TopGenre != null)
                {
                    <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:22px;position:relative;overflow:hidden;">
                        <div style="position:absolute;top:-40px;right:-40px;width:120px;height:120px;border-radius:50%;background:@userStats.TopGenreColor;opacity:0.1;filter:blur(20px);pointer-events:none;"></div>
                        <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.35);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:12px;">@Lang.T("Your Top Genre")</div>
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
                            <div style="width:36px;height:36px;border-radius:8px;background:@userStats.TopGenreColor;flex-shrink:0;"></div>
                            <div style="font-size:20px;font-weight:800;color:#fff;">@userStats.TopGenre</div>
                        </div>
                        <div style="font-size:12px;color:rgba(255,255,255,0.35);">@userStats.TopGenrePlays @Lang.T("plays this month")</div>
                    </div>
                }

                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:22px;">
                    <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.35);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px;">@Lang.T("Quick Actions")</div>
                    <div style="display:flex;flex-direction:column;gap:6px;">
                        @foreach (var qa in new[] {
                    ("/player",       Lang.T("Browse Music"),    "#8B5CF6"),
                    ("/visualizer",   Lang.T("Open Visualizer"), "#10B981"),
                    ("/map",          Lang.T("World Map"),       "#F59E0B"),
                    ("/liked-songs",   Lang.T("Liked Songs"),     "#EC4899"),
                    ("/playlists",    Lang.T("My Playlists"),    "#06B6D4")
                    })
                        {
                            <a href="@qa.Item1"
                               style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;text-decoration:none;transition:all 0.2s;background:rgba(255,255,255,0.02);"
                               onmouseover="this.style.background='rgba(255,255,255,0.06)'; this.style.paddingLeft='16px'"
                               onmouseout="this.style.background='rgba(255,255,255,0.02)'; this.style.paddingLeft='12px'">
                                <div style="width:6px;height:6px;border-radius:50%;background:@qa.Item3;flex-shrink:0;"></div>
                                <span style="font-size:13px;font-weight:500;color:rgba(255,255,255,0.65);">@qa.Item2</span>
                                <span style="margin-left:auto;font-size:13px;color:rgba(255,255,255,0.2);">→</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (userStats.TotalPlays > 0)
