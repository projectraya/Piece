@page "/"

@using Microsoft.AspNetCore.Components.Authorization
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using Piece.Services
@using Piece.DTOs
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IListeningHistoryService ListeningHistoryService
@inject PlayerService PlayerService



<PageTitle>@pageTitle</PageTitle>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* ============================================
                   LOGGED-IN USER DASHBOARD STYLES
                   ============================================ */

    .dashboard-container {
        min-height: 100vh;
        background: #0f0f0f;
        color: #ffffff;
        padding: 50px 70px 100px 70px;
        margin: -1.5rem -1.5rem -1.5rem -1.5rem;
        width: calc(100% + 3rem);
    }

    /* Hero Section with Featured Discovery */
    .hero-section {
        margin-bottom: 60px;
        background: linear-gradient(135deg, #1a1a1a 0%, #1f1f1f 100%);
        border-radius: 24px;
        padding: 60px;
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(138, 92, 246, 0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .welcome-label {
        font-size: 14px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
    }

    .welcome-title {
        font-size: 52px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #ffffff;
        letter-spacing: -1px;
        line-height: 1.1;
    }

    .welcome-subtitle {
        font-size: 18px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 400;
        margin-bottom: 40px;
        max-width: 600px;
    }

    /* Roulette Discovery Wheel */
    .discovery-wheel {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-top: 40px;
    }

    .wheel-container {
        position: relative;
        width: 180px;
        height: 180px;
    }

    .wheel-circle {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: pointer;
        box-shadow: 0 10px 40px rgba(139, 92, 246, 0.4);
    }

        .wheel-circle:hover {
            box-shadow: 0 15px 50px rgba(139, 92, 246, 0.6);
        }

    .wheel-inner {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: #0f0f0f;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        color: #8B5CF6;
        text-align: center;
        line-height: 1.3;
    }

    .wheel-arrow {
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 15px solid transparent;
        border-right: 15px solid transparent;
        border-top: 25px solid #8B5CF6;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
        z-index: 10;
    }

    .wheel-options {
        flex: 1;
    }

    .wheel-option {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px 24px;
        margin-bottom: 12px;
        font-size: 16px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        transition: all 0.3s;
        cursor: default;
    }

        .wheel-option.active {
            background: rgba(139, 92, 246, 0.15);
            border-color: rgba(139, 92, 246, 0.4);
            color: #8B5CF6;
            transform: translateX(8px);
        }

    .spin-button {
        background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
        border: none;
        border-radius: 12px;
        padding: 16px 48px;
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 16px rgba(139, 92, 246, 0.3);
        margin-top: 20px;
    }

        .spin-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(139, 92, 246, 0.5);
        }

        .spin-button:active {
            transform: translateY(0);
        }

    /* Stats Cards */
    .stats-section {
        margin-bottom: 60px;
    }

    .section-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 24px;
        color: #ffffff;
        letter-spacing: -0.5px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    @@media (max-width: 1024px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 32px 28px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #8B5CF6, #7C3AED);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .stat-card:hover::before {
            transform: scaleX(1);
        }

        .stat-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(139, 92, 246, 0.3);
            transform: translateY(-4px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: rgba(139, 92, 246, 0.15);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        font-size: 24px;
    }

    .stat-number {
        font-size: 42px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
        letter-spacing: -1px;
    }

    .stat-label {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 500;
        letter-spacing: 0.3px;
    }

    /* Recent Activity Section */
    .activity-section {
        margin-bottom: 60px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .view-all-link {
        font-size: 14px;
        color: #8B5CF6;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .view-all-link:hover {
            color: #A78BFA;
            transform: translateX(4px);
        }

    .activity-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 16px;
    }

    .activity-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .activity-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(139, 92, 246, 0.3);
            transform: translateY(-4px);
        }

    .activity-art {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 8px;
        background: linear-gradient(135deg, #1f1f1f 0%, #2a2a2a 100%);
        margin-bottom: 12px;
        overflow: hidden;
        position: relative;
    }

        .activity-art img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .activity-art::after {
            content: '▶';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            background: rgba(139, 92, 246, 0.95);
            color: #fff;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: all 0.3s;
            opacity: 0;
        }

    .activity-card:hover .activity-art::after {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }

    .activity-track-title {
        font-size: 15px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .activity-track-artist {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.5);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-bottom: 8px;
    }

    .activity-time {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.4);
        font-weight: 500;
    }

    /* Empty States */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 16px;
        border: 1px dashed rgba(255, 255, 255, 0.1);
    }

    .empty-state-title {
        font-size: 20px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 12px;
    }

    .empty-state-text {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.4);
        max-width: 400px;
        margin: 0 auto 24px;
        line-height: 1.6;
    }

    .empty-state-button {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 8px;
        padding: 12px 32px;
        color: #8B5CF6;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-block;
    }

        .empty-state-button:hover {
            background: rgba(139, 92, 246, 0.15);
            border-color: rgba(139, 92, 246, 0.5);
            transform: translateY(-2px);
        }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background: #0f0f0f;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(255, 255, 255, 0.1);
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: 20px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .loading-text {
        color: rgba(255, 255, 255, 0.5);
        font-size: 14px;
        font-weight: 500;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 30px 20px 80px 20px;
        }

        .hero-section {
            padding: 40px 30px;
        }

        .welcome-title {
            font-size: 36px;
        }

        .discovery-wheel {
            flex-direction: column;
        }

        .wheel-container {
            width: 160px;
            height: 160px;
        }

        .wheel-circle {
            width: 160px;
            height: 160px;
        }

        .wheel-inner {
            width: 120px;
            height: 120px;
        }
    }

    /* ============================================
           LANDING PAGE STYLES (NON-LOGGED-IN)
           ============================================ */
    .landing-page {
        min-height: 100vh;
        background: #0f0f0f;
        color: #ffffff;
        overflow-x: hidden;
        margin: -1.5rem -1.5rem -1.5rem -2rem;
        width: calc(100% + 3.5rem);
    }

    .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 15, 15, 0.95);
        backdrop-filter: blur(10px);
        padding: 20px 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .logo img {
            height: 44px;
            width: auto;
            object-fit: contain;
        }

    .auth-buttons {
        display: flex;
        gap: 15px;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        border: none;
        display: inline-block;
    }

    .btn-login {
        background: transparent;
        color: #ffffff;
        border: 2px solid rgba(255, 255, 255, 0.2);
    }

        .btn-login:hover {
            border-color: #8B5CF6;
            color: #8B5CF6;
        }

    .btn-signup {
        background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
        color: #ffffff;
    }

        .btn-signup:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
        }

    .hero {
        padding: 100px 60px;
        text-align: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 72px;
        font-weight: 900;
        margin-bottom: 20px;
        letter-spacing: -2px;
        line-height: 1.1;
        color: #ffffff;
    }

        .hero-title .highlight {
            background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-subtitle {
        font-size: 24px;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 50px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        max-width: 900px;
        margin: 0 auto 60px;
    }

    .stat-box {
        padding: 30px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        backdrop-filter: blur(10px);
        transition: all 0.3s;
    }

        .stat-box:hover {
            background: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.3);
            transform: translateY(-4px);
        }

    .landing-stat-number {
        font-size: 48px;
        font-weight: 900;
        background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 8px;
    }

    .landing-stat-label {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 500;
    }

    .section {
        padding: 60px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .section-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .landing-section-title {
        font-size: 36px;
        font-weight: 800;
        color: #ffffff;
    }

    .tracks-scroll {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding-bottom: 20px;
        scrollbar-width: thin;
        scrollbar-color: #8B5CF6 rgba(255, 255, 255, 0.1);
    }

        .tracks-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .tracks-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .tracks-scroll::-webkit-scrollbar-thumb {
            background: #8B5CF6;
            border-radius: 10px;
        }

    .track-card {
        min-width: 280px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }

        .track-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #8B5CF6, #7C3AED);
            transform: scaleX(0);
            transition: transform 0.3s;
        }

        .track-card:hover::before {
            transform: scaleX(1);
        }

        .track-card:hover {
            transform: translateY(-5px);
            border-color: rgba(139, 92, 246, 0.4);
            box-shadow: 0 15px 40px rgba(139, 92, 246, 0.3);
        }

    .track-rank {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 18px;
    }

    .track-art {
        width: 100%;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #1f1f1f 0%, #2a2a2a 100%);
        border-radius: 8px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        overflow: hidden;
    }

        .track-art img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .track-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 6px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .track-artist {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-bottom: 8px;
    }

    .track-plays {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
    }

    .logo-section {
        padding: 80px 60px;
        text-align: center;
        background: rgba(255, 255, 255, 0.02);
    }

    .logo-container {
        max-width: 300px;
        margin: 0 auto 20px;
        cursor: pointer;
    }

    .interactive-logo {
        width: 100%;
        height: auto;
        transition: transform 0.6s ease-in-out;
    }

    .logo-subtitle {
        font-size: 18px;
        color: rgba(255, 255, 255, 0.6);
    }

    .genres-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }

    .genre-card {
        aspect-ratio: 1;
        border-radius: 15px;
        padding: 25px;
        display: flex;
        align-items: flex-end;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .genre-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
            transition: opacity 0.3s;
        }

        .genre-card:hover::before {
            opacity: 0;
        }

        .genre-card:hover {
            transform: scale(1.05);
            border-color: rgba(139, 92, 246, 0.4);
        }

    .genre-content {
        position: relative;
        z-index: 1;
    }

    .genre-name {
        font-size: 24px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 5px;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    .genre-count {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.9);
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 35px;
        transition: all 0.3s;
    }

        .feature-card:hover {
            background: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.3);
            transform: translateY(-5px);
        }

    .feature-title {
        font-size: 22px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 12px;
    }

    .feature-desc {
        font-size: 16px;
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.6;
    }

    .cta-section {
        padding: 100px 60px;
        text-align: center;
        background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
        color: #ffffff;
    }

    .cta-title {
        font-size: 48px;
        font-weight: 900;
        margin-bottom: 15px;
    }

    .cta-subtitle {
        font-size: 20px;
        margin-bottom: 35px;
        opacity: 0.9;
    }

    .btn-cta {
        font-size: 18px;
        padding: 16px 40px;
        background: #ffffff;
        color: #8B5CF6;
        font-weight: 700;
    }

        .btn-cta:hover {
            background: #f3f4f6;
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }
</style>

@* add translation button *@
@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p class="loading-text">@loadingMessage</p>
    </div>
}
else if (isLoggedIn)
{
    <div class="dashboard-container">
        <!-- Hero Discovery Section -->
        <div class="hero-section">
            <div class="hero-content">
                <div class="welcome-label">Welcome Back</div>
                <h1 class="welcome-title">@userName</h1>
                <p class="welcome-subtitle">Not sure what to listen to? Let the discovery wheel decide your next adventure.</p>

                <div class="discovery-wheel">
                    <div class="wheel-container">
                        <div class="wheel-arrow"></div>
                        <div class="wheel-circle" id="discoveryWheel" onclick="spinDiscoveryWheel()">
                            <div class="wheel-inner">
                                <span>SPIN<br />TO<br />DISCOVER</span>
                            </div>
                        </div>
                    </div>
                    <div class="wheel-options">
                        <div class="wheel-option" id="option0">Browse All Music</div>
