<script>
    let currentRotation = 0;
    let isSpinning = false;
    let selectedOption = -1;
    const routes = ["/player", "/visualizer", "/playlists", "/liked-songs", null, "/admin/upload"];
    let isRotating = false;

    function spinDiscoveryWheel() {
        if (isSpinning) return;

        isSpinning = true;
        const wheel = document.getElementById('discoveryWheel');
        if (!wheel) return;

        for (let i = 0; i < 6; i++) {
            const option = document.getElementById('option' + i);
            if (option) option.classList.remove('active');
        }

        const fullSpins = 5 + Math.floor(Math.random() * 4);
        const segments = 6;
        selectedOption = Math.floor(Math.random() * segments);
        const degreesPerSegment = 360 / segments;

        const extraDegrees = (selectedOption * degreesPerSegment) + (degreesPerSegment / 2);
        currentRotation += (fullSpins * 360) + extraDegrees;

        wheel.style.transition = 'transform 3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        wheel.style.transform = `rotate(${currentRotation}deg)`;

        setTimeout(() => {
            isSpinning = false;

            const activeOption = document.getElementById('option' + selectedOption);
            if (activeOption) activeOption.classList.add('active');

            const goButton = document.getElementById('goButton');
            if (goButton) goButton.style.display = 'inline-block';
        }, 3000);
    }

    function navigateToSelected(username) {
        if (selectedOption === 4) {
            window.location.href = '/profile/' + username;
        } else if (selectedOption >= 0 && selectedOption < routes.length && routes[selectedOption] !== null) {
            window.location.href = routes[selectedOption];
        }
    }

    function playTrack(trackId) {
        window.location.href = '/player?play=' + trackId;
    }

    function rotatePuzzleLogo() {
        if (isRotating) return;

        const logo = document.getElementById('puzzleLogo');
        if (!logo) return;

        isRotating = true;
        currentRotation += 90;

        logo.style.transition = 'transform 0.6s ease-in-out';
        logo.style.transform = `rotate(${currentRotation}deg)`;

        setTimeout(() => {
            isRotating = false;
        }, 600);
    }
</script>

@code {
    private bool isLoading = true;
    private bool isLoggedIn = false;
    private string userName = "";
    private string? currentUserId;
    private string loadingMessage = "Loading...";
    private string pageTitle = "Piece";

    private UserStats userStats = new();
    private List<RecentTrack> recentTracks = new();

    private int totalTracks = 0;
    private int totalGenres = 0;
    private int totalPlays = 0;
    private int continentCount = 6;
    private List<Track> trendingTracks = new();
    private List<Track> latestTracks = new();
    private List<Genre> genres = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isLoggedIn = user.Identity?.IsAuthenticated == true;

        if (isLoggedIn)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            // Fetch user's display name from database
            if (!string.IsNullOrEmpty(currentUserId))
            {
                using var context = await DbFactory.CreateDbContextAsync();
                var currentUser = await context.Users.FindAsync(currentUserId);
                userName = !string.IsNullOrEmpty(currentUser?.DisplayName)
                    ? currentUser.DisplayName
                    : user.Identity?.Name ?? "User";
            }
            else
            {
                userName = user.Identity?.Name ?? "User";
            }
            pageTitle = $"Home - Piece";
            loadingMessage = "Loading your dashboard...";
            await LoadUserDashboard();
        }
        else
        {
            loadingMessage = "Loading...";
            await LoadLandingPageData();
        }
    }

    private async Task LoadUserDashboard()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var listeningHistory = await context.ListeningHistory
                .Where(h => h.UserId == currentUserId)
                .ToListAsync();

            userStats.TotalPlays = listeningHistory.Count;
            userStats.UniqueTracksPlayed = listeningHistory.Select(h => h.TrackId).Distinct().Count();
            userStats.TotalMinutes = (int)(listeningHistory.Sum(h => h.DurationListened) / 60.0);
            userStats.PlaylistCount = await context.Playlists.Where(p => p.UserId == currentUserId).CountAsync();

            var recentHistoryItems = await context.ListeningHistory
                .Where(h => h.UserId == currentUserId)
                .OrderByDescending(h => h.PlayedAt)
                .Take(12)
                .Include(h => h.Track)
                .ToListAsync();

            recentTracks = recentHistoryItems.Select(h => new RecentTrack
                {
                    Title = h.Track?.Title ?? "Unknown",
                    ArtistName = h.Track?.ArtistName ?? "Unknown Artist",
                    AlbumArt = h.Track != null && !string.IsNullOrEmpty(h.Track.CoverImageUrl)
                                ? h.Track.CoverImageUrl
                                : "/images/default-album-cover.png",
                    PlayedAt = GetRelativeTime(h.PlayedAt),
                    TrackId = h.TrackId
                }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLandingPageData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var allTracks = await context.Tracks
                .Include(t => t.Genre)
                .Where(t => t.IsActive && t.Source == TrackSource.Local)
                .ToListAsync();

            totalTracks = 500000;
            totalGenres = await context.Genres.CountAsync();
            totalPlays = allTracks.Sum(t => t.PlayCount);
            trendingTracks = allTracks.OrderByDescending(t => t.PlayCount).Take(10).ToList();
            latestTracks = allTracks.OrderByDescending(t => t.CreatedAt).Take(10).ToList();
            genres = await context.Genres.Include(g => g.Tracks).OrderByDescending(g => g.Tracks.Count).ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading landing page data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";
        return dateTime.ToString("MMM d");
    }

    private class UserStats
    {
        public int TotalPlays { get; set; }
        public int UniqueTracksPlayed { get; set; }
        public int TotalMinutes { get; set; }
        public int PlaylistCount { get; set; }
    }

    private class RecentTrack
    {
        public string Title { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string? AlbumArt { get; set; }
        public string PlayedAt { get; set; } = "";
        public int TrackId { get; set; }
    }
}