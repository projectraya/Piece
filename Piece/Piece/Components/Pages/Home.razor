@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Piece.Data
@using Piece.Data.Models
@using Piece.Data.Enums
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Piece - Discover Music Globally</PageTitle>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .landing-page {
        min-height: 100vh;
        background: #ffffff;
        color: #1a1a1a;
        overflow-x: hidden;
    }

    /* Header */
    .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 20px 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .logo img {
            height: 128px;
            width: auto;
            object-fit: contain;
        }

    .auth-buttons {
        display: flex;
        gap: 15px;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        border: none;
        display: inline-block;
    }

    .btn-login {
        background: transparent;
        color: #1a1a1a;
        border: 2px solid rgba(0, 0, 0, 0.2);
    }

        .btn-login:hover {
            border-color: #FFD335;
            color: #FFD335;
        }

    .btn-signup {
        background: linear-gradient(135deg, #FFD335 0%, #FFA500 100%);
        color: #000;
    }

        .btn-signup:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255, 211, 53, 0.4);
        }

    /* Hero Section */
    .hero {
        padding: 80px 60px;
        text-align: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 72px;
        font-weight: 900;
        margin-bottom: 20px;
        letter-spacing: -2px;
        line-height: 1.1;
        background: linear-gradient(135deg, #1a1a1a 0%, #FFD335 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 24px;
        color: rgba(0, 0, 0, 0.6);
        margin-bottom: 50px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        max-width: 900px;
        margin: 0 auto 60px;
    }

    .stat-box {
        padding: 20px;
        background: rgba(0, 0, 0, 0.03);
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 15px;
        backdrop-filter: blur(10px);
    }

    .stat-number {
        font-size: 48px;
        font-weight: 900;
        color: #FFD335;
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: 14px;
        color: rgba(0, 0, 0, 0.6);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Section Title */
    .section {
        padding: 60px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .section-title {
        font-size: 36px;
        font-weight: 800;
        color: #1a1a1a;
    }

    .section-link {
        color: #FFD335;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

        .section-link:hover {
            color: #FFA500;
        }

    /* Track Cards */
    .tracks-scroll {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding-bottom: 20px;
        scrollbar-width: thin;
        scrollbar-color: #FFD335 rgba(0, 0, 0, 0.1);
    }

        .tracks-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .tracks-scroll::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        .tracks-scroll::-webkit-scrollbar-thumb {
            background: #FFD335;
            border-radius: 10px;
        }

    .track-card {
        min-width: 280px;
        background: #f8f8f8;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 15px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }

        .track-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #FFD335, #FFA500);
            transform: scaleX(0);
            transition: transform 0.3s;
        }

        .track-card:hover::before {
            transform: scaleX(1);
        }

        .track-card:hover {
            transform: translateY(-5px);
            border-color: #FFD335;
            box-shadow: 0 15px 40px rgba(255, 211, 53, 0.3);
        }

    .track-rank {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: #FFD335;
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 18px;
    }

    .track-art {
        width: 100%;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #FFD335 0%, #764ba2 100%);
        border-radius: 8px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        overflow: hidden;
    }

        .track-art img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .track-title {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .track-artist {
        font-size: 14px;
        color: rgba(0, 0, 0, 0.6);
        margin-bottom: 12px;
    }

    .track-plays {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #FFD335;
    }

    /* Interactive Logo Section */
    .logo-section {
        text-align: center;
        padding: 80px 60px;
    }

    .logo-container {
        display: inline-block;
        cursor: pointer;
        transition: transform 0.1s ease;
    }

        .logo-container:hover {
            transform: scale(1.05);
        }

        .logo-container:active {
            transform: scale(0.98);
        }

    .interactive-logo {
        width: 450px;
        height: 450px;
        filter: drop-shadow(0 15px 40px rgba(0, 0, 0, 0.15));
        transition: filter 0.3s;
    }

    .logo-container:hover .interactive-logo {
        filter: drop-shadow(0 20px 50px rgba(255, 211, 53, 0.4));
    }

    .logo-subtitle {
        margin-top: 30px;
        font-size: 18px;
        color: rgba(0, 0, 0, 0.5);
        font-weight: 500;
    }

    /* Genre Grid */
    .genres-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }

    .genre-card {
        aspect-ratio: 1;
        border-radius: 15px;
        padding: 25px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }

        .genre-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: inherit;
            filter: brightness(0.8);
            transition: filter 0.3s;
        }

        .genre-card:hover::before {
            filter: brightness(1.2);
        }

        .genre-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        }

    .genre-content {
        position: relative;
        z-index: 1;
    }

    .genre-name {
        font-size: 24px;
        font-weight: 800;
        color: white;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        margin-bottom: 8px;
    }

    .genre-count {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.9);
        text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
    }

    /* Features */
    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }

    .feature-card {
        background: #f8f8f8;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 15px;
        padding: 40px;
        text-align: center;
        transition: all 0.3s;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            border-color: #FFD335;
        }

    .feature-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 12px;
    }

    .feature-desc {
        font-size: 15px;
        color: rgba(0, 0, 0, 0.6);
        line-height: 1.6;
    }

    /* CTA */
    .cta-section {
        text-align: center;
        padding: 80px 60px;
        background: linear-gradient(135deg, rgba(255, 211, 53, 0.15) 0%, rgba(255, 165, 0, 0.15) 100%);
        margin: 60px;
        border-radius: 20px;
    }

    .cta-title {
        font-size: 48px;
        font-weight: 900;
        color: #1a1a1a;
        margin-bottom: 20px;
    }

    .cta-subtitle {
        font-size: 20px;
        color: rgba(0, 0, 0, 0.6);
        margin-bottom: 40px;
    }

    .btn-cta {
        padding: 18px 50px;
        font-size: 18px;
        border-radius: 30px;
    }

    /* Loading State */
    .loading-state {
        text-align: center;
        padding: 100px 20px;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(255, 211, 53, 0.2);
        border-top-color: #FFD335;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 42px;
        }

        .section {
            padding: 40px 20px;
        }

        .header {
            padding: 15px 20px;
        }

        .interactive-logo {
            width: 300px;
            height: 300px;
        }
    }
</style>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p style="color: rgba(0, 0, 0, 0.6);">Loading amazing music...</p>
    </div>
}
else
{
    <div class="landing-page">
        <!-- Header -->
        <header class="header">
            <div class="logo">
                <a href="/">
                    <img src="./images/piece_logo_black.png" alt="Piece logo">
                </a>
            </div>
            <div class="auth-buttons">
                <a href="/Account/Login" class="btn btn-login">Log In</a>
                <a href="/Account/Register" class="btn btn-signup">Sign Up Free</a>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="hero">
            <h1 class="hero-title">Discover Music From Every Corner of the World</h1>
            <p class="hero-subtitle">500,000+ tracks. Real-time visualizers. Global discovery.</p>

            <div class="stats-row">
                <div class="stat-box">
                    <div class="stat-number">0.5M+</div>
                    <div class="stat-label">Total Tracks</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">@totalGenres</div>
                    <div class="stat-label">Genres</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">@totalPlays.ToString("N0")</div>
                    <div class="stat-label">Plays Today</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">@continentCount</div>
                    <div class="stat-label">Continents</div>
                </div>
            </div>

            <a href="/Account/Register" class="btn btn-signup btn-cta">Start Your Journey</a>
        </section>

        <!-- Trending Tracks -->
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">Trending Now</h2>
            </div>
            <div class="tracks-scroll">
                @for (int i = 0; i < trendingTracks.Count && i < 10; i++)
                {
                    var track = trendingTracks[i];
                    <div class="track-card">
                        <div class="track-rank">@(i + 1)</div>
                        <div class="track-art">
                            @if (!string.IsNullOrEmpty(track.CoverImageUrl))
                            {
                                <img src="@track.CoverImageUrl" alt="@track.Title" />
                            }
                            else
                            {
                                <span>🎵</span>
                            }
                        </div>
                        <div class="track-title">@track.Title</div>
                        <div class="track-artist">@track.ArtistName</div>
                        <div class="track-plays">
                            <span>@track.PlayCount.ToString("N0") plays</span>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Interactive Logo Section -->
        <section class="logo-section">
            <div class="logo-container" onclick="rotatePuzzleLogo()">
                <img src="./images/piece_logo_black.png"
                     alt="Piece - Interactive Music Discovery"
                     class="interactive-logo"
                     id="puzzleLogo">
            </div>
            <p class="logo-subtitle">Click to spin the puzzle 🧩</p>
        </section>

        <!-- Fresh Uploads -->
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">Fresh Uploads</h2>
            </div>
            <div class="tracks-scroll">
                @foreach (var track in latestTracks.Take(10))
                {
                    <div class="track-card">
                        <div class="track-art">
                            @if (!string.IsNullOrEmpty(track.CoverImageUrl))
                            {
                                <img src="@track.CoverImageUrl" alt="@track.Title" />
                            }
                            else
                            {
                                <span>🎵</span>
                            }
                        </div>
                        <div class="track-title">@track.Title</div>
                        <div class="track-artist">@track.ArtistName</div>
                        <div class="track-plays">
                            <span>@track.PlayCount plays</span>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Genre Spotlight -->
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">Explore by Genre</h2>
            </div>
            <div class="genres-grid">
                @foreach (var genre in genres)
                {
                    <div class="genre-card" style="background: @genre.Color;">
                        <div class="genre-content">
                            <div class="genre-name">@genre.Name</div>
                            <div class="genre-count">@genre.Tracks.Count tracks</div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Features -->
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">Why Piece?</h2>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-title">6 Visualizer Modes</div>
                    <div class="feature-desc">Transform music into art with real-time audio visualization</div>
                </div>
                <div class="feature-card">
                    <div class="feature-title">Global Discovery</div>
                    <div class="feature-desc">Explore artists and music from every continent</div>
                </div>
                <div class="feature-card">
                    <div class="feature-title">Listening Analytics</div>
                    <div class="feature-desc">Beautiful stats tracking your musical journey</div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-section">
            <h2 class="cta-title">Ready to Experience Music Differently?</h2>
            <p class="cta-subtitle">Join thousands discovering new sounds every day</p>
            <a href="/Account/Register" class="btn btn-signup btn-cta">Get Started Free</a>
        </section>
    </div>
}

<script>
    let isRotating = false;
    let currentRotation = 0;

    function rotatePuzzleLogo() {
        if (isRotating) return;

        const logo = document.getElementById('puzzleLogo');
        if (!logo) return;

        isRotating = true;
        currentRotation += 90; // Quarter turn (90 degrees)

        logo.style.transition = 'transform 0.6s ease-in-out';
        logo.style.transform = `rotate(${currentRotation}deg)`;

        setTimeout(() => {
            isRotating = false;
        }, 600);
    }
</script>

@code {
    private bool isLoading = true;

    // Stats
    private int totalTracks = 0;
    private int totalGenres = 0;
    private int totalPlays = 0;
    private int continentCount = 6;

    // Data
    private List<Track> trendingTracks = new();
    private List<Track> latestTracks = new();
    private List<Genre> genres = new();

    protected override async Task OnInitializedAsync()
    {
        // Redirect logged-in users
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Let them stay if they navigated here directly
            // Navigation.NavigateTo("/player");
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            // Load stats
            var allTracks = await context.Tracks
                .Include(t => t.Genre)
                .Where(t => t.IsActive && t.Source == TrackSource.Local)
                .ToListAsync();

            totalTracks = 500000;
            totalGenres = await context.Genres.CountAsync();
            totalPlays = allTracks.Sum(t => t.PlayCount);

            // Trending tracks (most played)
            trendingTracks = allTracks
                .OrderByDescending(t => t.PlayCount)
                .Take(10)
                .ToList();

            // Latest uploads
            latestTracks = allTracks
                .OrderByDescending(t => t.CreatedAt)
                .Take(10)
                .ToList();

            // Genres
            genres = await context.Genres
                .Include(g => g.Tracks)
                .OrderByDescending(g => g.Tracks.Count)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading landing page data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}