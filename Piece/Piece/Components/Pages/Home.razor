<script>
    /* ── Dashboard mode grid ── */
    const modeColors = ["#8B5CF6","#10B981","#F59E0B","#EC4899","#06B6D4","#EF4444"];

    function hexToRgb(hex) {
        const r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return r ? `${parseInt(r[1],16)},${parseInt(r[2],16)},${parseInt(r[3],16)}` : '139,92,246';
    }

    function hoverCard(idx, on) {
        const card = document.getElementById('modeCard' + idx);
        if (!card) return;
        if (on) {
            card.style.background = `rgba(${hexToRgb(modeColors[idx])},0.1)`;
            card.style.borderColor = `rgba(${hexToRgb(modeColors[idx])},0.4)`;
            card.style.transform = 'translateY(-3px)';
        } else {
            card.style.background = 'rgba(255,255,255,0.03)';
            card.style.borderColor = 'rgba(255,255,255,0.08)';
            card.style.transform = 'translateY(0)';
        }
    }

    function selectMode(idx, route) {
        for (let i = 0; i < 6; i++) {
            const c = document.getElementById('modeCard' + i);
            if (c) { c.style.background='rgba(255,255,255,0.03)'; c.style.borderColor='rgba(255,255,255,0.08)'; c.style.transform='scale(1)'; }
        }
        const sel = document.getElementById('modeCard' + idx);
        if (sel) {
            sel.style.background = `rgba(${hexToRgb(modeColors[idx])},0.18)`;
            sel.style.borderColor = modeColors[idx];
            sel.style.transform = 'scale(1.04)';
        }
        setTimeout(() => { window.location.href = route; }, 280);
    }

    function pickRandom() {
        let current = 0;
        let speed = 70;
        let iterations = 0;
        const total = 20 + Math.floor(Math.random() * 8);
        const finalIdx = Math.floor(Math.random() * 6);

        for (let i = 0; i < 6; i++) {
            const c = document.getElementById('modeCard' + i);
            if (c) { c.style.background='rgba(255,255,255,0.03)'; c.style.borderColor='rgba(255,255,255,0.08)'; c.style.transform='scale(1)'; }
        }

        function step() {
            const prev = document.getElementById('modeCard' + current);
            if (prev) { prev.style.background='rgba(255,255,255,0.03)'; prev.style.borderColor='rgba(255,255,255,0.08)'; prev.style.transform='scale(1)'; }

            current = iterations >= total ? finalIdx : (current + 1) % 6;

            const curr = document.getElementById('modeCard' + current);
            if (curr) {
                curr.style.background = `rgba(${hexToRgb(modeColors[current])},0.22)`;
                curr.style.borderColor = modeColors[current];
                curr.style.transform = 'scale(1.06)';
            }

            iterations++;
            if (iterations <= total) {
                speed = Math.min(speed * 1.09, 420);
                setTimeout(step, speed);
            } else {
                setTimeout(() => { window.location.href = ["/player","/visualizer","/playlists","/liked-songs","/statistics","/admin/upload"][finalIdx]; }, 650);
            }
        }
        step();
    }

    function playTrack(id) { window.location.href = '/player?play=' + id; }

    /* ── Landing fake visualizer ── */
    function animateVisualizer() {
        document.querySelectorAll('.viz-bar').forEach(bar => {
            bar.style.height = (18 + Math.random() * 200) + 'px';
            bar.style.transition = 'height 0.14s ease';
        });
    }
    setInterval(animateVisualizer, 140);

    /* ── Landing logo spin ── */
    let isRotating = false, currentRotation = 0;
    function rotatePuzzleLogo() {
        if (isRotating) return;
        const logo = document.getElementById('puzzleLogo');
        if (!logo) return;
        isRotating = true;
        currentRotation += 90;
        logo.style.transition = 'transform 0.6s ease-in-out';
        logo.style.transform = `rotate(${currentRotation}deg)`;
        setTimeout(() => { isRotating = false; }, 600);
    }
</script>

@code {
    private bool isLoading = true;
    private bool isLoggedIn = false;
    private string userName = "";
    private string? currentUserId;
    private string loadingMessage = "Loading...";
    private string pageTitle = "Piece";

    private UserStats userStats = new();
    private List<RecentTrack> recentTracks = new();
    private Dictionary<int, string> listeningHeatmap = new();

    // Landing page data
    private int totalGenres = 0;
    private int totalPlays = 0;
    private int continentCount = 6;
    private List<Track> trendingTracks = new();
    private List<Track> latestTracks = new();
    private List<Genre> genres = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isLoggedIn = user.Identity?.IsAuthenticated == true;

        if (isLoggedIn)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(currentUserId))
            {
                using var ctx = await DbFactory.CreateDbContextAsync();
                var currentUser = await ctx.Users.FindAsync(currentUserId);
                userName = !string.IsNullOrEmpty(currentUser?.DisplayName)
                    ? currentUser.DisplayName
                    : user.Identity?.Name ?? "User";
            }
            else
            {
                userName = user.Identity?.Name ?? "User";
            }
            pageTitle = "Home - Piece";
            loadingMessage = "Loading your dashboard...";
            await LoadUserDashboard();
        }
        else
        {
            loadingMessage = "Loading...";
            await LoadLandingPageData();
        }
    }

    private async Task LoadUserDashboard()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var listeningHistory = await context.ListeningHistory
                .Where(h => h.UserId == currentUserId)
                .ToListAsync();

            userStats.TotalPlays = listeningHistory.Count;
            userStats.UniqueTracksPlayed = listeningHistory.Select(h => h.TrackId).Distinct().Count();
            userStats.TotalMinutes = (int)(listeningHistory.Sum(h => h.DurationListened) / 60.0);
            userStats.PlaylistCount = await context.Playlists
                .Where(p => p.UserId == currentUserId)
                .CountAsync();

            // Top genre this month
            var topGenreData = await context.ListeningHistory
                .Where(h => h.UserId == currentUserId && h.PlayedAt >= DateTime.UtcNow.AddDays(-30))
                .Include(h => h.Track).ThenInclude(t => t.Genre)
                .Where(h => h.Track.Genre != null)
                .GroupBy(h => new { h.Track.Genre!.Name, h.Track.Genre.Color })
                .Select(g => new { g.Key.Name, g.Key.Color, Count = g.Count() })
                .OrderByDescending(g => g.Count)
                .FirstOrDefaultAsync();

            if (topGenreData != null)
            {
                userStats.TopGenre = topGenreData.Name;
                userStats.TopGenreColor = topGenreData.Color ?? "#8B5CF6";
                userStats.TopGenrePlays = topGenreData.Count;
            }

            // Heatmap — last 30 days with dominant genre color per day
            var last30 = await context.ListeningHistory
                .Where(h => h.UserId == currentUserId && h.PlayedAt >= DateTime.UtcNow.AddDays(-30))
                .Include(h => h.Track).ThenInclude(t => t.Genre)
                .Where(h => h.Track.Genre != null)
                .ToListAsync();

            for (int d = 0; d < 30; d++)
            {
                var dayStart = DateTime.UtcNow.Date.AddDays(-29 + d);
                var dayEnd = dayStart.AddDays(1);
                var dayPlays = last30.Where(h => h.PlayedAt >= dayStart && h.PlayedAt < dayEnd).ToList();
                listeningHeatmap[d] = dayPlays.Any()
                    ? dayPlays.GroupBy(h => h.Track.Genre!.Color).OrderByDescending(g => g.Count()).First().Key ?? "#1a1a1a"
                    : "#1a1a1a";
            }

            // Recent tracks
            var recentItems = await context.ListeningHistory
                .Where(h => h.UserId == currentUserId)
                .OrderByDescending(h => h.PlayedAt)
                .Take(12)
                .Include(h => h.Track)
                .ToListAsync();

            recentTracks = recentItems.Select(h => new RecentTrack
                {
                    Title = h.Track?.Title ?? "Unknown",
                    ArtistName = h.Track?.ArtistName ?? "Unknown Artist",
                    AlbumArt = h.Track != null && !string.IsNullOrEmpty(h.Track.CoverImageUrl)
                        ? h.Track.CoverImageUrl
                        : "/images/default-album-cover.png",
                    PlayedAt = GetRelativeTime(h.PlayedAt),
                    TrackId = h.TrackId
                }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLandingPageData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var allTracks = await context.Tracks
                .Include(t => t.Genre)
                .Where(t => t.IsActive && t.Source == TrackSource.Local)
                .ToListAsync();

            totalGenres = await context.Genres.CountAsync();
            totalPlays = allTracks.Sum(t => t.PlayCount);
            trendingTracks = allTracks.OrderByDescending(t => t.PlayCount).Take(10).ToList();
            latestTracks = allTracks.OrderByDescending(t => t.CreatedAt).Take(10).ToList();
            genres = await context.Genres.Include(g => g.Tracks).OrderByDescending(g => g.Tracks.Count).ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading landing page data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetRelativeTime(DateTime dt)
    {
        var ts = DateTime.UtcNow - dt;
        if (ts.TotalMinutes < 1) return "Just now";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m ago";
        if (ts.TotalHours < 24) return $"{(int)ts.TotalHours}h ago";
        if (ts.TotalDays < 7) return $"{(int)ts.TotalDays}d ago";
        return dt.ToString("MMM d");
    }

