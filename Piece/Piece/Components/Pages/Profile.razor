    private async Task OpenAvatarUpload()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.hidden-file-input').click()");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening file picker: {ex.Message}");
        }
    }

    private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
    {
        if (user == null) return;

        var file = e.File;
        if (file == null) return;

        try
        {
            // Validate file type
            var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/webp" };
            if (!allowedTypes.Contains(file.ContentType.ToLower()))
            {
                ShowToast("Invalid file type. Please upload a JPEG, PNG, or WebP image.", "error");
                return;
            }

            // Validate file size (max 5MB)
            if (file.Size > 5 * 1024 * 1024)
            {
                ShowToast("File size too large. Maximum size is 5MB.", "error");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            previewAvatarUrl = $"data:{file.ContentType};base64,{base64}";
            shouldRemoveAvatar = false; 
            StateHasChanged();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error previewing avatar: {ex.Message}");
            ShowToast("Failed to preview avatar. Please try again.", "error");
        }
    }

    private bool shouldRemoveAvatar = false;

    private void RemoveAvatar()
    {
        previewAvatarUrl = "REMOVED";
        shouldRemoveAvatar = true;
        StateHasChanged();
    }

    private async Task OnValidSubmitAsync()
    {
        if (user == null) return;

        // Check for profanity
        if (ProfanityFilter.ContainsProfanity(Input.DisplayName ?? ""))
        {
            modalMessage = "Display name contains inappropriate language. Please choose a different name.";
            modalIsSuccess = false;
            return;
        }

        if (ProfanityFilter.ContainsProfanity(Input.Bio ?? ""))
        {
            modalMessage = "Bio contains inappropriate language. Please revise your bio.";
            modalIsSuccess = false;
            return;
        }

        modalIsLoading = true;
        StateHasChanged();

        try
        {
            // Sanitize inputs
            var sanitizedDisplayName = InputSanitizer.SanitizeString(Input.DisplayName ?? "", 100);
            var sanitizedBio = InputSanitizer.SanitizeString(Input.Bio ?? "", 500);

            // Handle avatar changes
            string? newAvatarUrl = user.ProfilePictureUrl;

            if (shouldRemoveAvatar)
            {
                // Delete old avatar if exists
                if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                {
                    var oldFilePath = Path.Combine(Environment.WebRootPath, user.ProfilePictureUrl.TrimStart('/'));
                    if (File.Exists(oldFilePath))
                    {
                        File.Delete(oldFilePath);
                    }
                }
                newAvatarUrl = null;
            }
            else if (!string.IsNullOrEmpty(previewAvatarUrl) && previewAvatarUrl.StartsWith("data:"))
            {
                // Save the new avatar
                var uploadsPath = Path.Combine(Environment.WebRootPath, "uploads", "avatars");
                Directory.CreateDirectory(uploadsPath);

                var extension = ".jpg";
                var fileName = $"avatar_{user.Id}_{Guid.NewGuid()}{extension}";
                var filePath = Path.Combine(uploadsPath, fileName);

                // Convert base64 to file
                var base64Data = previewAvatarUrl.Split(',')[1];
                var bytes = Convert.FromBase64String(base64Data);
                await File.WriteAllBytesAsync(filePath, bytes);

                // Delete old avatar if exists
                if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                {
                    var oldFilePath = Path.Combine(Environment.WebRootPath, user.ProfilePictureUrl.TrimStart('/'));
                    if (File.Exists(oldFilePath))
                    {
                        File.Delete(oldFilePath);
                    }
                }

                newAvatarUrl = $"/uploads/avatars/{fileName}";
            }

            var success = await ProfileService.UpdateProfileAsync(
                user.Id,
                sanitizedDisplayName,
                sanitizedBio,
                Input.IsProfilePublic,
                Input.ShowListeningHistory,
                Input.ShowPlaylists,
                newAvatarUrl
            );

            if (success)
            {
                modalMessage = "Profile updated successfully!";
                modalIsSuccess = true;

                // Update local user object
                user.DisplayName = sanitizedDisplayName;
                user.Bio = sanitizedBio;
                user.IsProfilePublic = Input.IsProfilePublic;
                user.ShowPlaylists = Input.ShowPlaylists;
                user.ShowListeningHistory = Input.ShowListeningHistory;
                user.ProfilePictureUrl = newAvatarUrl;

                // Close modal after a short delay
                await Task.Delay(1500);
                CloseEditModal();
                await LoadProfile();
            }
            else
            {
                modalMessage = "Could not update profile. Please try again.";
                modalIsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            modalMessage = $"Error: {ex.Message}";
            modalIsSuccess = false;
        }
        finally
        {
            modalIsLoading = false;
            StateHasChanged();
        }
    }

    private async void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        StateHasChanged();

        await Task.Delay(3000);
        showToast = false;
        StateHasChanged();
    }

