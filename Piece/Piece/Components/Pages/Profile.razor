@page "/profile/{Username}"
@rendermode InteractiveServer
@using Piece.Data
@using Piece.Data.Models
@using Piece.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IProfileService ProfileService
@inject IListeningHistoryService ListeningHistoryService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(user?.DisplayName ?? user?.Email ?? "User Profile") - Piece</PageTitle>

<style>
    body {
        background-color: #1a1a1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .profile-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px;
        color: #fff;
    }

    .profile-header {
        display: flex;
        gap: 40px;
        margin-bottom: 40px;
        padding: 40px;
        background: rgba(139, 92, 246, 0.1);
        border-radius: 16px;
        border: 1px solid rgba(139, 92, 246, 0.3);
        align-items: flex-start;
    }

    .profile-left {
        display: flex;
        gap: 40px;
        flex: 1;
    }

    .profile-right {
        min-width: 280px;
        display: flex;
        flex-direction: column;
    }

    .profile-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: #8B5CF6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        font-weight: bold;
        color: #ffffff;
        flex-shrink: 0;
    }

    .profile-info {
        flex: 1;
    }

    .profile-name {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #ffffff;
    }

    .profile-username {
        font-size: 16px;
        color: #888;
        margin-bottom: 16px;
    }

    .profile-bio {
        font-size: 16px;
        line-height: 1.6;
        color: #aaa;
        max-width: 600px;
        margin-bottom: 24px;
    }

    .profile-stats {
        display: flex;
        gap: 40px;
        margin-bottom: 24px;
    }

    .stat-item {
        text-align: left;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #ffffff;
        display: block;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 13px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .profile-actions {
        display: flex;
        gap: 12px;
    }

    .btn-edit {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 12px 28px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-edit:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
        }


    .genres-section-header {
        padding: 0;
        background: none;
        border-radius: 0;
    }

    .genres-section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #fff;
    }

    .genres-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .genre-badge {
        padding: 10px 16px;
        border-radius: 16px;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
        text-align: center;
    }

        .genre-badge:hover {
            transform: scale(1.05);
        }

    .genre-count {
        opacity: 0.9;
        font-size: 12px;
        margin-top: 4px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 24px;
        color: #fff;
    }

    .playlists-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .playlist-card {
        background: #2a2a2a;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .playlist-card:hover {
            background: #3a3a3a;
            transform: translateY(-4px);
        }

    .playlist-cover {
        width: 100%;
        aspect-ratio: 1;
        background: #8B5CF6;
        border-radius: 8px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        overflow: hidden;
        position: relative;
    }

        .playlist-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
        }

        .playlist-cover .cover-icon {
            position: relative;
            z-index: 1;
        }

    .playlist-name {
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .playlist-tracks {
        font-size: 13px;
        color: #888;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #888;
    }

        .empty-state h3 {
            font-size: 24px;
            margin-bottom: 12px;
            color: #ffffff;
        }

    .private-message {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        margin-top: 40px;
    }

        .private-message h2 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #ffffff;
        }

        .private-message p {
            font-size: 16px;
            color: #aaa;
        }

    /* Loading State */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: #888;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #3a3a3a;
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@if (isLoading)
{
    <div class="profile-container">
        <div class="loading-container">
            <div class="spinner"></div>
            <p style="margin-top: 20px;">Loading profile...</p>
        </div>
    </div>
}
else if (user == null)
{
    <div class="profile-container">
        <div class="empty-state">
            <h3>User Not Found</h3>
            <p>This user doesn't exist or their profile is private.</p>
        </div>
    </div>
}
else if (!user.IsProfilePublic && !isOwnProfile)
{
    <div class="profile-container">
        <div class="private-message">
            <h2>Private Profile</h2>
            <p>This user's profile is set to private.</p>
        </div>
    </div>
}
else
{
    <div class="profile-container">
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-left">
                <div class="profile-avatar">
                    @GetInitials(user.DisplayName ?? user.Email ?? "U")
                </div>
                <div class="profile-info">
                    <h1 class="profile-name">@(user.DisplayName ?? "Piece User")</h1>
                    <div class="profile-username">@@@user.UserName</div>
                    @if (!string.IsNullOrEmpty(user.Bio))
                    {
                        <p class="profile-bio">@user.Bio</p>
                    }

                    <div class="profile-stats">
                        <div class="stat-item">
                            <span class="stat-value">@publicPlaylists.Count</span>
                            <span class="stat-label">Playlists</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">@totalTracks</span>
                            <span class="stat-label">Tracks</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">@topGenres.Count</span>
                            <span class="stat-label">Genres</span>
                        </div>
                    </div>

                    @if (isOwnProfile)
                    {
                        <div class="profile-actions">
                            <button class="btn-edit" @onclick="EditProfile">Edit Profile</button>
                        </div>
                    }
                </div>
            </div>

            <!-- Top Genres on the Right -->
            @if (user.ShowListeningHistory && topGenres.Any())
            {
                <div class="profile-right">
                    <div class="genres-section-header">
                        <h3 class="genres-section-title">Top Genres</h3>
                        <div class="genres-grid">
                            @foreach (var genre in topGenres.Take(4))
                            {
                                <div class="genre-badge" style="background: @genre.Value.Color;">
                                    <span>@genre.Key</span>
                                    <span class="genre-count">@genre.Value.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Public Playlists -->
        @if (user.ShowPlaylists && publicPlaylists.Any())
        {
            <div>
                <h2 class="section-title">Public Playlists</h2>
                <div class="playlists-grid">
                    @foreach (var playlist in publicPlaylists)
                    {
                        <div class="playlist-card" @onclick="() => ViewPlaylist(playlist.Id)">
                            <div class="playlist-cover">
                                @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                                {
                                    <img src="@playlist.CoverImageUrl" alt="@playlist.Name" />
                                }
                                else
                                {
                                    <span class="cover-icon">꩜</span>
                                }
                            </div>
                            <div class="playlist-name">@playlist.Name</div>
                            <div class="playlist-tracks">@playlist.PlaylistTracks.Count tracks</div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (user.ShowPlaylists)
        {
            <div class="empty-state">
                <h3>No public playlists yet</h3>
                <p>Create a playlist and make it public to share with others</p>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Username { get; set; } = "";

    private ApplicationUser? user;
    private List<Playlist> publicPlaylists = new();
    private Dictionary<string, (int Count, string Color)> topGenres = new();
    private int totalTracks = 0;
    private bool isLoading = true;
    private bool isOwnProfile = false;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;

        if (authUser.Identity?.IsAuthenticated == true)
        {
            currentUserId = authUser.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        try
        {
            user = await ProfileService.GetUserProfileByUsernameAsync(Username);

            if (user == null)
            {
                Console.WriteLine("[Profile] User not found");
                isLoading = false;
                return;
            }

            Console.WriteLine($"[Profile] User found: {user.Email}");
            Console.WriteLine($"[Profile] IsProfilePublic: {user.IsProfilePublic}");
            Console.WriteLine($"[Profile] ShowPlaylists: {user.ShowPlaylists}");

            isOwnProfile = currentUserId == user.Id;
            Console.WriteLine($"[Profile] IsOwnProfile: {isOwnProfile}");

            if (user.IsProfilePublic || isOwnProfile)
            {
                publicPlaylists = await ProfileService.GetUserPublicPlaylistsAsync(user.Id);
                Console.WriteLine($"[Profile] Public playlists loaded: {publicPlaylists.Count}");

                totalTracks = publicPlaylists.Sum(p => p.PlaylistTracks.Count);

                if (user.ShowListeningHistory || isOwnProfile)
                {
                    topGenres = await ListeningHistoryService.GetTopGenresAsync(user.Id, 30);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name[0].ToString().ToUpper();
    }

    private void EditProfile()
    {
        Navigation.NavigateTo("/Account/Manage/EditProfile");
    }

    private void ViewPlaylist(int playlistId)
    {
        Navigation.NavigateTo($"/playlist/{playlistId}");
    }
}