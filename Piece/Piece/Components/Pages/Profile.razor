@page "/profile/{Username}"
@rendermode InteractiveServer
@using Piece.Data
@using Piece.Data.Models
@using Piece.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject IProfileService ProfileService
@inject IListeningHistoryService ListeningHistoryService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IInputSanitizer InputSanitizer
@inject IProfanityFilter ProfanityFilter
@inject IWebHostEnvironment Environment
@inject IJSRuntime JSRuntime

<PageTitle>@(user?.DisplayName ?? user?.Email ?? "User Profile") - Piece</PageTitle>

<style>
    body {
        background-color: #1a1a1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .profile-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px;
        color: #fff;
    }

    .profile-header {
        display: flex;
        gap: 40px;
        margin-bottom: 40px;
        padding: 40px;
        background: rgba(139, 92, 246, 0.1);
        border-radius: 16px;
        border: 1px solid rgba(139, 92, 246, 0.3);
        align-items: flex-start;
    }

    .profile-left {
        display: flex;
        gap: 40px;
        flex: 1;
    }

    .profile-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: #8B5CF6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        font-weight: bold;
        color: #ffffff;
        flex-shrink: 0;
        overflow: hidden;
        position: relative;
    }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .profile-info {
        flex: 1;
    }

    .profile-name {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #ffffff;
    }

    .profile-username {
        font-size: 16px;
        color: #888;
        margin-bottom: 16px;
    }

    .profile-bio {
        font-size: 16px;
        line-height: 1.6;
        color: #aaa;
        max-width: 600px;
        margin-bottom: 24px;
    }

    .profile-stats {
        display: flex;
        gap: 40px;
        margin-bottom: 24px;
    }

    .stat-item {
        text-align: left;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #ffffff;
        display: block;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 13px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .profile-actions {
        display: flex;
        gap: 12px;
    }

    .btn-edit {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 12px 28px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-edit:hover {
            border-color: #10B981;
            color: #10B981;
            transform: scale(1.05);
        }

    .profile-right {
        min-width: 280px;
        display: flex;
        flex-direction: column;
    }

    .genres-section-header {
        padding: 0;
        background: none;
        border-radius: 0;
    }

    .genres-section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #fff;
    }

    .genres-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .genre-badge {
        padding: 10px 16px;
        border-radius: 16px;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
        text-align: center;
    }

        .genre-badge:hover {
            transform: scale(1.05);
        }

    .genre-count {
        opacity: 0.9;
        font-size: 12px;
        margin-top: 4px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 24px;
        color: #fff;
    }

    .playlists-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .playlist-card {
        background: #2a2a2a;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .playlist-card:hover {
            background: #3a3a3a;
            transform: translateY(-4px);
        }

    .playlist-cover {
        width: 100%;
        aspect-ratio: 1;
        background: #8B5CF6;
        border-radius: 8px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        overflow: hidden;
        position: relative;
    }

        .playlist-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
        }

        .playlist-cover .cover-icon {
            position: relative;
            z-index: 1;
        }

    .playlist-name {
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .playlist-tracks {
        font-size: 13px;
        color: #888;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #888;
    }

        .empty-state h3 {
            font-size: 24px;
            margin-bottom: 12px;
            color: #ffffff;
        }

    .private-message {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        margin-top: 40px;
    }

        .private-message h2 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #ffffff;
        }

        .private-message p {
            font-size: 16px;
            color: #aaa;
        }

    /* Loading State */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: #888;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #3a3a3a;
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Edit Profile Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

    .modal-large {
        background-color: #2a2a2a;
        border-radius: 16px;
        padding: 32px;
        max-width: 600px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .modal-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .btn-close {
        background: none;
        border: none;
        color: #888;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.3s;
    }

        .btn-close:hover {
            color: #ffffff;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 8px;
    }

    .form-input,
    .form-textarea {
        width: 100%;
        background-color: #1a1a1a;
        border: 2px solid #3a3a3a;
        border-radius: 8px;
        padding: 12px 16px;
        color: #ffffff;
        font-size: 14px;
        transition: border-color 0.3s ease;
    }

        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #8B5CF6;
        }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .char-counter {
        font-size: 12px;
        color: #888;
        text-align: right;
        margin-top: 4px;
    }

    .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background-color: #1a1a1a;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .checkbox-item:hover {
            background-color: #3a3a3a;
        }

        .checkbox-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #8B5CF6;
        }

    .checkbox-label {
        font-size: 14px;
        color: #ffffff;
        cursor: pointer;
        user-select: none;
        flex: 1;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .btn-secondary {
        background-color: #3a3a3a;
        color: #ffffff;
        border: none;
        padding: 12px 24px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #4a4a4a;
        }

    .btn-primary {
        background: #8B5CF6;
        color: #ffffff;
        border: none;
        padding: 12px 24px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: #7c3aed;
            transform: scale(1.05);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #10B981;
    }

    .alert-error {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
    }

    .alert-warning {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.3);
        color: #8B5CF6;
    }

    .avatar-upload {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .avatar-preview {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: #8B5CF6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: bold;
        color: #ffffff;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .avatar-preview:hover {
            transform: scale(1.05);
        }

        .avatar-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-upload-btn {
        background: none;
        border: 2px solid #3a3a3a;
        color: #ffffff;
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .avatar-upload-btn:hover {
            border-color: #8B5CF6;
            color: #8B5CF6;
        }

    .hidden-file-input {
        display: none;
    }

    /* Toast Notification */
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 16px 24px;
        border-radius: 12px;
        background-color: #2a2a2a;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        z-index: 10000;
        animation: slideIn 0.3s ease;
    }

    @@keyframes slideIn {
        from {
            transform: translateX(400px);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .toast.success {
        border-left: 4px solid #10B981;
    }

    .toast.error {
        border-left: 4px solid #ff4444;
    }

    .toast-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .toast-icon {
        font-size: 20px;
        font-weight: bold;
    }

    .toast.success .toast-icon {
        color: #10B981;
    }

    .toast.error .toast-icon {
        color: #ff4444;
    }

    .toast-message {
        color: #ffffff;
        font-size: 14px;
        font-weight: 500;
    }
</style>

@if (isLoading)
{
    <div class="profile-container">
        <div class="loading-container">
            <div class="spinner"></div>
            <p style="margin-top: 20px;">Loading profile...</p>
        </div>
    </div>
}
else if (user == null)
{
    <div class="profile-container">
        <div class="empty-state">
            <h3>User Not Found</h3>
            <p>This user doesn't exist or their profile is private.</p>
        </div>
    </div>
}
else if (!user.IsProfilePublic && !isOwnProfile)
{
    <div class="profile-container">
        <div class="private-message">
            <h2>Private Profile</h2>
            <p>This user's profile is set to private.</p>
        </div>
    </div>
}
else
{
    <div class="profile-container">
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-left">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                    {
                        <img src="@user.ProfilePictureUrl" alt="@user.DisplayName" />
                    }
                    else
                    {
                        <span>@GetInitials(user.DisplayName ?? user.Email ?? "U")</span>
                    }
                </div>
                <div class="profile-info">
                    <h1 class="profile-name">@(user.DisplayName ?? "Piece User")</h1>
                    <div class="profile-username">@@@user.UserName</div>
                    @if (!string.IsNullOrEmpty(user.Bio))
                    {
                        <p class="profile-bio">@user.Bio</p>
                    }

                    <div class="profile-stats">
                        <div class="stat-item">
                            <span class="stat-value">@publicPlaylists.Count</span>
                            <span class="stat-label">Playlists</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">@totalTracks</span>
                            <span class="stat-label">Tracks</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">@topGenres.Count</span>
                            <span class="stat-label">Genres</span>
                        </div>
                    </div>

                    @if (isOwnProfile)
                    {
                        <div class="profile-actions">
                            <button class="btn-edit" @onclick="OpenEditModal">Edit Profile</button>
                        </div>
                    }
                </div>
            </div>

            <!-- Top Genres on the Right -->
            @if (user.ShowListeningHistory && topGenres.Any())
            {
                <div class="profile-right">
                    <div class="genres-section-header">
                        <h3 class="genres-section-title">Top Genres</h3>
                        <div class="genres-grid">
                            @foreach (var genre in topGenres.Take(5))
                            {
                                <div class="genre-badge" style="background: @genre.Value.Color;">
                                    <span>@genre.Key</span>
                                    <span class="genre-count">@genre.Value.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Public Playlists -->
        @if (user.ShowPlaylists && publicPlaylists.Any())
        {
            <div>
                <h2 class="section-title">Public Playlists</h2>
                <div class="playlists-grid">
                    @foreach (var playlist in publicPlaylists)
                    {
                        <div class="playlist-card" @onclick="() => ViewPlaylist(playlist.Id)">
                            <div class="playlist-cover">
                                @if (!string.IsNullOrEmpty(playlist.CoverImageUrl))
                                {
                                    <img src="@playlist.CoverImageUrl" alt="@playlist.Name" />
                                }
                                else
                                {
                                    <span class="cover-icon">꩜</span>
                                }
                            </div>
                            <div class="playlist-name">@playlist.Name</div>
                            <div class="playlist-tracks">@playlist.PlaylistTracks.Count tracks</div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (user.ShowPlaylists)
        {
            <div class="empty-state">
                <h3>No public playlists yet</h3>
                <p>Create a playlist and make it public to share with others</p>
            </div>
        }
    </div>
}

<!-- Edit Profile Modal -->
@if (showEditModal)
{
    <div class="modal-overlay" @onclick="CloseEditModal">
        <div class="modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Edit Profile</h2>
                <button class="btn-close" @onclick="CloseEditModal">×</button>
            </div>

            @if (!string.IsNullOrEmpty(modalMessage))
            {
                <div class="alert @(modalIsSuccess ? "alert-success" : "alert-error")">
                    @modalMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(warningMessage))
            {
                <div class="alert alert-warning">
                    @warningMessage
                </div>
            }

            <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator />

                <!-- Avatar Upload -->
                <div class="avatar-upload">
                    <div class="avatar-preview" @onclick="OpenAvatarUpload">
                        @if (!string.IsNullOrEmpty(previewAvatarUrl) && previewAvatarUrl != "REMOVED")
                        {
                            <img src="@previewAvatarUrl" alt="Avatar" />
                        }
                        else if (previewAvatarUrl == "REMOVED")
                        {
                            <span>@GetInitials(Input.DisplayName ?? user?.Email ?? "U")</span>
                        }
                        else if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
                        {
                            <img src="@user.ProfilePictureUrl" alt="Avatar" />
                        }
                        else
                        {
                            <span>@GetInitials(Input.DisplayName ?? user?.Email ?? "U")</span>
                        }
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="avatar-upload-btn" @onclick="OpenAvatarUpload">
                            Change Avatar
                        </button>
                        @if ((previewAvatarUrl != null && previewAvatarUrl != "REMOVED") || (!string.IsNullOrEmpty(user?.ProfilePictureUrl) && previewAvatarUrl != "REMOVED"))
                        {
                            <button type="button" class="avatar-upload-btn" style="border-color: #ff4444; color: #ff4444;" @onclick="RemoveAvatar">
                                Remove Avatar
                            </button>
                        }
                    </div>
                </div>

                <!-- Display Name -->
                <div class="form-group">
                    <label class="form-label">Display Name</label>
                    <InputText @bind-Value="Input.DisplayName" class="form-input" placeholder="How you want to be called" />
                    <ValidationMessage For="() => Input.DisplayName" class="text-danger" />
                </div>

                <!-- Bio -->
                <div class="form-group">
                    <label class="form-label">Bio</label>
                    <InputTextArea @bind-Value="Input.Bio" class="form-input form-textarea"
                                   placeholder="Tell us about your music taste..."
                                   @oninput="UpdateBioCharCount" />
                    <div class="char-counter">@bioCharCount / 500 characters</div>
                    <ValidationMessage For="() => Input.Bio" class="text-danger" />
                </div>

                <!-- Privacy Settings -->
                <div class="form-group">
                    <label class="form-label">Privacy Settings</label>
                    <div class="checkbox-group">
                        <label class="checkbox-item">
                            <InputCheckbox @bind-Value="Input.IsProfilePublic" />
                            <span class="checkbox-label">Public Profile - Anyone can view your profile</span>
                        </label>
                        <label class="checkbox-item">
                            <InputCheckbox @bind-Value="Input.ShowPlaylists" />
                            <span class="checkbox-label">Show Public Playlists - Display your playlists on your profile</span>
                        </label>
                        <label class="checkbox-item">
                            <InputCheckbox @bind-Value="Input.ShowListeningHistory" />
                            <span class="checkbox-label">Show Listening Colors - Display your top genres and listening stats</span>
                        </label>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button type="submit" class="btn-primary" disabled="@modalIsLoading">
                        @(modalIsLoading ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Toast Notification -->
@if (showToast)
{
    <div class="toast @toastType">
        <div class="toast-content">
            <span class="toast-icon">@(toastType == "success" ? "✓" : "⚠")</span>
            <span class="toast-message">@toastMessage</span>
        </div>
    </div>
}

<!-- Hidden file input for avatar upload -->
<InputFile OnChange="HandleAvatarUpload" class="hidden-file-input" accept="image/*" @ref="avatarInput" />

@code {
    [Parameter] public string Username { get; set; } = "";

    private ApplicationUser? user;
    private List<Playlist> publicPlaylists = new();
    private Dictionary<string, (int Count, string Color)> topGenres = new();
    private int totalTracks = 0;
    private bool isLoading = true;
    private bool isOwnProfile = false;
    private string? currentUserId;

    // Edit modal
    private bool showEditModal = false;
    private bool modalIsLoading = false;
    private string? modalMessage;
    private bool modalIsSuccess;
    private string? warningMessage = "Input is sanitized automatically. Inappropriate language may result in account suspension.";
    private int bioCharCount = 0;
    private InputModel Input { get; set; } = new();

    // Avatar upload
    private InputFile? avatarInput;
    private string? previewAvatarUrl;

    // Toast
    private string? toastMessage;
    private string toastType = "error";
    private bool showToast = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;

        if (authUser.Identity?.IsAuthenticated == true)
        {
            currentUserId = authUser.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        try
        {
            user = await ProfileService.GetUserProfileByUsernameAsync(Username);

            if (user == null)
            {
                Console.WriteLine("[Profile] User not found");
                isLoading = false;
                return;
            }

            isOwnProfile = currentUserId == user.Id;

            if (user.IsProfilePublic || isOwnProfile)
            {
                publicPlaylists = await ProfileService.GetUserPublicPlaylistsAsync(user.Id);
                totalTracks = publicPlaylists.Sum(p => p.PlaylistTracks.Count);

                if (user.ShowListeningHistory || isOwnProfile)
                {
                    topGenres = await ListeningHistoryService.GetTopGenresAsync(user.Id, 30);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name[0].ToString().ToUpper();
    }

    private void OpenEditModal()
    {
        if (user == null) return;

        Input.DisplayName = user.DisplayName ?? "";
        Input.Bio = user.Bio ?? "";
        Input.IsProfilePublic = user.IsProfilePublic;
        Input.ShowPlaylists = user.ShowPlaylists;
