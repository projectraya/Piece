@using Piece.DTOs
@using Piece.Services
@using Piece.Data
@using Piece.Data.Models
@using Microsoft.EntityFrameworkCore
@inject PlayerService PlayerService
@inject IPlaylistService PlaylistService
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<div class="track-menu-container" @onclick:stopPropagation="true">
    <button class="track-menu-btn" @onclick="ToggleMenu">⋮</button>

    @if (isMenuOpen)
    {
        <div class="track-menu-dropdown">
            <div class="menu-item" @onclick="AddToQueue">
                <span class="menu-icon">+</span>
                <span>Queue</span>
            </div>

            <div class="menu-item playlist-trigger">
                <span class="menu-icon">☰</span>
                <span>Playlist</span>
                <span class="arrow">›</span>

                <div class="playlist-submenu">
                    <div class="submenu-scroll">
                        @if (userPlaylists.Any())
                        {
                            @foreach (var playlist in userPlaylists)
                            {
                                <div class="menu-item" @onclick="() => AddToPlaylist(playlist.Id)">
                                    <span class="menu-icon">♪</span>
                                    <span title="@playlist.Name">@playlist.Name</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="menu-item disabled">
                                <span>No playlists</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="menu-backdrop" @onclick="CloseMenu"></div>
    }
</div>

<style>
    .track-menu-btn {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        color: white;
        font-size: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.2s;
    }

    .track-card:hover .track-menu-btn {
        opacity: 1;
    }

    .track-menu-btn:hover {
        background: rgba(139, 92, 246, 0.9);
        transform: scale(1.1);
    }

    .track-menu-dropdown {
        position: absolute;
        top: 36px;
        right: 0;
        background: #1e1e1e;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        width: 160px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
        animation: fadeIn 0.15s ease;
        z-index: 1000;
        overflow: visible;
        padding: 4px 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .menu-item {
        padding: 10px 14px;
        color: #e0e0e0;
        font-size: 13px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s;
        border-radius: 6px;
        margin: 0 4px;
        position: relative;
        user-select: none;
    }

        .menu-item:hover:not(.disabled) {
            background: rgba(139, 92, 246, 0.15);
            color: #fff;
        }

        .menu-item.disabled {
            opacity: 0.4;
            cursor: default;
        }

    .menu-icon {
        font-size: 14px;
        flex-shrink: 0;
        width: 16px;
        text-align: center;
    }

    .menu-item > span:not(.menu-icon):not(.arrow) {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .arrow {
        margin-left: auto;
        color: #888;
        font-size: 16px;
    }

   
    .submenu-scroll {
        max-height: 240px;
        overflow-y: auto;
    }

        .submenu-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .submenu-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .submenu-scroll::-webkit-scrollbar-thumb {
            background: rgba(139,92,246,0.4);
            border-radius: 2px;
        }

    

    .track-menu-container {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 1000;
    }

    .playlist-trigger {
        position: relative;
        z-index: 1002;
    }

        .playlist-trigger::after {
            content: '';
            position: absolute;
            top: 0;
            left: 100%;
            width: 12px; 
            height: 100%;
        }

    .playlist-submenu {
        position: absolute;
        top: -4px;
        left: calc(100% + 4px);
        background: #1e1e1e;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        width: 200px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
        z-index: 1003; 
        padding: 4px 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
    }

    .playlist-trigger:hover .playlist-submenu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .menu-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 998; /* под подменюто */
        background: transparent;
    }
</style>

@code {
    [Parameter] public PlayableTrack Track { get; set; } = null!;
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public EventCallback OnMenuAction { get; set; }

    private bool isMenuOpen = false;
    private bool showPlaylistSubmenu = false;
    private List<Playlist> userPlaylists = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(CurrentUserId))
            await LoadUserPlaylists();
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
        showPlaylistSubmenu = false;
        StateHasChanged();
    }

    private async Task LoadUserPlaylists()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            userPlaylists = await context.Playlists
                .Where(p => p.UserId == CurrentUserId)
                .OrderBy(p => p.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TrackContextMenu] Error: {ex.Message}");
        }
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
        showPlaylistSubmenu = false;
        StateHasChanged();
    }

    private void AddToQueue()
    {
        PlayerService.AddToQueue(Track);
        isMenuOpen = false;
        _ = OnMenuAction.InvokeAsync();
        StateHasChanged();
    }

    private async Task AddToPlaylist(int playlistId)
    {
        try
        {
            if (Track.LocalTrackId.HasValue)
                await PlaylistService.AddTrackToPlaylistAsync(playlistId, Track.LocalTrackId.Value, CurrentUserId!);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TrackContextMenu] Error: {ex.Message}");
        }
        finally
        {
            isMenuOpen = false;
            showPlaylistSubmenu = false;
            await OnMenuAction.InvokeAsync();
            StateHasChanged();
        }
    }
}